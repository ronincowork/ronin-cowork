node_modules/
dist/
# bin/ronin-build's output — tarballs are published to GitHub Releases, never committed.
release/
# The paid layer, INSTALLED here but never cowork's code: the assembler discovers
# src/services/ at boot (docs/connector-contract.md). This repo flips public; the
# ignore is what makes "services can never enter cowork's history" structural.
src/services/
.env
*.log
.DS_Store
public-staging/

# Syncthing's own bookkeeping, on any box that syncs this tree. Not the project's
# files and not the owner's — the folder marker, the per-folder ignore list, and the
# transient files a transfer leaves behind mid-flight. They turned up as untracked
# noise on every `git status`, which is how a real stray file gets missed.
.stfolder/
.stignore
.stversions/
~syncthing~*.tmp
