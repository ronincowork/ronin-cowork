#!/usr/bin/env bash
set -u

SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
REAL_DIR=$(cd "$(dirname "$SELF")" && pwd)
if [ -x "$REAL_DIR/../../vendor/tmux" ]; then
  REAL="$REAL_DIR/../../vendor/tmux"
else
  REAL=/usr/bin/tmux
fi

for arg in "$@"; do
  if [ "$arg" = kill-server ]; then
    echo "ronin: tmux kill-server is unavailable because it ends every session." >&2
    exit 4
  fi
done

exec "$REAL" "$@"
