#!/usr/bin/env bash
# git shim — in a SHARED checkout, record what THIS session staged so the pre-commit guard
# has something to judge against. Vendor-neutral, like bin/shim/tmux beside it: any agent,
# any CLI, a human typing at a pane — if bin/shim is on the PATH, the claim gets recorded.
#
# WHERE IT APPLIES. The claim exists for one hazard only: several sessions staging into
# ONE git index — the repository's home checkout, shared by every shell on the box. A
# managed repo desk (WORKTREES.md) is a linked worktree with an index of its own, so there
# the hazard does not exist and this shim is a plain pass-through. Which of the two you
# are standing in is measured, not remembered: libexec/ronin-repo-mode answers, and the
# hooks ask it the same question. Shared checkouts are the transition arrangement and the
# declared-direct arrangement (RONIN_REPO), not the target for reviewed work.
#
# IT CHANGES NO HABITS. `git add x` and `git commit -m '...'` keep working exactly as they
# always have. The only thing that happens differently, in a shared checkout, is that an
# `add` also writes down what it staged, and the pre-commit hook uses that to refuse a
# commit carrying files this session never touched. Everything else is passed straight
# through, untouched.
#
# Speed bump, not physics: /usr/bin/git still exists. Going around this is a deliberate,
# visible act rather than an accident — the same posture as the tmux shim.
# Overrides: RONIN_CLAIM_MODE=shared|off (RONIN_CLAIM_OFF=1 still means off).
set -u
SELF_DIR=$(cd "$(dirname "$0")" && pwd)
# THE REAL GIT, RESOLVED ONCE, PAST EVERY RONIN SHIM — not just this one. A promotion
# candidate is a second checkout with its own bin/shim; with both on PATH, a shim that
# strips only itself hands ronin-claim a `git` that is the OTHER shim, which strips itself
# and reveals the first again: two shims calling each other, never returning (found in
# the first real candidate, 2026-08-28). So every */bin/shim directory is removed, and
# the answer travels to ronin-claim as RONIN_REAL_GIT so nothing below re-resolves.
CLEAN_PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '/bin/shim$' | grep -vxF "$SELF_DIR" | paste -sd:)
REAL=${RONIN_REAL_GIT:-}
[ -n "$REAL" ] && [ -x "$REAL" ] || REAL=$(PATH="$CLEAN_PATH" command -v git)
[ -n "${REAL:-}" ] || REAL=/usr/bin/git
export RONIN_REAL_GIT="$REAL"

# Only `add` is intercepted, and only to record. Note the subcommand is the first argument
# that is not a global option, so `git -C dir add …` is still an add.
sub=""
for a in "$@"; do
  case "$a" in
    -C|-c|--git-dir|--work-tree|--namespace|--exec-path) skip=1 ;;
    -*) : ;;
    *) if [ "${skip:-0}" = 1 ]; then skip=0; else sub="$a"; break; fi ;;
  esac
done

if [ "$sub" = "add" ]; then
  CLAIM="$SELF_DIR/../../libexec/ronin-claim"
  MODE="$SELF_DIR/../../libexec/ronin-repo-mode"
  # The mode is asked of the tree the add targets: `git -C dir add …` resolves in dir.
  cdir=""; prev=""
  for a in "$@"; do [ "$prev" = "-C" ] && cdir="$a"; prev="$a"; done
  claim=off
  if [ -x "$CLAIM" ] && [ -x "$MODE" ]; then
    claim=$(cd "${cdir:-.}" 2>/dev/null && "$MODE" claim 2>/dev/null || echo off)
  fi
  if [ "$claim" = on ]; then
    # ronin-claim runs the real add itself (it snapshots the index either side of it), so
    # this branch does not fall through. Its exit code is git's. The GLOBAL options before
    # `add` (-C dir, -c k=v, --git-dir …) travel with it, before a `--` separator: dropping
    # them once made `git -C /tmp/x add .` stage the CALLER's cwd — the shared checkout —
    # and broke every test fixture that reaches its repo by -C.
    globals=(); args=()
    seen=0
    for a in "$@"; do
      if [ "$seen" = 0 ]; then
        if [ "$a" = "add" ]; then seen=1; else globals+=("$a"); fi
      else args+=("$a"); fi
    done
    PATH="$CLEAN_PATH" "$CLAIM" add ${globals[@]+"${globals[@]}"} -- ${args[@]+"${args[@]}"}
    exit $?
  fi
fi

exec "$REAL" "$@"
