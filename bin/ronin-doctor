#!/usr/bin/env bash
# RONIN DOCTOR — what is actually running, vs what is written.
#
#   bin/ronin-doctor          # readout; exit 0 = nothing outstanding, 1 = findings
#
# The install is invisible: `setup.sh` copies three things OUT of the repo (the unit
# files, the statusLine registration, node_modules) and nothing tells you a copy has
# drifted. The operator is a memory copy taken at start, so `src/` edits are not live
# until a restart. That condition — what is running is not what is written — went
# unseen for months at a time (the render-gate hook sat only in deploy/ while every
# installed start ran without it). Doctor asks the install and the operator directly
# instead of inferring from the tree. Chain and remedies: docs/repo-to-operator.md.
#
# Doctor REPORTS, it never repairs: no restart, no daemon-reload, no file written.
# Half its remedies touch the live service, and those are the owner's hand — a
# reporter that "helpfully" restarts things is how every session on a box dies.
# The one nuance: the git-credentials probe dials the remote (a --dry-run push,
# prompts off). Nothing is sent; it is still the one check that needs the network.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
OS="$(uname -s)"
. "$ROOT/libexec/ronin-temp-hygiene.sh"

# The operator unit is ronin.service; a box that has not re-run setup.sh since the
# 2026-08-19 rename still runs it as tmux-ronin.service. Diagnose whichever is there.
RONIN_UNIT="ronin"
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user cat ronin.service >/dev/null 2>&1 || RONIN_UNIT="tmux-ronin"
fi

FINDINGS=0
sect() { echo "→ $1"; }
ok()   { echo "  ok   — $1"; }
note() { echo "  note — $1"; }
find_() { echo "  FIND — $1"; FINDINGS=$((FINDINGS + 1)); }

# Literal find/replace, exactly as setup.sh renders the unit templates (see
# subst_literal there for why not sed and not ${var//…}). Doctor must render the
# same bytes the installer would, or the comparison lies.
subst_literal() {
  local text="$1" needle="$2" value="$3" out=""
  while [ -n "$text" ]; do
    case "$text" in
      *"$needle"*)
        out="$out${text%%"$needle"*}$value"
        text="${text#*"$needle"}"
        ;;
      *) out="$out$text"; text="" ;;
    esac
  done
  printf '%s' "$out"
}

# THE FIRST PATH HIT THAT IS NOT OUR OWN GUARD SHIM. `bin/shim/` precedes /usr/bin in a
# configured login shell, so a bare `command -v tmux` there answers with the guard rather
# than the tmux setup.sh baked into the unit — and doctor would report drift on a box that
# has none. Resolving past the shim is what makes this comparison stable in the shell an
# agent actually runs in.
resolve_tool() {  # resolve_tool <name> — a real path on stdout, empty if absent
  local p
  for p in $(type -aP "$1" 2>/dev/null); do
    case "$p" in "$ROOT"/bin/shim/*) continue ;; esac
    printf '%s' "$p"; return 0
  done
  return 0
}

# THE FOUR PLACEHOLDERS setup.sh FILLS, resolved the way setup.sh resolves them: a
# bundled release carries its own node and tmux under vendor/, a checkout uses the
# system's. Doctor rendered only two of the four, so `__TMUX_BIN__` and `__TMUX_DIR__`
# survived into the comparison text and could never equal an installed unit — every
# healthy box was told both its units had drifted, on every run. A check that always
# fails is worse than no check: it teaches the reader to skip the section.
if [ -x "$ROOT/vendor/node/bin/node" ] && [ -x "$ROOT/vendor/tmux" ]; then
  NODE_BIN="$ROOT/vendor/node/bin/node"
  NODE_DIR="$ROOT/vendor/node/bin"
  TMUX_BIN="$ROOT/vendor/tmux"
  TMUX_DIR="$ROOT/vendor/bin"
else
  NODE_BIN="$(readlink -f "$(command -v node)" 2>/dev/null || command -v node || true)"
  NODE_DIR="${NODE_BIN:+$(dirname "$NODE_BIN")}"
  TMUX_BIN="$(resolve_tool tmux)"
  TMUX_DIR="${TMUX_BIN:+$(dirname "$TMUX_BIN")}"
fi

render_template() {  # render_template <template> — rendered text on stdout
  local text
  text="$(<"$1")"
  text="$(subst_literal "$text" '__REPO_DIR__' "$ROOT")"
  text="$(subst_literal "$text" '__NODE_DIR__' "$NODE_DIR")"
  text="$(subst_literal "$text" '__TMUX_BIN__' "$TMUX_BIN")"
  text="$(subst_literal "$text" '__TMUX_DIR__' "$TMUX_DIR")"
  printf '%s\n' "$text"
}

# A value from .env, uncommented lines only — the same file the unit points the
# server at. Never source it: it holds secrets that must not enter the environment.
env_get() { sed -n "s/^[[:space:]]*$1=//p" "$ROOT/.env" 2>/dev/null | tail -1; }

echo ""
echo "RONIN DOCTOR — $ROOT"
echo ""

sect "temporary-storage headroom"
if ronin_tmp_preflight 2>&1; then
  ok "temporary storage has safe inode and byte headroom"
else
  find_ "temporary storage is too full for a reliable gate run — follow the teaching above"
fi

# ---- 1. the copied-out unit files -------------------------------------------------
# setup.sh renders deploy/*.service into ~/.config/systemd/user/ (launchd plist on
# macOS) and the copy stops tracking the repo the moment it lands.
sect "installed units vs deploy/"
if [ "$OS" = "Linux" ] && command -v systemctl >/dev/null 2>&1; then
  UNIT_DIR="$HOME/.config/systemd/user"
  if [ -f "$UNIT_DIR/tmux-ronin.service" ]; then
    find_ "the operator still runs under its retired name tmux-ronin.service — run ./setup.sh to migrate it to ronin.service"
  fi
  for unit in tmux-server.service ronin.service; do
    tpl="$ROOT/deploy/$unit"
    inst="$UNIT_DIR/$unit"
    if [ ! -f "$tpl" ]; then
      find_ "deploy/$unit is missing from the repo — the unit has no source of truth"
    elif [ ! -f "$inst" ]; then
      find_ "$unit was never installed — run ./setup.sh"
    elif ! diff -q <(render_template "$tpl") "$inst" >/dev/null 2>&1; then
      find_ "installed $unit is not the one in deploy/ — run ./setup.sh, then systemctl --user daemon-reload"
    else
      ok "$unit matches deploy/"
    fi
    # The file can match while systemd still holds an older parse in memory.
    if [ -f "$inst" ]; then
      stale="$(systemctl --user show "$unit" -p NeedDaemonReload --value 2>/dev/null)"
      [ "$stale" = "yes" ] &&
        find_ "$unit changed on disk since systemd read it — run systemctl --user daemon-reload"
    fi
  done
elif [ "$OS" = "Darwin" ]; then
  tpl="$ROOT/deploy/com.ronin.plist"
  inst="$HOME/Library/LaunchAgents/com.ronin.plist"
  if [ -f "$HOME/Library/LaunchAgents/com.tmux-ronin.plist" ]; then
    find_ "the retired launchd agent com.tmux-ronin.plist is still installed — run ./setup.sh and unload the old one"
  fi
  if [ ! -f "$inst" ]; then
    find_ "com.ronin.plist was never installed — run ./setup.sh, then launchctl load -w $inst"
  elif ! diff -q <(render_template "$tpl") "$inst" >/dev/null 2>&1; then
    find_ "installed com.ronin.plist is not the one in deploy/ — run ./setup.sh, then launchctl unload/load -w $inst"
  else
    ok "com.ronin.plist matches deploy/"
  fi
else
  note "no systemd or launchd here — nothing installed to compare"
fi

# ---- 2. the statusLine registration ----------------------------------------------
# The ⛽ context gauge only works if Claude Code's own settings name our script.
sect "statusLine registration (~/.claude/settings.json)"
sl_state="$(node -e '
  const fs = require("fs"), path = require("path");
  const [settings, script, local] = process.argv.slice(1);
  const real = (p) => { try { return fs.realpathSync(p.replace(/^~\//, process.env.HOME + "/")); } catch { return p; } };
  const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
  const cmdOf = (d) => {
    const s = d && d.statusLine;
    return typeof s === "string" ? s : (s && typeof s.command === "string" ? s.command : null);
  };
  const localCmd = cmdOf(read(local));
  if (localCmd !== null) { console.log(real(localCmd.trim()) === real(script) ? "MINE" : "LOCAL"); process.exit(0); }
  const d = read(settings);
  if (d === null) { console.log(fs.existsSync(settings) ? "INVALID" : "NONE"); process.exit(0); }
  const cmd = cmdOf(d);
  if (cmd === null) { console.log("NONE"); process.exit(0); }
  if (real(cmd.trim()) === real(script)) { console.log("MINE"); process.exit(0); }
  const target = cmd.trim().split(/\s/)[0].replace(/^~\//, process.env.HOME + "/");
  console.log(fs.existsSync(target) ? "OTHER" : "GONE");
' "$HOME/.claude/settings.json" "$ROOT/hostside/statusline-ronin.sh" "$HOME/.claude/settings.local.json" 2>/dev/null)"
case "$sl_state" in
  MINE)    ok "registered → hostside/statusline-ronin.sh" ;;
  NONE)    find_ "no statusLine registered — the ⛽ gauge is dark; run ./setup.sh (it merges the key, never clobbers)" ;;
  GONE)    find_ "the registered statusLine points at a script that no longer exists — the ⛽ gauge is dark; run ./setup.sh to re-register" ;;
  OTHER)   note "settings.json sets a statusLine that is not ours — deliberately left alone (setup.sh does the same); the ⛽ gauge stays dark unless it points at hostside/statusline-ronin.sh" ;;
  LOCAL)   note "settings.local.json overrides statusLine with something that is not ours — the ⛽ gauge stays dark" ;;
  INVALID) find_ "~/.claude/settings.json is not valid JSON — nothing registered until that is fixed by hand" ;;
  *)       find_ "could not read the statusLine registration (node failed)" ;;
esac

# ---- 3. node_modules vs package.json ---------------------------------------------
sect "node_modules vs package.json"
if [ ! -d "$ROOT/node_modules" ]; then
  find_ "node_modules/ does not exist — run npm install (then a restart is the owner's hand)"
elif [ -n "$NODE_DIR" ] && "$NODE_DIR/npm" ls --omit=dev --depth=0 >/dev/null 2>&1; then
  ok "installed dependencies satisfy package.json"
else
  find_ "installed dependencies do not satisfy package.json — run npm install, then a restart (owner's hand)"
fi

# ---- 4. the operator: alive, and serving -----------------------------------------
# The bind ladder is the server's own (src/config.ts) and ronin-gate's: BIND from the
# environment, else .env, else the tailnet IP, else loopback. Never a hardcoded host.
sect "operator"
PORT="${PORT:-$(env_get PORT)}"; PORT="${PORT:-3006}"
HOSTIP="${BIND:-$(env_get BIND)}"
if [ -z "$HOSTIP" ] && command -v tailscale >/dev/null 2>&1; then
  HOSTIP="$(tailscale ip -4 2>/dev/null | head -1)"
fi
HOSTIP="${HOSTIP:-127.0.0.1}"
URL="http://${HOSTIP}:${PORT}/"
if command -v systemctl >/dev/null 2>&1; then
  state="$(systemctl --user show "$RONIN_UNIT" -p ActiveState --value 2>/dev/null)"
  [ "$state" = "active" ] || find_ "the $RONIN_UNIT unit is $state — starting it is the owner's hand (systemctl --user start $RONIN_UNIT)"
fi
HEALTH_UP=0
if curl -fsS -m 4 -o /dev/null "${URL}api/health" 2>/dev/null; then
  ok "serving at $URL"; HEALTH_UP=1
else
  find_ "nothing answers ${URL}api/health — the grid is down; journalctl --user -u $RONIN_UNIT -n 50, restart is the owner's hand"
fi

# ---- 4b. the perimeter: is the front door shut? -----------------------------------
# Two facts about THIS BOX, which is why they live here and not in a repo gate: a
# checked-in file cannot know a machine's file modes or what it ended up bound to.
# The pair of them are the states that made the door dangerous (buildouts/FRONTDOOR.md),
# so each one now trips a check instead of waiting to be noticed.
sect "perimeter"

# The mode only — never the contents. env_get above reads individual non-secret values
# by name for the same reason: doctor must be safe to run and safe to paste.
if [ -f "$ROOT/.env" ]; then
  if [ "$OS" = "Darwin" ]; then
    ENV_MODE="$(stat -f '%Lp' "$ROOT/.env" 2>/dev/null)"
  else
    ENV_MODE="$(stat -c '%a' "$ROOT/.env" 2>/dev/null)"
  fi
  # Anything readable by group or other. The file holds GRID_PASS and provider keys on
  # a box whose premise is many concurrent agent sessions under one Unix user.
  if [ -n "$ENV_MODE" ] && [ "$(( 8#$ENV_MODE & 8#077 ))" -ne 0 ]; then
    find_ ".env is mode $ENV_MODE — readable beyond its owner, and it holds GRID_PASS and provider keys; chmod 600 .env"
  else
    ok ".env is owner-only (mode ${ENV_MODE:-?})"
  fi
fi

# The same condition src/config.ts refuses at startup, asked of the RUNNING box — so a
# hand-edited .env is caught before the next restart rather than by it.
D_USER="${GRID_USER:-$(env_get GRID_USER)}"
D_PASS="${GRID_PASS:-$(env_get GRID_PASS)}"
if [ -n "$D_USER" ] && [ -n "$D_PASS" ]; then
  ok "HTTP auth is ON"
else
  TSIP="$(command -v tailscale >/dev/null 2>&1 && tailscale ip -4 2>/dev/null | head -1)"
  case "$HOSTIP" in
    127.*|::1|localhost) ok "auth is off, but the bind is loopback-only ($HOSTIP)" ;;
    *)
      if [ -n "$TSIP" ] && [ "$HOSTIP" = "$TSIP" ]; then
        ok "auth is off, but the bind is this machine's tailnet address ($HOSTIP)"
      else
        find_ "auth is OFF and the bind is $HOSTIP — neither loopback nor this machine's tailnet address, which serves live shells to anything that can reach the port; set GRID_USER + GRID_PASS in .env, or bind 127.0.0.1 or the tailnet IP"
      fi
      ;;
  esac
fi

# ---- 5. src/ staleness ------------------------------------------------------------
# The operator is a memory copy taken at start; src/ and package.json edits are not
# real until a restart (docs/repo-to-operator.md). ASK the operator what it is running
# (/api/version — the commit its process started from) and compare strings. The
# timestamp inference below survives only as the fallback for an operator that
# predates the stamp; the stamp is the better answer whenever it exists.
sect "operator vs src/"
ver="$([ "$HEALTH_UP" = 1 ] && curl -fsS -m 4 "${URL}api/version" 2>/dev/null || true)"
op_commit="$(printf '%s' "$ver" | sed -n 's/.*"commit":"\([^"]*\)".*/\1/p')"
op_release="$(printf '%s' "$ver" | sed -n 's/.*"release":"\([^"]*\)".*/\1/p')"
# A RELEASE INSTALL compares release strings — the whole point of the artifact
# (docs/release.md). The operator answers the release it started from; this tree's
# VERSION file says what is unpacked here. Equal = current. Different = an update was
# unpacked or swapped since the operator started, and a restart carries it.
if [ -n "$op_release" ]; then
  tree_release="$(sed -n 's/^release=//p' "$ROOT/VERSION" 2>/dev/null)"
  if [ -z "$tree_release" ]; then
    note "operator runs release $op_release; this tree carries no VERSION file — asked from a checkout, nothing to compare"
  elif [ "$op_release" = "$tree_release" ]; then
    ok "operator runs $op_release — this install's own release (a string match, not an inference)"
  else
    find_ "operator runs $op_release but this install is $tree_release — old code until a restart (owner's hand, or bin/ronin-update finishing)"
  fi
elif [ -n "$op_commit" ] && [ "$op_commit" != "unknown" ]; then
  tree_commit="$(git rev-parse --short HEAD 2>/dev/null)"
  if [ -z "$tree_commit" ]; then
    note "operator says it runs $op_commit; the tree has no git to compare against"
  elif [ "$op_commit" = "$tree_commit" ]; then
    ok "operator runs $op_commit — the tree's HEAD (asked, not inferred)"
  elif ! git cat-file -e "$op_commit" 2>/dev/null; then
    note "operator runs $op_commit — a commit this tree does not have; cannot compare"
  elif git diff --quiet "$op_commit" HEAD -- src/ package.json 2>/dev/null; then
    # The tree moved, but not in anything the operator bakes in — a docs or bin/
    # commit is not staleness, and a FIND here would teach people to ignore FINDs.
    ok "operator runs $op_commit; the tree is at $tree_commit with no src/ change between them"
  else
    find_ "operator runs $op_commit, the tree is at $tree_commit and src/ differs — old code until a restart (owner's hand)"
  fi
  case "$ver" in *'"dirty":true'*)
    note "operator started from a DIRTY src/ — its memory copy may match no commit at all" ;;
  esac
else
  [ "$HEALTH_UP" = 1 ] &&
    note "operator answers /api/health but not /api/version — it predates the stamp; its next restart carries it"
  pid="$(systemctl --user show "$RONIN_UNIT" -p MainPID --value 2>/dev/null)"
  if [ -n "${pid:-}" ] && [ "$pid" != "0" ] && [ -d "/proc/$pid" ]; then
    etimes="$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')"
    started=$(( $(date +%s) - ${etimes:-0} ))
    last_commit="$(git log -1 --format=%ct -- src/ package.json 2>/dev/null)"
    if [ -n "$last_commit" ] && [ "$last_commit" -gt "$started" ]; then
      sha="$(git log -1 --format=%h -- src/ package.json)"
      find_ "operator predates the latest src/ commit ($sha) — it is running old code until a restart (owner's hand)"
    else
      ok "operator is newer than the last committed src/ change (inferred from timestamps)"
    fi
  else
    note "no running operator to compare (covered above)"
  fi
fi
dirty="$(git status --porcelain -- src/ package.json 2>/dev/null | wc -l | tr -d ' ')"
[ "$dirty" != "0" ] &&
  note "src/ has $dirty uncommitted edit(s) the operator is not running — live on the next restart"

# ---- 5b. owner customization -------------------------------------------------------
# The checker reads only owner-authored stores and reports how malformed shadows fail
# to surface. Doctor carries its verdict as one finding; it never edits those files.
sect "user customization shadows"
if npm run byoin; then
  ok "owner customization surfaces through its readers"
else
  find_ "an owner customization is malformed — follow the remedy from npm run byoin above"
fi

# ---- 6. this machine ---------------------------------------------------------------
# Provisioning gaps are machine facts, not repo faults: doctor is where they surface.
sect "machine provisioning"

# Playwright — resolved the way scripts/smoke-ui.mjs resolves it. Without a browser
# the render gate does not exist on this box: ExecStartPost, libexec/ronin-gate and
# npm run verify all end at a binary that is not there.
# THE BROWSER MUST BE LAUNCHED, NOT RESOLVED. Asking whether the module imports is asking
# a configuration question, and this file exists to ask behavioural ones. The three pieces
# come apart (docs/host-tools.md): on 2026-08-13 the module and the Chromium binary were
# both installed here and the browser still died at `exit 127` on a missing libnspr4 —
# resolution said yes while the gate could not run at all. A doctor that says "the render
# gate can run" on the strength of an import is precisely the false all-clear it is here
# to prevent.
pw="$(node -e '
  const { createRequire } = require("module"); const { homedir } = require("os");
  // The same three steps, in the same order, as scripts/smoke-ui.mjs — doctor must answer
  // for the resolution the GATE will do, not a simpler one of its own.
  const LOADERS = [
    () => (process.env.RONIN_PLAYWRIGHT_PATH ? import(process.env.RONIN_PLAYWRIGHT_PATH) : null),
    () => createRequire(process.argv[1] + "/scripts/")("playwright"),
    () => createRequire(homedir() + "/.cache/ronin-host-tools/")("playwright"),
  ];
  (async () => {
    let pw;
    for (const load of LOADERS) {
      try { const m = await load(); if (m?.chromium) { pw = m; break; } } catch {}
    }
    if (!pw?.chromium) { console.log("nomodule"); return; }
    let b;
    try {
      b = await pw.chromium.launch({ timeout: 20000 });
      console.log("yes");
    } catch (e) {
      // The first "libfoo.so: cannot open shared object file" is the whole diagnosis; the
      // rest of a Playwright launch error is a screenful of chrome flags.
      const m = /([\w.+-]+\.so[\w.]*): cannot open shared object file/.exec(String(e?.message ?? e));
      console.log("nolaunch\t" + (m ? m[1] : String(e?.message ?? e).split("\n")[0].slice(0, 120)));
    } finally {
      try { await b?.close(); } catch {}
    }
  })();
' "$ROOT" 2>/dev/null)"
case "${pw%%$'\t'*}" in
  yes)
    ok "Playwright launches — the render gate can run" ;;
  nolaunch)
    find_ "the browser is installed but CANNOT LAUNCH (${pw#*$'\t'}) — its system libraries are missing, so the render gate still does not exist here and a client change reaches the owner unlooked-at. Root fixes it: sudo npx playwright install-deps chromium" ;;
  *)
    find_ "no headless browser — the render gate does not exist on this machine; a client change reaches the owner unlooked-at. Provision: mkdir -p \$HOME/.cache/ronin-host-tools && cd \$HOME/.cache/ronin-host-tools && npm i playwright && npx playwright install chromium (docs/host-tools.md)" ;;
esac

# git push credentials — a --dry-run push with prompts off. Sends nothing. This is a
# MACHINE capability check: can the release path publish dev and master from this box.
# It says nothing about whether any session's desk is clean, handed in or publishable —
# those are desk facts (WORKTREES.md), read from the desk, never from a credential probe.
if GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -oBatchMode=yes' \
   timeout 10 git push --dry-run origin HEAD >/dev/null 2>&1; then
  ok "git push credentials work — the release path can publish from this box (a machine fact; not a verdict on any desk)"
else
  find_ "cannot push to origin — dev and master cannot be published from this box until credentials are provisioned (gh auth login, or an SSH deploy key)"
fi

# Syncthing and .git — the precondition found on 2026-08-28 (WORKTREES.md §0). A checkout
# whose .git is two-way synced is corrupted by the second machine's older copy coming
# back, and worktree metadata holds absolute paths, so managed desks cannot coexist with
# a synced .git. Git syncs through the remote; Syncthing gets a pinned VIEW, never a
# checkout. Ask the share, not memory: a .stfolder marker on the root or an ancestor.
st_dir=""; d="$ROOT"
while [ -n "$d" ] && [ "$d" != "/" ]; do
  [ -d "$d/.stfolder" ] && { st_dir="$d"; break; }
  d="$(dirname "$d")"
done
if [ -z "$st_dir" ]; then
  note "the repository is not inside a Syncthing share"
elif grep -qE '^[[:space:]]*(\(\?[a-z]+\))?/?\.git/?[[:space:]]*$' "$st_dir/.stignore" 2>/dev/null; then
  ok "inside a Syncthing share ($st_dir) with .git ignored — the checkout is the box's alone"
else
  find_ "the repository is inside a Syncthing share ($st_dir) and .git is NOT in its .stignore — two peers writing .git corrupts it and no managed desk can be opened here; add a '.git' line to $st_dir/.stignore on every machine (WORKTREES.md §0, ronin_sops/syncthing.md)"
fi

# The guards and Ronin's tools on PATH (setup.sh appends the block; a shell must have
# re-read its rc since). Inert guards are invisible — that is why doctor asks.
shim_want="$ROOT/bin/shim/tmux"
shim_have="$(command -v tmux || true)"
if [ "$(readlink -f "$shim_have" 2>/dev/null)" = "$(readlink -f "$shim_want")" ]; then
  ok "tmux resolves to the guard shim"
elif [ "$(env -i HOME="$HOME" TERM="${TERM:-dumb}" bash -lc 'readlink -f "$(command -v tmux)"' 2>/dev/null)" = "$(readlink -f "$shim_want")" ]; then
  note "tmux resolves to ${shim_have:-nothing} in THIS shell, but a fresh login shell gets the guard shim — this pane predates the last ./setup.sh. New sessions are guarded"
else
  find_ "tmux resolves to ${shim_have:-nothing}, not bin/shim/tmux, and a fresh login shell does not get it either; re-run ./setup.sh"
fi
# TWO DIFFERENT FAULTS WEAR ONE SYMPTOM, and only one of them is anybody's to fix.
# "Not on PATH here" can mean the rc files never got the block — a real finding — or that
# THIS shell simply started before they did, which every pane on the box does after an
# install and which no action can retroactively change. Reporting both as a finding gives
# doctor a permanent nag, and a checker that always complains is one people stop reading.
#
# So ask a shell that has no history: a clean login shell, which is also the kind whose
# answer the rc fix of 2026-08-13 was actually about (~/.bashrc returns early when
# non-interactive, so the block also lives in ~/.profile — see setup.sh).
if command -v write_tegami >/dev/null 2>&1; then
  ok "bin/ tools reachable by bare name"
elif env -i HOME="$HOME" TERM="${TERM:-dumb}" bash -lc 'command -v write_tegami' >/dev/null 2>&1; then
  note "bin/ is not on THIS shell's PATH, but a fresh login shell has it — this pane started before ./setup.sh last ran. New sessions are fine; nothing to fix"
else
  find_ "bin/ is not on PATH, and a fresh login shell does not get it either — write_tegami, tejun* and koshi only work from the repo root; re-run ./setup.sh"
fi

# tmux server ownership — the single most expensive thing to get wrong: a server in
# the wrong cgroup dies with its parent, taking every session on the box with it.
if [ "$OS" = "Linux" ] && command -v systemctl >/dev/null 2>&1; then
  ts_state="$(systemctl --user show tmux-server -p ActiveState --value 2>/dev/null)"
  [ "$ts_state" = "active" ] || find_ "tmux-server unit is $ts_state — the next tmux server will land in whatever cgroup starts it; see docs/tmux-server-cgroup.md (owner's hand)"
  first="$(tmux list-sessions -F '#S' 2>/dev/null | head -1)"
  if [ -z "$first" ]; then
    note "no tmux server running — cgroup ownership not checkable until one exists"
  else
    spid="$(tmux display-message -pt "$first" '#{pid}' 2>/dev/null)"
    cg="$(cat "/proc/${spid:-0}/cgroup" 2>/dev/null)"
    case "$cg" in
      *tmux-server.service*) ok "tmux server lives in tmux-server.service's cgroup" ;;
      *ronin.service*)       find_ "the tmux server is inside the operator's cgroup — restarting Ronin WILL kill every session on this box; see docs/tmux-server-cgroup.md (owner's hand)" ;;
      '')                    note "could not read the tmux server's cgroup" ;;
      *)                     find_ "the tmux server is outside tmux-server.service (started by hand?) — sessions die with whatever started it; see docs/tmux-server-cgroup.md (owner's hand)" ;;
    esac
  fi
fi

# ---- 7. where this machine keeps things ---------------------------------------------
# A fungible ronin_machine resolves every location at runtime, so "where does this box keep
# X" must be answerable BY the box rather than by reading a doc written about another one.
# See docs/stores.md.
echo ""
sect "stores (docs/stores.md)"
if [ -x "$ROOT/bin/ronin-store" ]; then
  "$ROOT/bin/ronin-store" --all | sed 's/^/  /'
  # Every store resolves through the table or an explicit override — there is no third
  # possibility to report, by design. What is worth naming is a store pointed somewhere
  # by an env var, because that is the one answer that differs from every other box.
  pinned="$("$ROOT/bin/ronin-store" --all | awk 'NR>1 && $3=="env" {print $1}' | tr '\n' ' ')"
  if [ -n "${pinned// /}" ]; then
    note "pinned by environment: ${pinned% } — this box answers differently from a stock install"
  else
    ok "every store resolves under the two roots, unpinned"
  fi
else
  find_ "bin/ronin-store is missing or not executable — no tool can resolve a Ronin path on this box"
fi

# ---- 8. the two Claude Code settings Ronin's own features need ----------------------
# NOT a settings audit and never becoming one: two keys, each the reason a Ronin feature
# would otherwise be silently dark. This is a FIND rather than a note because both failures
# look like Ronin being broken — a context gauge that never fills, and a light shell whose
# pane stays black — and neither says why. The common case is someone who installed Claude
# Code AFTER setup.sh ran, so the installer never saw their settings file at all.
echo ""
sect "Claude Code settings (hostside/claude-settings.py)"
if ! command -v python3 >/dev/null 2>&1; then
  note "python3 not found — cannot read ~/.claude/settings.json"
elif [ ! -f "$HOME/.claude/settings.json" ] && ! command -v claude >/dev/null 2>&1; then
  ok "Claude Code is not installed on this box — nothing to set"
elif "$ROOT/hostside/claude-settings.py" --check >/dev/null 2>&1; then
  ok "statusLine and an -ansi theme are both set"
else
  "$ROOT/hostside/claude-settings.py" --check 2>/dev/null | sed 's/^    /  /'
  find_ "Claude Code is missing a setting Ronin needs — run: hostside/claude-settings.py"
fi

# ---- the steps setup.sh offers once, and nothing re-checked -------------------------
#
# setup.sh detects each of these, hands the person a line, and never looks again. An
# install that predates the offer never saw it at all, and a person can decline or miss
# it — so the only place these can be caught afterwards is here. Same reasoning as the
# swap finding below.
#
# ONE DEFINITION, NOT A THIRD OPINION: `ronin_served_url` is how setup.sh and
# ronin-welcome both answer "is a door pointed at this install", so doctor sources the
# same library rather than asking its own way. Four disagreeing opinions about where a
# browser lives is a mistake this tree has already made once.
# shellcheck source=../libexec/ronin-banner.sh
[ -r "$ROOT/libexec/ronin-banner.sh" ] && . "$ROOT/libexec/ronin-banner.sh"
# shellcheck source=../libexec/ronin-machine.sh
[ -r "$ROOT/libexec/ronin-machine.sh" ] && . "$ROOT/libexec/ronin-machine.sh"

sect "the install steps"

# LINGER is a genuine fault when it is off. Without it the user manager stops at logout
# and every --user service goes with it, so the coworkspace is simply absent whenever
# nobody is signed in — which reads as "Ronin is broken", not "a step was skipped".
machine_linger_on; case $? in
  0) ok "linger is on — the coworkspace survives logout" ;;
  2) note "no loginctl here — linger not assessed" ;;
  *) find_ "linger is OFF — every --user service stops at logout, so Ronin is absent whenever nobody is signed in. remedy: sudo $(machine_linger_action)" ;;
esac

# SERVE is a NOTE, deliberately, and not a finding. Reaching the install over the tailnet
# at http://ip:port is a legitimate arrangement — setup.sh's own banner falls back to
# exactly that — so an absent `serve` is a fact worth stating and not a fault. A gate
# that cries wolf gets disabled, and this is the shape of question that would.
if ! command -v tailscale >/dev/null 2>&1; then
  note "no tailscale here — no tailnet door to check"
elif ! served="$(ronin_served_url "$PORT" 2>/dev/null)"; then
  note "tailscale is present but did not answer — door not assessed"
elif [ -n "$served" ]; then
  ok "a tailnet door serves this install — $served"
else
  note "no HTTPS tailnet door for port $PORT; reachable over the tailnet by address, or run: sudo tailscale serve --bg --https=8443 http://$HOSTIP:$PORT"
fi

# ---- the box itself: can it survive a busy hour? ------------------------------------
#
# Ronin runs several agent sessions at once and each one runs real work — test suites,
# builds, browsers. On a box with no swap the kernel has no overflow when memory fills:
# it picks a process and kills it, and it picks which. On this box that means a session
# dies with somebody's work in it, without warning. Swap does not create memory; it
# converts a sudden death into slowness, which is the difference between losing an hour
# and noticing the box is sluggish.
#
# A finding, never an action. Doctor reads; it does not touch the machine, and a
# swapfile needs root that Ronin does not hold.
sect "the box"

# WHAT KILLED IT. After something dies unexpectedly the first question is what the kernel
# killed and when, and on a stock box that answer is unreadable: kernel.dmesg_restrict is
# commonly 1 and journalctl -k returns nothing without the right group. A session that
# cannot read the log must say so rather than infer a cause from timing — "the box was
# short of memory and a process vanished" is an observation; "the kernel OOM-killed it" is
# a claim that needs the log.
#
# INFORMS, DOES NOT PRESCRIBE. The remedy is read-only and it is the box owner's own
# account, but it is still an expansion — after it, anything running as this user can read
# system logs. The line states that so the owner chooses knowing it.
machine_kernel_log_readable; case $? in
  0) ok "the kernel log is readable — an agent can say what was killed and when" ;;
  2) note "no kernel log interface here — OOM history not assessed on this system" ;;
  # A NOTE, NOT A FINDING (owner, 2026-08-25). `kernel.dmesg_restrict=1` is the stock
  # default on Debian and Ubuntu, so a finding here goes red on a correctly-configured box
  # — for every third-party install, on day one, forever. Nothing in Ronin reads the kernel
  # log; it buys an agent one better sentence after an OOM kill and nothing else. And the
  # remedy WIDENS PRIVILEGE: `adm` lets everything running as this user read system logs,
  # not just doctor. A health check does not get to lobby for more access than the product
  # needs. Case 2 below — no kernel log interface at all, which is strictly worse and
  # cannot be fixed — was already a note; grading the fixable case harder than the
  # permanent one was backwards. The remedy stays in the text for anyone who wants it.
  *) note "the kernel log is not readable, so after something is killed nothing here can say what or when — only that it vanished. Optional, and Ronin needs none of it: 'sudo $(machine_kernel_log_action)' then log out and back in buys that history, at the cost of letting anything running as this user read system logs. ronin_sops/remote_machine_health.md § what killed it" ;;
esac

machine_has_swap; case $? in
  0) ok "swap is configured ($(machine_swap_total))" ;;
  2) note "no /proc/swaps on this system — swap not assessed here (Linux-only reading)" ;;
  *)
    if machine_is_container; then
      note "no swap, but this is a container — swap is the host's business, not this install's"
    else
      ram_gb="$(awk '/^MemTotal:/ {printf "%.0f", $2/1048576; exit}' /proc/meminfo 2>/dev/null)"
      find_ "NO SWAP on this box (${ram_gb:-?} GB RAM) — when memory fills the kernel kills a process rather than slowing down, and it chooses which. remedy: ronin_sops/remote_machine_health.md § swap"
    fi ;;
esac

# ---- verdict -----------------------------------------------------------------------
echo ""
if [ "$FINDINGS" -eq 0 ]; then
  echo "RONIN DOCTOR: nothing is outstanding — what is running is what is written."
  exit 0
fi
echo "RONIN DOCTOR: $FINDINGS finding(s) — each line above names its remedy."
exit 1
