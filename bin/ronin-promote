#!/usr/bin/env bash
# RONIN PROMOTE — team promotion: the lead's door from a team line into `dev`.
#
#   bin/ronin-promote <team>                      candidates → receipt → CAS advance → restart → health
#   bin/ronin-promote <team> --dry-run            build candidates; write nothing, move nothing
#   bin/ronin-promote <team> --no-restart         move dev, skip the restart + health checks
#   bin/ronin-promote resume <receipt-id>         finish an interrupted coordinated promotion from its receipt
#   bin/ronin-promote abandon <receipt-id> <why>  give an interrupted one up — refs already moved stay moved
#   bin/ronin-promote revert <receipt-id>|last    land a revert of that promotion through the same door
#   bin/ronin-promote bisect <team> [--repo r]    check each hand-in applies to the working line
#   bin/ronin-promote receipts [team]             the ledger, one line each
#   bin/ronin-promote show <receipt-id> [--pr-block|--shared]
# src/promotion-cli.ts calls the operator HTTP surface and prints its reply.
#
# Promotion builds each candidate, writes its receipt, advances references by
# compare-and-swap, restarts the live app, and checks deployment health. The receipt is
# on disk before the first reference moves, so an interruption is visible and resumable.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
fi
. "$ROOT/libexec/ronin-temp-hygiene.sh"
ronin_tmp_janitor
ronin_tmp_preflight || exit 1
PROMOTION_TMP="$(mktemp -d "${TMPDIR:-/tmp}/ronin-promotion-XXXXXX")" || exit 1
trap 'rm -rf -- "$PROMOTION_TMP"' EXIT HUP INT TERM
export TMPDIR="$PROMOTION_TMP"
export TSX_DISABLE_CACHE=1
npx tsx src/promotion-cli.ts "$@"
