#!/usr/bin/env bash
# ronin-claim — which session staged what, so a commit can only carry its own work.
#
# THE PROBLEM IT SOLVES. Every session on this box shares ONE working tree and ONE git
# index. `git add` writes to that shared index, and `git commit` with no pathspec commits
# ALL of it — so anything another session staged between your add and your commit rides
# along under your message. Staging explicit paths does not help: the theft happens at
# commit time, not add time.
#
# It is a race, so it is rare and it is invisible. Every gate still passes, the tree is
# still correct, and only the COMMITS are wrong — which is the worst possible shape,
# because nothing on the box shows it.
#
#   ronin-claim add <paths...>   stage-and-record: what this session actually staged
#   ronin-claim check            does the index hold anything this session did not stage?
#   ronin-claim clear            forget this session's claim (after a successful commit)
#   ronin-claim show             what this session has staged
#
# The claim is a TENANT OF THE SESSION DIRECTORY, beside the letter and the tape: it is
# per-session, it dies with the session, and it needs no store of its own.
set -uo pipefail

# BYTE ORDER, EVERYWHERE. `sort` collates by locale and `comm` compares by byte, so under
# any UTF-8 locale the two disagree on strings containing '.' or '_' — which is every
# filename here. The symptom is not an error you notice: comm prints "not in sorted order"
# to stderr, yields nothing, and the guard waves the commit through. Found exactly that way.
export LC_ALL=C

die() { printf '%s\n' "$*" >&2; exit 3; }

# WHICH SESSION AM I — taken exactly the way bin/write_tegami takes it, and for the reason
# written there: `display-message` with an empty -t answers for the ATTACHED CLIENT, i.e.
# whichever tile the owner has focused right now. That fallback once wrote one session's
# ladder into another's letter. TMUX_PANE, then $TMUX, then die. Never the focused tile.
me() {
  local win s sid
  if [ -n "${TMUX_PANE:-}" ]; then
    win=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null) || win=""
    if [ -n "$win" ]; then
      s=$(tmux list-windows -a -F '#{session_name}	#{window_id}' 2>/dev/null \
          | awk -F'	' -v w="$win" '$2==w && $1 !~ /^grid_/ {print $1; exit}')
      [ -n "$s" ] && { printf '%s\n' "$s"; return 0; }
    fi
  fi
  if [ -n "${TMUX:-}" ]; then
    sid=${TMUX##*,}
    s=$(tmux list-sessions -F '#{session_id}	#{session_name}' 2>/dev/null \
        | awk -F'	' -v i="\$$sid" '$1==i && $2 !~ /^grid_/ {print $2; exit}')
    [ -n "$s" ] && { printf '%s\n' "$s"; return 0; }
  fi
  return 1   # not in a session: the caller decides, and every caller here fails OPEN
}

key_of() {
  local row stamped created
  row=$(tmux list-sessions -F '#{session_name}	#{@ronin-key}	#{session_created}' 2>/dev/null \
        | awk -F'	' -v n="$1" '$1==n {print; exit}')
  [ -n "$row" ] || return 1
  stamped=$(printf '%s' "$row" | cut -f2)
  created=$(printf '%s' "$row" | cut -f3)
  if   [ -n "${stamped// /}" ]; then printf '%s\n' "$stamped"
  elif [ -n "${created// /}" ]; then printf '%s\n' "$1-$created"
  else printf '%s\n' "$1"; fi
}

# Where the session record lives on THIS machine. Asked, never spelled — JUSHO.
STORE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ronin-store"
[ -x "$STORE" ] || STORE=ronin-store

# The claim file for this session, or empty if we cannot tell who we are.
claim_file() {
  local name key dir
  name=$(me) || return 1
  key=$(key_of "$name") || return 1
  dir="$("$STORE" session 2>/dev/null)" || return 1
  [ -n "$dir" ] || return 1
  printf '%s/%s/staged\n' "$dir" "$key"
}

# One index snapshot: "<blob> <path>" per staged file. Blob included so that RE-staging a
# file with new content registers as this session's act even when the path was already
# staged by someone else.
snapshot() { git ls-files -s 2>/dev/null | awk '{print $2, $4}'; }

case "${1:-}" in
  add)
    shift
    before=$(snapshot)
    git add "$@" || exit $?
    after=$(snapshot)
    cf=$(claim_file) || exit 0     # not in a session: stage normally, record nothing
    mkdir -p "$(dirname "$cf")" 2>/dev/null || exit 0
    # Whatever changed in the index is what THIS command staged — including a path that
    # was already there under someone else's blob.
    comm -13 <(printf '%s\n' "$before" | sort) <(printf '%s\n' "$after" | sort) \
      | awk '{ $1=""; sub(/^ /,""); print }' >> "$cf" 2>/dev/null
    sort -u -o "$cf" "$cf" 2>/dev/null
    exit 0
    ;;

  check)
    cf=$(claim_file) || exit 0     # cannot tell who we are -> never block. Fails OPEN.
    # No claim file means this session has staged nothing through the shim, so there is no
    # basis on which to judge it. Silence, not suspicion.
    [ -s "$cf" ] || exit 0
    staged=$(git diff --cached --name-only 2>/dev/null | sort -u)
    [ -n "$staged" ] || exit 0
    extra=$(comm -23 <(printf '%s\n' "$staged") <(sort -u "$cf"))
    [ -n "$extra" ] || exit 0
    n=$(printf '%s\n' "$extra" | grep -c .)
    {
      echo
      echo "REFUSED: this commit carries $n file(s) your session never staged."
      echo
      printf '%s\n' "$extra" | sed 's/^/    /'
      echo
      echo "  Every session on this box shares one working tree and one git index."
      echo "  \`git commit\` with no pathspec commits the WHOLE index, so another session's"
      echo "  staged work rides along under your message. Nothing else shows this: the tree"
      echo "  stays correct and every gate still passes — only the commits are wrong."
      echo
      echo "  Commit just yours, which also leaves theirs safely staged:"
      echo
      echo "      git commit -m '...' -- \$(ronin-claim show | tr '\\n' ' ')"
      echo
      echo "  If those files really are yours (you staged them with plain git, or you are"
      echo "  deliberately landing another session's orphaned work):"
      echo
      echo "      RONIN_COMMIT_ALL=1 git commit -m '...'"
    } >&2
    exit 4
    ;;

  clear)
    cf=$(claim_file) || exit 0
    rm -f "$cf" 2>/dev/null
    exit 0
    ;;

  show)
    cf=$(claim_file) || exit 0
    [ -f "$cf" ] && cat "$cf"
    exit 0
    ;;

  *)
    die "usage: ronin-claim add <paths...> | check | clear | show"
    ;;
esac
