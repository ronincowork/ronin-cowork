#!/usr/bin/env bash
# ronin-tools-pack — the tool package (KAN-737): Ronin's own tools for a machine outside the
# office, where a daimyo (the user's own AI manager) drives it. Packs the committed ronin_bin
# and the two helpers item and team call into one npm tarball:
#
#   bin/ronin-tools-pack [<out-dir>]      → <out-dir>/ronin-tools-<version>.tgz
#   npm i -g ./ronin-tools-<version>.tgz  (or its URL)
#
# Each tool installs as ronin_bin/ronin-outside under its own name, which picks the office and
# runs the real tool (ronin_bin/ronin-outside, docs/architecture/operator-connection.md).
# Needs curl and python3 where it runs; no TypeScript, no tmux.
set -euo pipefail
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
OUT=$(cd "${1:-.}" && pwd)
TOOLS=(item team edges session_create session_check session_set session_archive session_restore plan canvas office epic-template lookup worktree-desk ronin-outside)
VERSION=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$ROOT/package.json")
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

# Committed files only, as a release is built (bin/ronin-build).
git -C "$ROOT" archive --format=tar HEAD ronin_bin libexec/item-plain libexec/team-roster-write | tar -x -C "$STAGE"
python3 - "$STAGE/package.json" "$VERSION" "${TOOLS[@]}" <<'PY'
import json, sys
path, version, *tools = sys.argv[1:]
json.dump({
    "name": "ronin-tools", "version": version,
    "description": "Ronin's own tools, reaching an office from your machine: items, Teams, Agents, messages, plans.",
    "license": "Apache-2.0",
    "bin": {tool: "ronin_bin/ronin-outside" for tool in tools},
    "files": ["ronin_bin", "libexec"],
}, open(path, "w"), indent=2)
PY
(cd "$STAGE" && npm pack --silent --pack-destination "$OUT" >/dev/null)
echo "$OUT/ronin-tools-$VERSION.tgz"
