#!/usr/bin/env bash
# RONIN UPDATE — install a released ronin_artifact, or move an install to a newer one.
#
#   bin/ronin-update                     # fetch the latest cowork release, install it
#   bin/ronin-update --services          # same verbs for the SERVICES package
#   bin/ronin-update --check [--json]    # report BOTH packages vs latest, change nothing
#   bin/ronin-update --version v1.2.0    # install that release
#   bin/ronin-update --file <tarball>    # install a tarball already on disk
#   bin/ronin-update --rollback          # point current back at the previous release
#   bin/ronin-update --home <dir>        # the install home (needed from a checkout)
#
# TWO PACKAGES, ONE FLOW. Cowork swaps a release symlink; services land in the
# <home>/services store and are copied into the serving tree, where the assembler
# discovers them at boot. A services release installs only if its contract number
# matches the running cowork's (connector-contract.md); cowork updates carry the
# installed services into each new candidate, so the candidate gates as The Works.
#
# THE LAYOUT it manages — every release unpacked whole, one symlink saying which serves:
#
#   <home>/releases/v1.0.0/     <home>/current -> releases/v1.1.0
#   <home>/releases/v1.1.0/     <home>/previous -> releases/v1.0.0   (rollback target)
#   <home>/.env                 (lives in the home, linked into each release)
#
# THE FLOW: fetch → verify the checksum → unpack BESIDE current → npm install → boot
# the CANDIDATE on a loopback scratch port and gate its rendered page → only then swap
# `current` and restart → gate the live page. A failed gate swaps nothing: the serving
# release never moved. The candidate boot is a preflight measured in seconds, killed
# after the gate — not a second serving copy.
#
# WHAT AN UPDATE CANNOT DO: kill your sessions. They live in tmux-server.service, a
# unit this script never touches; only ronin (the operator) restarts, and the
# browser reconnects. The systemd unit points at <home>/current, so a swap never edits
# the unit file — the one route a restart cannot carry (docs/repo-to-operator.md).
# If a release changes deploy/*.service, this script says so loudly: that needs
# ./setup.sh from <home>/current, which re-copies units.
#
# WHERE THE HOME IS is never spelled in code (scripts/check-place.mjs): an installed
# copy of this script sits at <home>/releases/<v>/bin/ronin-update and derives the
# home from its own location. Run from a checkout there is no home to derive, so
# --home is required — the first install (cutover) names it once, explicitly.
#
# Outbound: this asks github.com for the release feed and the tarball — on the
# owner's press only, never on a timer (the ⚙ gear calls --check when clicked).
# When AGERU's egress_log lands, these fetches are entries in it.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # the tree this script is in
SLUG="${RONIN_RELEASE_REPO:-ronincowork/ronin-cowork}"    # the cowork release feed
# The services feed: the PUBLIC assets-only releases repo — tarballs, never source
# (the paid layer's code stays private; the owner ruled the download ungated). A
# stranger's curl reaches it with no auth, which is what makes the ⚙ gear's install
# one press. Override for a fork or a private trial: RONIN_SERVICES_REPO.
SVC_SLUG="${RONIN_SERVICES_REPO:-ronincowork/ronin-releases}"

fail() { echo "✗ $1" >&2; exit 1; }
say()  { echo "→ $1"; }

# The operator unit is ronin.service; a box that has not re-run setup.sh since the
# 2026-08-19 rename still runs it as tmux-ronin.service. Talk to whichever exists.
RONIN_UNIT="ronin"
systemctl --user cat ronin.service >/dev/null 2>&1 || RONIN_UNIT="tmux-ronin"

# --- arguments ---
MODE="install"; WANT=""; FILE=""; HOME_DIR=""; JSON=0; PACKAGE="cowork"
while [ $# -gt 0 ]; do
  case "$1" in
    --check)    MODE="check" ;;
    --rollback) MODE="rollback" ;;
    --json)     JSON=1 ;;
    --services) PACKAGE="services" ;;
    --version)  shift; WANT="${1:-}"; [ -n "$WANT" ] || fail "--version needs vX.Y.Z" ;;
    --file)     shift; FILE="${1:-}"; [ -n "$FILE" ] || fail "--file needs a path" ;;
    --home)     shift; HOME_DIR="${1:-}"; [ -n "$HOME_DIR" ] || fail "--home needs a directory" ;;
    *) fail "unrecognised argument: $1 (see the header of this script)" ;;
  esac
  shift
done

# --- where is the install home? ---
# An installed copy carries VERSION and sits either at <home>/releases/<v>/ or is
# reached through <home>/current (the ⚙ gear runs it that way — bash keeps the
# logical path, so the parent reads "current", not "releases"; the physical-path
# check covers any other symlinked route). A checkout has none of this: --home.
if [ -z "$HOME_DIR" ] && [ -f "$SELF/VERSION" ]; then
  if [ "$(basename "$SELF")" = "current" ]; then
    HOME_DIR="$(cd "$SELF/.." && pwd)"
  elif [ "$(basename "$(dirname "$SELF")")" = "releases" ]; then
    HOME_DIR="$(cd "$SELF/../.." && pwd)"
  else
    P="$(readlink -f "$SELF" 2>/dev/null)"
    [ "$(basename "$(dirname "$P")")" = "releases" ] && HOME_DIR="$(dirname "$(dirname "$P")")"
  fi
fi
if [ -z "$HOME_DIR" ]; then
  if [ "$MODE" = "check" ] && [ -z "$FILE" ]; then
    : # a bare --check from a checkout still works: installed=none, latest from the feed
  else
    fail "run from a checkout: pass --home <dir> (the install home; docs/release.md)"
  fi
fi

installed_release() {
  [ -n "$HOME_DIR" ] && sed -n 's/^release=//p' "$HOME_DIR/current/VERSION" 2>/dev/null || true
}
services_installed_release() {
  [ -n "$HOME_DIR" ] && sed -n 's/^release=//p' "$HOME_DIR/services/VERSION" 2>/dev/null || true
}

# --- the release feeds (gh when it is there, curl for a public repo) ---
have_gh() { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; }

latest_release() { # $1=repo slug
  # No answer is an ANSWER (installed stays, latest reads unknown), never an exit:
  # under `set -e` a bare failing pipeline here would kill --check mid-JSON.
  if have_gh; then
    gh release view --repo "$1" --json tagName -q .tagName 2>/dev/null || true
  else
    curl -fsS -m 10 "https://api.github.com/repos/$1/releases/latest" 2>/dev/null |
      sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1 || true
  fi
}

fetch_release() { # $1=repo slug $2=package name $3=version $4=workdir
  if have_gh; then
    gh release download "$3" --repo "$1" \
      --pattern "$2-$3.tar.gz" --pattern SHA256SUMS --dir "$4" ||
      fail "could not download release $3 from $1"
  else
    curl -fsSL -o "$4/$2-$3.tar.gz" \
      "https://github.com/$1/releases/download/$3/$2-$3.tar.gz" &&
    curl -fsSL -o "$4/SHA256SUMS" \
      "https://github.com/$1/releases/download/$3/SHA256SUMS" ||
      fail "could not download release $3 (private repo? install gh, or use --file)"
  fi
}

# --- check: report BOTH packages and stop ---
if [ "$MODE" = "check" ]; then
  inst="$(installed_release)"
  latest="$(latest_release "$SLUG")"
  svc_inst="$(services_installed_release)"
  svc_latest="$(latest_release "$SVC_SLUG")"
  if [ "$JSON" = 1 ]; then
    printf '{"installed":%s,"latest":%s,"upToDate":%s,"services":{"installed":%s,"latest":%s,"upToDate":%s}}\n' \
      "$([ -n "$inst" ] && printf '"%s"' "$inst" || echo null)" \
      "$([ -n "$latest" ] && printf '"%s"' "$latest" || echo null)" \
      "$([ -n "$inst" ] && [ "$inst" = "$latest" ] && echo true || echo false)" \
      "$([ -n "$svc_inst" ] && printf '"%s"' "$svc_inst" || echo null)" \
      "$([ -n "$svc_latest" ] && printf '"%s"' "$svc_latest" || echo null)" \
      "$([ -n "$svc_inst" ] && [ "$svc_inst" = "$svc_latest" ] && echo true || echo false)"
  else
    echo "cowork    : ${inst:-none (no release at ${HOME_DIR:-<no home>}/current)} · latest ${latest:-unknown}"
    echo "services  : ${svc_inst:-none} · latest ${svc_latest:-unknown}"
    [ -n "$latest" ] && [ "$inst" != "$latest" ] && echo "→ bin/ronin-update to install cowork ${latest}"
    [ -n "$svc_latest" ] && [ "$svc_inst" != "$svc_latest" ] && echo "→ bin/ronin-update --services to install services ${svc_latest}"
  fi
  exit 0
fi

# --- the serving question: does THIS home's current serve the unit? ---
unit_serves_home() {
  local wd
  wd="$(systemctl --user show "$RONIN_UNIT" -p WorkingDirectory --value 2>/dev/null || true)"
  [ -n "$wd" ] && [ -e "$HOME_DIR/current" ] &&
    [ "$(readlink -f "$wd" 2>/dev/null)" = "$(readlink -f "$HOME_DIR/current")" ]
}

# The render check, byoin's contract exactly (bin/ronin-byoin): exit 0 = rendered
# and looked at; exit 2 = NO HEADLESS BROWSER here, an honest SKIP with its reason —
# a laptop installing for the first time has no Playwright and must not be refused
# for it; anything else = the page is actually broken.
render_check() { # $1=tree $2=url $3=what; returns 1 only on a REAL failure
  local out rc=0
  out="$(cd "$1" && node scripts/smoke-ui.mjs "$2" 2>&1)" || rc=$?
  if [ "$rc" = 0 ]; then
    say "$3 gated: the page renders"
  elif [ "$rc" = 2 ]; then
    say "⚠ render gate SKIPPED for $3 — no headless browser on this machine, so the page has NOT been looked at (docs/host-tools.md). The boot and the version answer are the proof available here."
  else
    printf '%s\n' "$out" | tail -12 | sed 's/^/  /'
    return 1
  fi
}

restart_and_gate() {
  say "restarting Ronin (sessions live in tmux-server.service — untouched)"
  systemctl --user restart "$RONIN_UNIT" || fail "restart failed — systemctl --user status $RONIN_UNIT"
  local port bind url
  port="$(sed -n 's/^PORT=//p' "$HOME_DIR/.env" 2>/dev/null | head -1)"
  bind="$(sed -n 's/^BIND=//p' "$HOME_DIR/.env" 2>/dev/null | head -1)"
  url="http://${bind:-127.0.0.1}:${port:-3006}/"
  for _ in $(seq 1 30); do
    curl -fsS -m 2 -o /dev/null "${url}api/health" 2>/dev/null && break
    sleep 1
  done
  render_check "$HOME_DIR/current" "$url" "the live page" ||
    fail "the LIVE page failed its gate after the swap — roll back: bin/ronin-update --rollback"
}

# --- rollback: the previous unpacked release, by symlink ---
if [ "$MODE" = "rollback" ]; then
  [ "$PACKAGE" = "services" ] &&
    fail "services keep no previous copy — roll back by installing the prior release: bin/ronin-update --services --version vX.Y.Z"
  prev="$(readlink "$HOME_DIR/previous" 2>/dev/null || true)"
  [ -n "$prev" ] && [ -d "$HOME_DIR/$prev" ] ||
    fail "no previous release recorded at $HOME_DIR/previous — nothing to roll back to"
  cur="$(readlink "$HOME_DIR/current" 2>/dev/null || true)"
  say "rolling back: current -> $prev (was $cur)"
  ln -sfn "$prev" "$HOME_DIR/current"
  ln -sfn "$cur"  "$HOME_DIR/previous"   # roll forward is another --rollback
  if unit_serves_home; then restart_and_gate; else
    say "swapped; this home is not what the unit serves, so nothing was restarted"
  fi
  echo "✓ current is $(installed_release)"
  exit 0
fi

# --- install ---
WORK="$(mktemp -d)"
CANDIDATE_PID=""
# npm start is a tree (npm → sh → tsx); killing the top leaves the server running.
kill_tree() {
  local p
  for p in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$p"; done
  kill "$1" 2>/dev/null || true
}
cleanup() {
  [ -n "$CANDIDATE_PID" ] && kill_tree "$CANDIDATE_PID"
  rm -rf "$WORK"
}
trap cleanup EXIT

# Which package this run moves: name, feed, and what counts as already-installed.
if [ "$PACKAGE" = "services" ]; then PKG="ronin-services"; FEED="$SVC_SLUG"; INST="$(services_installed_release)"
else PKG="ronin-cowork"; FEED="$SLUG"; INST="$(installed_release)"; fi

if [ -n "$FILE" ]; then
  [ -f "$FILE" ] || fail "no such file: $FILE"
  cp "$FILE" "$WORK/"
  sums="$(dirname "$FILE")/SHA256SUMS"
  if [ -f "$sums" ]; then cp "$sums" "$WORK/"; else
    say "⚠ no SHA256SUMS beside $FILE — installing UNVERIFIED bytes (fine for a --dirty trial, never for a release)"
  fi
  TARBALL="$(basename "$FILE")"
  VER="$(echo "$TARBALL" | sed -n "s/^$PKG-\(v[0-9][^ ]*\)\.tar\.gz$/\1/p")"
  [ -n "$VER" ] || fail "cannot read a version out of '$TARBALL' (expected $PKG-vX.Y.Z.tar.gz)"
else
  VER="${WANT:-$(latest_release "$FEED")}"
  [ -n "$VER" ] || fail "could not learn the latest release (private repo needs gh auth; or pass --version / --file)"
  if [ "$VER" = "$INST" ]; then echo "✓ already on $PKG $VER — nothing to do"; exit 0; fi
  say "fetching $VER from $FEED"
  fetch_release "$FEED" "$PKG" "$VER" "$WORK"
  TARBALL="$PKG-$VER.tar.gz"
fi

# --- verify ---
if [ -f "$WORK/SHA256SUMS" ]; then
  (cd "$WORK" && grep "$TARBALL" SHA256SUMS | sha256sum -c -) >/dev/null ||
    fail "CHECKSUM MISMATCH on $TARBALL — refusing to install; the download is not the release"
  say "checksum verified"
fi

# =====================================================================
# SERVICES: contract check → store → copy into the serving tree → restart.
# The store (<home>/services/) survives every cowork update; the cowork flow below
# carries it into each new release candidate. No candidate boot here: services are
# discovered by the operator at start, so the restart's own gate is the proof.
# =====================================================================
if [ "$PACKAGE" = "services" ]; then
  [ -e "$HOME_DIR/current" ] || fail "no cowork install at $HOME_DIR/current — services install into a cowork that is already there"
  # The load-bearing line: built-for contract vs the contract this cowork answers.
  svc_contract="$(tar -xzf "$WORK/$TARBALL" -O "$PKG-$VER/VERSION" 2>/dev/null | sed -n 's/^contract=//p')"
  cow_contract="$(sed -n 's/^export const CONTRACT_V = \([0-9][0-9]*\);.*/\1/p' "$HOME_DIR/current/src/sockets-contract.ts" 2>/dev/null)"
  [ -n "$svc_contract" ] && [ -n "$cow_contract" ] || fail "could not read a contract number from both sides — refusing to guess"
  [ "$svc_contract" = "$cow_contract" ] ||
    fail "contract mismatch: services $VER is built for contract $svc_contract, this cowork answers $cow_contract — update cowork first (or install an older services release)"
  say "contract check: both sides answer $svc_contract"
  # Into the store, atomically enough: unpack fresh, then swap the directory.
  rm -rf "$HOME_DIR/services.partial"
  mkdir -p "$HOME_DIR/services.partial"
  tar -xzf "$WORK/$TARBALL" --strip-components=1 -C "$HOME_DIR/services.partial"
  if [ -d "$HOME_DIR/services" ]; then mv "$HOME_DIR/services" "$HOME_DIR/services.old"; fi
  mv "$HOME_DIR/services.partial" "$HOME_DIR/services"
  rm -rf "$HOME_DIR/services.old"
  say "stored: $HOME_DIR/services ($VER)"
  # Into the serving tree, where the assembler discovers them at boot.
  mkdir -p "$HOME_DIR/current/src/services"
  for d in "$HOME_DIR/services"/*/; do
    { [ -f "$d/register.js" ] || [ -f "$d/register.ts" ]; } || continue
    name="$(basename "$d")"
    rm -rf "${HOME_DIR:?}/current/src/services/$name"
    cp -r "$d" "$HOME_DIR/current/src/services/$name"
  done
  say "placed into current/src/services/ — discovery finds them at the next start"
  if unit_serves_home; then
    restart_and_gate
    echo "✓ services $VER is live — /api/version lists the roster"
  else
    echo "✓ services $VER installed — this home is not what the unit serves; restart the operator that is (docs/release.md)"
  fi
  exit 0
fi

# --- unpack BESIDE current ---
TARGET="$HOME_DIR/releases/$VER"
if [ -e "$TARGET" ]; then
  [ "$(readlink "$HOME_DIR/current" 2>/dev/null)" = "releases/$VER" ] &&
    fail "$VER is already the serving release"
  say "replacing the previously unpacked (not serving) $TARGET"
  rm -rf "$TARGET"
fi
mkdir -p "$HOME_DIR/releases"
mkdir -p "$TARGET.partial"
tar -xzf "$WORK/$TARBALL" --strip-components=1 -C "$TARGET.partial"
mv "$TARGET.partial" "$TARGET"
say "unpacked to releases/$VER"

# --- complete it: dependencies and the .env link ---
# npm install, not --production: tsx sits in devDependencies and IS the runtime — a
# repo fact this script records rather than routes around.
say "npm install in the candidate (node_modules do not travel in the tarball)"
(cd "$TARGET" && npm install --no-fund --no-audit --loglevel=error >/dev/null) ||
  fail "npm install failed in $TARGET — the release does not complete on this machine"
if [ ! -f "$HOME_DIR/.env" ]; then
  cp "$TARGET/.env.example" "$HOME_DIR/.env" && chmod 600 "$HOME_DIR/.env"
  say "created $HOME_DIR/.env from .env.example (edit for auth / port; it survives every update)"
fi
ln -sfn "$HOME_DIR/.env" "$TARGET/.env"
# Installed services survive a cowork update BECAUSE of this copy: the store is the
# home's, the release dir is disposable, and the candidate gates as The Works —
# a cowork release that breaks the installed services never becomes the serving one.
if [ -d "$HOME_DIR/services" ]; then
  mkdir -p "$TARGET/src/services"
  for d in "$HOME_DIR/services"/*/; do
    { [ -f "$d/register.js" ] || [ -f "$d/register.ts" ]; } || continue
    cp -r "$d" "$TARGET/src/services/$(basename "$d")"
  done
  say "carried services forward ($(services_installed_release)) — the candidate gates as The Works"
fi

# --- gate the CANDIDATE before anything swaps ---
# Loopback scratch port: the candidate is reachable only from this machine, for the
# seconds the gate needs, then killed. PORT/BIND as environment beat the linked .env
# (dotenv never overrides real env). It watches the same tmux server as the live
# operator — sessions are shared state and that is the design being tested.
SCRATCH=""
for p in 3979 3980 3981 3982 3983; do
  curl -fsS -m 1 -o /dev/null "http://127.0.0.1:$p/api/health" 2>/dev/null || { SCRATCH="$p"; break; }
done
[ -n "$SCRATCH" ] || fail "no free scratch port in 3979-3983"
say "booting the candidate on loopback:$SCRATCH for its gate"
(cd "$TARGET" && PORT="$SCRATCH" BIND=127.0.0.1 npm start >"$WORK/candidate.log" 2>&1) &
CANDIDATE_PID=$!
for _ in $(seq 1 30); do
  curl -fsS -m 1 -o /dev/null "http://127.0.0.1:$SCRATCH/api/health" 2>/dev/null && break
  kill -0 "$CANDIDATE_PID" 2>/dev/null || { sed 's/^/  candidate: /' "$WORK/candidate.log" | tail -20; fail "the candidate died at boot — nothing was swapped"; }
  sleep 1
done
ANSWER="$(curl -fsS -m 3 "http://127.0.0.1:$SCRATCH/api/version" 2>/dev/null || true)"
echo "$ANSWER" | grep -q "\"release\":\"$VER\"" ||
  fail "the candidate does not answer release $VER (got: ${ANSWER:-nothing}) — nothing was swapped"
render_check "$TARGET" "http://127.0.0.1:$SCRATCH/" "the candidate ($VER)" ||
  fail "the CANDIDATE failed its render gate — nothing was swapped; the serving release never moved"
kill_tree "$CANDIDATE_PID"
wait "$CANDIDATE_PID" 2>/dev/null || true
CANDIDATE_PID=""

# --- swap ---
CUR="$(readlink "$HOME_DIR/current" 2>/dev/null || true)"
[ -n "$CUR" ] && ln -sfn "$CUR" "$HOME_DIR/previous"
ln -sfn "releases/$VER" "$HOME_DIR/current"
say "swapped: current -> releases/$VER${CUR:+ (previous -> $CUR)}"

# --- the unit route, the one a restart cannot carry ---
if [ -n "$CUR" ] && ! diff -rq "$HOME_DIR/$CUR/deploy" "$TARGET/deploy" >/dev/null 2>&1; then
  echo "⚠ deploy/ changed between $CUR and $VER — the unit files are COPIES in systemd;"
  echo "  run: (cd $HOME_DIR/current && ./setup.sh) to re-render them. A restart alone cannot."
fi

# --- restart what serves, or say why not ---
if unit_serves_home; then
  restart_and_gate
  echo "✓ $VER is live — /api/version answers it"
elif [ -z "$CUR" ]; then
  echo "✓ $VER is installed at $HOME_DIR/current — FIRST install on this home."
  echo "  To make it serve: (cd $HOME_DIR/current && ./setup.sh)   # units, PATH, start"
  echo "  Cutover from a checkout-serving box is a deliberate act: docs/release.md."
else
  echo "✓ $VER is installed and current — but the unit serves elsewhere, so nothing restarted."
  echo "  This box's operator is not this home's (cutover pending? docs/release.md)."
fi
exit 0
