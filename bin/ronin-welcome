#!/usr/bin/env bash
# ronin-welcome — draw the arrival box again, with whatever address is live NOW.
#
#   ronin-welcome
#
# setup.sh prints the verified address once. This redraws the same compact arrival
# result from current machine state; it reads and changes nothing.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck source=../libexec/ronin-banner.sh
. "$ROOT/libexec/ronin-banner.sh"

RONIN_BACKEND_HOST="$(ronin_bind "$ROOT")"
export RONIN_BACKEND_HOST RONIN_PUBLIC_PORT=4810
PORT="$(ronin_port "$ROOT")"
URL="$(ronin_open_url "$ROOT" "$PORT")"
ronin_banner "$ROOT" "$URL"
