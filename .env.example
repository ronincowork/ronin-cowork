# --- ronin-cowork configuration ---
# Copy to .env and edit. All values are optional; sane defaults below.

# Port to listen on.
PORT=3006

# Bind address. Leave UNSET to auto-bind to the tailnet IP (`tailscale ip -4`),
# which keeps the server reachable only on your tailnet (recommended).
#   127.0.0.1  -> local only (e.g. behind your own reverse proxy)
#   0.0.0.0    -> ALL interfaces. On a public/cloud host this can expose a live
#                 shell to the internet if a firewall port is open. Avoid.
#BIND=100.x.y.z

# Optional HTTP Basic auth gate. Set BOTH to require a username + password.
# Strongly recommended if you ever expose this publicly (e.g. a reverse proxy).
# With ALL auth off, the server REFUSES to start on an address that is neither loopback
# nor your tailnet IP — an open port on a live shell is not a thing to do by accident.
#
# The OWNER'S login is separate and nicer for a browser: `bin/ronin-passwd` sets a
# password, /login takes it, and an HttpOnly cookie carries the session for 30 days.
# Either credential satisfies the gate; Basic stays the right shape for scripts.
#GRID_USER=admin
#GRID_PASS=change-me

# Extra hostnames a BROWSER may open a websocket from, comma-separated.
# You only need this behind a reverse proxy that both (a) is not Tailscale and
# (b) rewrites the Host header — Ronin already accepts its own bind address, the
# loopback names and this machine's tailnet name. A page served from anywhere else
# is refused, because a browser attaches your credentials to a cross-site socket
# without asking. Hostnames only, no scheme, no port.
#RONIN_ALLOWED_ORIGINS=ronin.example.com,10.0.0.5

# tmux window-size policy for browser viewers attached alongside another client:
#   latest   -> the window follows the most-recently-active client (default)
#   largest  -> stays at the largest client's size; small tiles show a viewport
#   smallest -> shrinks to the smallest client (can shrink another client)
#   manual   -> fixed; ignores clients
TMUX_WINDOW_SIZE=latest

# Mouse mode on browser viewer sessions (src/config.ts; docs/env.md).
#   off -> the default since 2026-09-01: a wheel over a locked tile reaches the running
#          app as mouse reports (Claude Code handles it itself).
#   on  -> the wheel drops the SHARED pane into tmux copy-mode, freezing live output for
#          the agent and every other viewer — the trap 'off' retired.
# Keyboard Up/Down always does history regardless of this setting.
TMUX_MOUSE=off

# Where a picker-born session starts when no project root decides it.
# Defaults to your home directory.
#RONIN_NEW_SESSION_DIR=/home/you

# The dictation proxy the browser's mic button talks to.
#SCRIBE_URL=http://127.0.0.1:3004
