{
  "name": "ronin-cowork",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "View and operate your tmux sessions from a browser grid — xterm.js + node-pty + tmux, secure over Tailscale.",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "visual:ui": "node scripts/visual-ui.mjs",
    "stage": "node scripts/stage.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "workbench:ui": "node scripts/workbench-ui.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:kyokai": "node scripts/check-kyokai.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "check:stores": "node scripts/check-stores.mjs",
    "check:catalogs": "tsx scripts/check-catalogs.ts",
    "check:place": "node scripts/check-place.mjs",
    "check:agent-installs": "tsx scripts/check-agent-installs.ts",
    "check:launch-ready": "tsx scripts/check-launch-ready.ts",
    "byoin": "tsx scripts/byoin-user-check.ts",
    "verify": "tsc --noEmit && node scripts/check-tests.mjs",
    "verify:staging": "node scripts/smoke-ui.mjs --staging",
    "check:tips": "node scripts/check-tips.mjs",
    "kokugo:table": "node scripts/kokugo-table.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^7.4.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
