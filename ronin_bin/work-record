#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" work-record "$@"
set -u
SELF="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
export WORK_RECORD_INVOKED="${BASH_SOURCE[0]}"
usage() { cat <<'EOF'
Usage:
  work-record read [--json] [--session <name>]
  work-record update_record --objective <text>
  work-record update_record --on_tangent | --on_track
  work-record update_record --repo <repo-or-url>[:<branch>] | --unrepo <repo-or-url>[:<branch>]
  work-record add_doc [--remove] <path>|<url> [--item <id>]
  work-record workspace list
  work-record workspace add <repo-or-url> [--branch <branch>]
  work-record workspace remove <repo-or-url> [--branch <branch>]
Workspace entries are the repositories this Agent records as current work. The repository
may be a registered handle or a URL. --branch is separate so URLs parse exactly. These
entries do not change the Agent's birth directory or open a managed desk.
Update fields are --objective, --repo, --unrepo, --on_tangent and --on_track. A whole
JSON record is accepted on stdin. read shows the record, the items held and watched, each with
its status, and their documents; each Team you are on in four lines (Workspace, Plans,
Canvases, Epics), each naming the command that reads it whole; a lead's also shows each team
it leads: what the team and each member hold and watch. add_doc adds a document to the item you hold; holding
several, name one with --item; holding none, it goes on your work record itself.
--remove takes one off. read and the tile's Docs list the record's own documents and
every held item's attachments. Work items are the item tool's: item --help.
Related: item --help; session_create --help; team --help
EOF
}
read_impl() { exec bash "$ROOT/libexec/work-record-read" "$@"; }
write_impl() { exec bash "$ROOT/libexec/work-record-write" "$@"; }
list_field() {
  bash "$ROOT/libexec/work-record-read" --json | python3 -c "import json,sys; print(json.dumps(json.load(sys.stdin).get('$1',[]),indent=2))"
}
case "${1:-}" in
  -h|--help) [ "$#" -eq 1 ] || { echo 'Run work-record --help.' >&2; exit 2; }; usage ;;
  read) shift; read_impl "$@" ;;
  add_doc) shift
    doc=''; id=''; remove=''; verb=--doc-add
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --item) [ -n "${2:-}" ] || { echo 'BAD-ARG: --item takes an id' >&2; exit 2; }; id=$2; shift 2 ;;
        --remove) remove=true; verb=--doc-remove; shift ;;
        *) [ -z "$doc" ] && [ -n "$1" ] || { echo 'BAD-ARG: work-record add_doc takes [--remove] <path>|<url> [--item <id>]' >&2; exit 2; }; doc=$1; shift ;;
      esac
    done
    [ -n "$doc" ] || { echo 'BAD-ARG: work-record add_doc takes [--remove] <path>|<url> [--item <id>]' >&2; exit 2; }
    if [ -z "$id" ]; then
      # A document on the record itself comes off the record first, whatever is held now.
      if [ -n "$remove" ]; then
        bash "$ROOT/libexec/work-record-write" --doc-remove "$doc" 2>/dev/null && exit 0
      fi
      held=$(bash "$ROOT/libexec/work-record-read" --json | python3 -c 'import json,sys; print(" ".join(i["id"] for i in json.load(sys.stdin).get("items") or []))') || exit 3
      case "$held" in
        # Holding no item, the document goes on the work record itself (owner, 2026-11-02).
        '') exec bash "$ROOT/libexec/work-record-write" "$verb" "$doc" ;;
        *' '*) echo "BAD-ARG: you hold $held; name one with --item <id>" >&2; exit 2 ;;
      esac
      id=$held
    fi
    exec bash "$ROOT/ronin_bin/item" attach "$id" ${remove:+--remove} "$doc" ;;
  update_record) shift; case "${1:-}" in -h|--help) write_impl --help;; esac; write_impl "$@" ;;
  workspace)
    verb=${2:-}; shift 2 || true
    case "$verb" in
      -h|--help) cat <<'EOF'
Usage:
  work-record workspace list
  work-record workspace add <repo-or-url> [--branch <branch>]
  work-record workspace remove <repo-or-url> [--branch <branch>]
list prints one JSON document: "workspace", your Team's Workspace (title, objective, team,
each repo and folder with its directory; null on no Workspace), and "repos", your own entries. add and remove edit only your own entries.
These edit the repositories in your Work Record. A remove without --branch removes every
row for that exact repository. They do not change the birth directory or open a desk.
To change the live session's recorded Workspace Folder, use session_set --help.
EOF
        ;;
      list) [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        # The Team's Workspace first (KAN-331), then this Agent's own entries: one JSON document,
        # {"workspace": {...} | null, "repos": [...]}, so a caller can parse it.
        bash "$ROOT/libexec/work-record-read" --json | python3 -c '
import json, sys
d = json.load(sys.stdin)
ws = None
for l in d.get("layers") or []:
    w = l.get("workspace")
    if not w: continue
    dirs = w.get("dirs") or {}
    ws = {"name": w["name"], "title": w.get("title") or w["name"], "objective": w.get("objective") or "", "team": l["team"],
          "repos": [{"name": n, "dir": dirs.get(n) or ""} for n in w.get("repos") or []],
          "folders": [{"name": n, "dir": dirs.get(n) or ""} for n in w.get("folders") or []]}
    break
print(json.dumps({"workspace": ws, "repos": d.get("repos", [])}, indent=2, ensure_ascii=False))
' ;;
      add|remove)
        [ "$#" -ge 1 ] && [ -n "$1" ] || { usage >&2; exit 2; }
        repo=$1; shift; branch=''
        if [ "$#" -gt 0 ]; then
          [ "$#" -eq 2 ] && [ "$1" = --branch ] && [ -n "$2" ] || { usage >&2; exit 2; }
          branch=$2
        fi
        if [ "$verb" = add ]; then write_impl --repo-pair "$repo" "$branch"; else write_impl --unrepo-pair "$repo" "$branch"; fi ;;
      *) usage >&2; exit 2 ;;
    esac ;;
  *) usage >&2; exit 2;;
esac
