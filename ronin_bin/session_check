#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" session_check "$@"
# session_check — read one live session by exact name; never creates or changes it.
set -u
case "${1-}" in
  -h|--help) [ "$#" -eq 1 ] || { echo "session_check: --help takes no other arguments. Run session_check --help." >&2; exit 2; }
    cat <<'EOF'
session_check — read one live Agent by exact name

Usage:
  session_check <name>

Reports the Agent's Teams, lead designations, and recorded Workspace Folder handle.
The recorded handle can change; the birth directory does not. Working repositories
are in that Agent's Work Record (`work-record workspace list` in its session).
An unused name returns NO-SESSION and changes nothing. Related:
session_create --help; session_set --help; edges team --help
EOF
    exit 0 ;;
esac
[ "$#" -eq 1 ] && [ -n "${1:-}" ] && [ "${1#-}" = "$1" ] || {
  echo "usage: session_check <name>. Run session_check --help." >&2; exit 2;
}
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
NAME=$1
. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
api() { curl -sS -m 60 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -H 'content-type: application/json' "$@" 2>/dev/null; }

roster=$(api "$url/api/sessions") || { echo "UNREACHABLE: Ronin did not answer at $url" >&2; exit 5; }
live=$(printf '%s' "$roster" | NAME="$NAME" python3 -c '
import json, os, sys
for s in json.load(sys.stdin):
    if s.get("name") == os.environ["NAME"]:
        print(json.dumps(s)); break
' 2>/dev/null || true)
[ -n "$live" ] || { echo "NO-SESSION: no live session named \"$NAME\""; exit 3; }
root=$(api "$url/api/sessions/$NAME/project-root" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("project_root") or "")' 2>/dev/null || true)
printf '%s' "$live" | ROOT="$root" python3 -c '
import json, os, sys
s = json.load(sys.stdin)
print(f"session:      {s['"'"'name'"'"']}")
print(f"teams:        {'"'"', '"'"'.join(s.get('"'"'tags'"'"') or []) or '"'"'— (rōnin)'"'"'}")
print(f"人 of:        {'"'"', '"'"'.join(s.get('"'"'leads'"'"') or []) or '"'"'—'"'"'}")
print(f"workspace-folder-handle: {os.environ['"'"'ROOT'"'"'] or '"'"'—'"'"'}")
'
