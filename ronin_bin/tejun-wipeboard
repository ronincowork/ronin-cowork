#!/usr/bin/env bash
# tejun-wipeboard — a shared text surface a set of sessions can all read and write.
# Usage: tejun-wipeboard                              every wipeboard in play, with member counts
#        tejun-wipeboard <wipeboard>                  the roster (member + dial) and the file path
#        tejun-wipeboard <wipeboard> add <target>…    enrol sessions on a CUSTOM wipeboard + notify them
#        tejun-wipeboard <wipeboard> remove <target>… unenrol + notify
#        tejun-wipeboard <wipeboard> post <text…>     append one watermarked entry + notify the other members
#        tejun-wipeboard <wipeboard> read [n]         the last n posts (default 20)
#
# A <target> is a session (`name` or `@name`) or a whole team (`+team:name`, `+name`).
#
# TWO KINDS (docs/wipeboards.md). A TEAM wipeboard exists because its team does: same
# name, membership READ OFF THE TEAM (@ronin-tags) at every answer — nothing enrolled,
# nothing that can drift, so `add`/`remove` refuse and point at the Roster's tags. A
# CUSTOM wipeboard is enrolled by hand in @ronin-wipeboards, which lives on the session
# and dies with it. Either way the record is a markdown file: no database, no daemon,
# no locking — posts are appended with >> and that IS the concurrency story.
#
# Vendor-neutral by construction: the RECORD is a FILE, and the nudge that says the file
# moved is tmux keystrokes through tejun-send. Nothing here reaches into any agent CLI's
# internals — no plugin, no socket, no vendor API.
set -u

BOARDS_OPT='@ronin-wipeboards'
VIEWER_PREFIX='grid_'   # browser viewer sessions — never a member
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# The wipeboards STORE (user root) — never a hand-spelled path (JUSHO, docs/stores.md).
DIR="$("$HERE/bin/ronin-store" wipeboards)"
SEND="$HERE/ronin_bin/tejun-send"
NAME_RE='^[a-z0-9][a-z0-9_-]*$'

# The owner's watermark. Was `user: glen` — a literal, so every install signed the owner's
# posts with OUR owner's name. JUSHO: nothing shipped names a person. The name arrives on
# the tmux SERVER option @ronin-owner, published by Ronin from the owner's config, for the
# same reason @ronin-session-max does — a Node server and a zero-dependency bash tool can
# both read it without two JSON parsers. No server, or a Ronin that has not published yet:
# this machine's own user, which is the same default the server falls back to.
OWNER_NAME="$(tmux show-option -s -qv @ronin-owner 2>/dev/null || true)"
[ -n "$OWNER_NAME" ] || OWNER_NAME="$(id -un 2>/dev/null || echo owner)"
OWNER="user: $OWNER_NAME"

usage() { echo "usage: tejun-wipeboard [wipeboard [add|remove|post|read] …]" >&2; exit 2; }

# Where the session record lives on THIS machine. Asked, never spelled — the same
# resolver read_tegami and write_tegami use, so a moved store moves all of them together.
STORE_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/ronin-store"
[ -x "$STORE_BIN" ] || STORE_BIN=ronin-store
SESSION_STORE="$("$STORE_BIN" session 2>/dev/null)"

# A session's session_role out of its own letter — empty when it has no letter or has
# not said. It lives in TEGAMI because the session may change it as the work changes.
axes_of() {
  local key row stamped created
  [ -n "${SESSION_STORE:-}" ] || return 0
  row=$(tmux list-sessions -F '#{session_name}	#{@ronin-key}	#{session_created}' 2>/dev/null \
        | awk -F'\t' -v n="$1" '$1==n {print; exit}')
  [ -n "$row" ] || return 0
  stamped=$(printf '%s' "$row" | cut -f2); created=$(printf '%s' "$row" | cut -f3)
  if [ -n "${stamped// /}" ]; then key="$stamped"
  elif [ -n "${created// /}" ]; then key="$1-$created"
  else key="$1"; fi
  python3 - "$SESSION_STORE/$key/tegami.md" <<'PY' 2>/dev/null
import json, re, sys
try:
    t = open(sys.argv[1]).read()
except OSError:
    raise SystemExit
m = re.search(r"```(?:json)?\s*\n(.*?)\n```", t, re.S)
raw = m.group(1) if m else t[t.find("{"):t.rfind("}") + 1]
try:
    d = json.loads(raw)
except Exception:
    raise SystemExit
say = lambda k: d[k].strip() if isinstance(d.get(k), str) else ""
print(say("session_role"))
PY
}

# name·boards·teams·dial·leads·session_role for every real session, viewers dropped.
#
# SEP is \x1f (unit separator), NOT a tab. Tab is an IFS *whitespace* character, so bash
# collapses a RUN of them into one delimiter: a session on no wipeboard emitted as
# `name<TAB><TAB>write` read back with boards="write". \x1f is not whitespace, so an
# empty field stays an empty field. Nothing in a name, wipeboard, team, dial or task
# contains it. TEAMS ride along because membership is the union: a team wipeboard's
# members are read off @ronin-tags, a custom one's off @ronin-wipeboards.
SEP=$'\x1f'
roster() {
  while IFS=$SEP read -r name boards teams dial leads; do
    printf '%s%s%s%s%s%s%s%s%s%s%s\n' "$name" "$SEP" "$boards" "$SEP" "$teams" "$SEP" "$dial" "$SEP" "$leads" "$SEP" \
      "$(axes_of "$name")"
  done < <(tmux list-sessions -F "#{session_name}${SEP}#{${BOARDS_OPT}}${SEP}#{@ronin-tags}${SEP}#{@ronin-control}${SEP}#{@ronin-lead}" 2>/dev/null \
    | grep -v "^${VIEWER_PREFIX}")
}

# Boards a session carries, comma-separated and cleaned.
boards_of() { tmux show-options -t "$1" -qv "$BOARDS_OPT" 2>/dev/null | tr -d '\n'; }

# Is $1 a member of board $2? Exact match, so 'plan' never matches 'planning'.
has_board() { case ",$(boards_of "$1" | tr -d ' ')," in *",$2,"*) return 0 ;; *) return 1 ;; esac; }

# Does a live team bear this name? Then it is a TEAM wipeboard: the team is the
# membership and @ronin-wipeboards is not consulted for it (docs/wipeboards.md).
is_team_board() {
  while IFS=$SEP read -r _ _ teams _; do
    case ",${teams// /}," in *",$1,"*) return 0 ;; esac
  done < <(roster)
  return 1
}

# Join stdin lines into "a, b, c".
commas() { tr '\n' ',' | sed 's/,$//; s/,/, /g'; }

path_of() { printf '%s/%s.md\n' "$DIR" "$1"; }

# The session this tool is running in — the post's author. A tile watching the session
# shares its pane through a grouped viewer, so resolve the pane to its NON-viewer owner
# (the same reason src/tmux.ts:sessionOfPane exists). Empty outside tmux.
whoami_session() {
  [ -n "${TMUX_PANE:-}" ] || return 0
  tmux list-panes -a -F '#{pane_id}	#{session_name}' 2>/dev/null \
    | awk -F'\t' -v p="$TMUX_PANE" '$1 == p { print $2 }' \
    | grep -v "^${VIEWER_PREFIX}" | head -1
}

# Create the file with its Brief stub if this wipeboard has never been written to.
# A team wipeboard's stub says whose it is and how membership works — its first reader
# arrives with no enrolment step behind them. Same text the server writes.
ensure_file() {
  local f; f=$(path_of "$1")
  [ -e "$f" ] && return 0
  mkdir -p "$DIR" || return 1
  if is_team_board "$1"; then
    printf '# wipeboard: %s\n\n## Brief\n\nThe %s team'"'"'s wipeboard — membership follows the team.\n' "$1" "$1" > "$f"
  else
    {
      printf '# wipeboard: %s\n\n' "$1"
      printf '## Brief\n\n'
      printf '_(the owner writes what this wipeboard is for here)_\n'
    } > "$f"
  fi
}

# One watermarked entry. `>>` is the whole concurrency story: O_APPEND writes from
# several agents interleave as whole posts and nothing is lost or overwritten.
append_post() {
  local board="$1" author="$2" text="$3" f
  ensure_file "$board" || { echo "NO-DIR: cannot create $DIR"; return 1; }
  f=$(path_of "$board")
  printf '\n### %s · %s\n%s\n' "$author" "$(date +%H:%M)" "$text" >> "$f"
}

# ---- no args: every wipeboard in play ---------------------------------------------
if [ $# -eq 0 ]; then
  ros=$(roster)
  # Teams first as a fact, not an ordering: each live team IS a wipeboard, file or not,
  # and a team WINS its name — an old enrolment on it is superseded, not double-listed.
  teams=$(printf '%s\n' "$ros" | awk -F'\037' '
    { n = split($3, t, ",")
      for (i = 1; i <= n; i++) { gsub(/^[ \t]+|[ \t]+$/, "", t[i]); if (t[i] != "") c[t[i]]++ } }
    END { for (k in c) printf "%s\t%d\n", k, c[k] }' | sort)
  counts=$(printf '%s\n' "$ros" | awk -F'\037' '
    { n = split($2, b, ",")
      for (i = 1; i <= n; i++) { gsub(/^[ \t]+|[ \t]+$/, "", b[i]); if (b[i] != "") c[b[i]]++ } }
    END { for (k in c) printf "%s\t%d\n", k, c[k] }' | sort)
  # A custom wipeboard with a file but no live members still exists — nobody is on it.
  files=$(ls "$DIR" 2>/dev/null | sed -n 's/\.md$//p' | sort)
  team_names=$(printf '%s\n' "$teams" | cut -f1)
  customs=$(printf '%s\n%s\n' "$(printf '%s\n' "$counts" | cut -f1)" "$files" | grep -v '^$' | sort -u \
    | grep -vxF -f <(printf '%s\n' "$team_names") 2>/dev/null || true)
  [ -n "$team_names$customs" ] || { echo "NO-WIPEBOARDS: none in play yet — a team's exists the moment the team does; 'tejun-wipeboard <name> add <session>' starts a custom one"; exit 3; }
  while IFS=$'\t' read -r b n; do
    [ -n "$b" ] || continue
    printf '%-24s %-7s %s member(s)\n' "$b" team "$n"
  done <<< "$teams"
  while read -r b; do
    [ -n "$b" ] || continue
    n=$(printf '%s\n' "$counts" | awk -F'\t' -v b="$b" '$1 == b { print $2 }')
    printf '%-24s %-7s %s member(s)\n' "$b" custom "${n:-0}"
  done <<< "$customs"
  exit 0
fi

BOARD=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]'); shift
[[ "$BOARD" =~ $NAME_RE ]] && [ ${#BOARD} -le 32 ] \
  || { echo "BAD-NAME: '$BOARD' — lowercase letters, digits, - and _ only (max 32)"; exit 2; }

# Members of $BOARD, one 'name<TAB>dial<TAB>session_role' per line, the LEADS first.
# On a shared surface the other agents need to know which voice is coordinating them —
# and that is the 人 again (@ronin-lead), BACK by R35 (2026-08-23): a hand-set per-team
# designation, never derived from what a session is doing, read fresh on every call.
# The session_role is what is printed beside each name, because "what is each of these
# doing?" is the question a shared wipeboard asks. Names, not icons: this is a readout
# for agents, and a word beats an emoji when the reader is parsing lines. '-' where
# nobody has said.
members() {
  # The union view, decided once: a team wipeboard's members are the team's sessions
  # (field 3), a custom one's are the enrolled (field 2). Same question, one answer.
  local mode=custom
  is_team_board "$BOARD" && mode=team
  on_board() {
    if [ "$mode" = team ]; then case ",${2// /}," in *",${BOARD},"*) return 0 ;; *) return 1 ;; esac
    else case ",${1// /}," in *",${BOARD},"*) return 0 ;; *) return 1 ;; esac; fi
  }
  leads_board() { case ",${1// /}," in *",${BOARD},"*) return 0 ;; *) return 1 ;; esac; }
  while IFS=$SEP read -r name boards teams dial leads task; do
    on_board "$boards" "$teams" || continue
    leads_board "${leads:-}" && printf '%s\t%s\t%s\n' "$name" "${dial:-write}" "${task:--}"
  done < <(roster)
  while IFS=$SEP read -r name boards teams dial leads task; do
    on_board "$boards" "$teams" || continue
    leads_board "${leads:-}" || printf '%s\t%s\t%s\n' "$name" "${dial:-write}" "${task:--}"
  done < <(roster)
}

# Expand one target into session names: '+t' / '+team:t' = a whole team. The retired
# spellings '+tag:t' / '+group:t' are still read — input only, never taught.
expand_target() {
  local t="$1"
  case "$t" in
    +*)
      local g="${t#+}"; g="${g#team:}"; g="${g#tag:}"; g="${g#group:}"; g=$(printf '%s' "$g" | tr '[:upper:]' '[:lower:]')
      local found=0
      while IFS=$'\t' read -r name tags _; do
        case ",${tags// /}," in *",${g},"*) printf '%s\n' "$name"; found=1 ;; esac
      done < <(tmux list-sessions -F '#{session_name}	#{@ronin-tags}	x' 2>/dev/null | grep -v "^${VIEWER_PREFIX}")
      [ "$found" = 1 ] || echo "NO-TEAM:$g" >&2
      ;;
    *) printf '%s\n' "${t#@}" ;;
  esac
}

case "${1:-}" in
  # ---- roster ---------------------------------------------------------------------
  '')
    # No ensure_file on a team wipeboard: file-existence is what arms the tag-change
    # notices (docs/wipeboards.md), and a QUESTION must not start the conversation.
    is_team_board "$BOARD" || ensure_file "$BOARD" >/dev/null 2>&1
    rows=$(members)
    printf 'file: %s\n' "$(path_of "$BOARD")"
    if [ -z "$rows" ]; then
      echo "members: none — nobody is on '$BOARD' yet"
    else
      printf '%s\n' "$rows" | while IFS=$'\t' read -r n d j; do printf '%-24s %-8s %s\n' "$n" "$d" "$j"; done
    fi
    exit 0
    ;;

  # ---- add / remove — CUSTOM wipeboards only --------------------------------------
  add|remove)
    verb="$1"; shift
    [ $# -ge 1 ] || usage
    # A team wipeboard has no enrolment to edit: membership IS the team, and the way
    # onto it is the way onto the team. Refusing here is the answer, not a failure.
    if is_team_board "$BOARD"; then
      echo "TEAM-WIPEBOARD: '$BOARD' membership is the team's — the owner tags sessions in the Ronin UI (⌂ Roster, or the tile's 🏷)"
      exit 2
    fi
    ensure_file "$BOARD" || { echo "NO-DIR: cannot create $DIR"; exit 1; }
    targets=$(for t in "$@"; do expand_target "$t"; done | awk 'NF && !seen[$0]++')
    [ -n "$targets" ] || { echo "NO-TARGETS: nothing matched — 'tejun-team' lists the teams that exist"; exit 3; }
    past=$([ "$verb" = add ] && echo added || echo removed)
    # Who is doing the enrolling. Membership is the owner's hand by design, but the
    # tool can be run from a pane — say which it was rather than assume.
    actor=$(whoami_session); actor=${actor:+@$actor}; actor=${actor:-$OWNER}
    rc=0
    while read -r s; do
      if ! tmux has-session -t "=$s" 2>/dev/null; then
        echo "NO-SESSION: '$s' does not exist"; rc=3; continue
      fi
      cur=$(boards_of "$s" | tr -d ' ')
      if [ "$verb" = add ]; then
        if has_board "$s" "$BOARD"; then echo "ALREADY: '$s' is on '$BOARD'"; continue; fi
        new=$(printf '%s,%s' "$cur" "$BOARD" | sed 's/^,//')
      else
        if ! has_board "$s" "$BOARD"; then echo "NOT-MEMBER: '$s' is not on '$BOARD'"; continue; fi
        new=$(printf '%s' "$cur" | tr ',' '\n' | grep -vx "$BOARD" | paste -sd, -)
      fi
      if [ -n "$new" ]; then
        tmux set-option -t "$s" "$BOARDS_OPT" "$new"
      else
        tmux set-option -t "$s" -u "$BOARDS_OPT" 2>/dev/null
      fi
      # The board hears about every roster change, so a member who was already
      # reading learns who joined without anyone being messaged twice.
      append_post "$BOARD" 'system' "$actor $past @$s"
      # …and the affected session is told directly. tejun-send enforces the dial, so a
      # 👤/👁 session is tagged but never typed into — that refusal is the correct
      # outcome, not a failure of the add. Never flip a dial to get past it.
      if [ "$verb" = add ]; then
        roll=$(members | cut -f1 | commas)
        msg="You've been added to wipeboard \"$BOARD\" — $(path_of "$BOARD"). Read it, and append your own posts as \"### @<your session> · HH:MM\" (>> append, never rewrite another agent's post, never edit the Brief). Members: ${roll:-none}."
      else
        msg="You've been removed from wipeboard \"$BOARD\" — stop posting to $(path_of "$BOARD")."
      fi
      verdict=$("$SEND" "$s" "$msg" 2>&1)
      case "$verdict" in
        DELIVERED*) printf '%-24s %s, notified\n' "$s" "$past" ;;
        *)          printf '%-24s %s, NOT notified — %s\n' "$s" "$past" "$verdict" ;;
      esac
    done <<< "$targets"
    exit $rc
    ;;

  # ---- post -----------------------------------------------------------------------
  post)
    shift
    [ $# -ge 1 ] || usage
    who=$(whoami_session)
    author=${who:+@$who}

    # THE APPEND IS THE POST. It happens first, alone, and its exit decides this command:
    # a post that reached the file is a post, even if every notification afterwards fails.
    # (Before 2026-08-21 that was the whole command, and it is why the owner said posts
    # "go unheard" — the file moved and nobody was told.)
    append_post "$BOARD" "${author:-shell}" "$*" || exit 1
    echo "POSTED to '$BOARD' as ${author:-shell}."

    # …and now the board hears about it. A POINTER, never a copy: the file stays the
    # record, so the notice names the board and the poster and sends the reader to read.
    # Copying the text into six panes would fork the thread into seven versions of itself.
    #
    # The roster comes from live tmux (membership is a session option, so it dies with the
    # session) — a member that no longer exists is simply not in this list, and there is no
    # stale roster to prune. tejun-send re-checks has-session anyway for the race.
    #
    # Never the poster: an agent that has just written does not need to be told it wrote.
    # (Empty `me` — run from a plain shell rather than a session — excludes nobody.)
    others=$(members | awk -F'\t' -v me="${who:-}" '$1 != me')
    if [ -z "$others" ]; then
      # Alone on the board, or on a board nobody is enrolled on. Silence is correct: there
      # is no one to tell, and an empty roster is not an error — boards are often written
      # to before the owner enrols anyone.
      echo "notify: nobody else is on '$BOARD' — post recorded, no one to tell."
      exit 0
    fi

    # The mandated control-check, from the roster we already hold: 👤/👁 sessions are on the
    # board and may READ it, but nothing types into them. Skipping them here is not a
    # shortcut past tejun-send — it also refuses, and stays the enforcement. Never flip a
    # dial to get a notification through; a skipped member is a correct outcome to report.
    #
    # The notice SAYS WHO IT IS FROM. Text that lands at an agent's prompt with no
    # watermark reads as the owner typing, and an agent acts on the owner's word — so the
    # line names the poster and says out loud that the wipeboard sent it, not a person.
    msg="WIPEBOARD \"$BOARD\" — ${author:-shell} posted (automatic notice from the wipeboard, not the owner). Read it: tejun-wipeboard $BOARD read"
    while IFS=$'\t' read -r s dial _; do
      case "$dial" in
        user) printf '%-24s not notified — dial 👤 (user-controlled); it can read the wipeboard itself\n' "$s"; continue ;;
        read) printf '%-24s not notified — dial 👁 (watch-only); it can read the wipeboard itself\n' "$s"; continue ;;
      esac
      # One call, one verdict, no loop. tejun-send already retries its own Enter once; a
      # notification that will not land is REPORTED and left alone — re-sending into a
      # session that is mid-dialog is how a pane gets spammed, and the post is safe in the
      # file regardless.
      #
      # The EXIT CODE decides, not the text: tejun-send's contract is "exit 0 = delivered",
      # and anything tmux itself mutters on stderr lands in front of the verdict line and
      # would make a prefix match on DELIVERED read a delivered message as a failure.
      verdict=$("$SEND" "$s" "$msg" 2>&1); rc=$?
      if [ $rc -eq 0 ]; then
        printf '%-24s notified\n' "$s"
      else
        printf '%-24s NOT notified — %s\n' "$s" "${verdict##*$'\n'}"
      fi
    done <<< "$others"
    # Exit 0 even when notifications failed: the caller asked to post, and it posted. A
    # non-zero here would teach macros to retry the POST, which would double the entry in
    # the file — the exact loss the append-only rule exists to prevent.
    exit 0
    ;;

  # ---- read -----------------------------------------------------------------------
  read)
    shift
    n=${1:-20}
    f=$(path_of "$BOARD")
    if [ ! -e "$f" ]; then
      # A team wipeboard is real before its file is — it exists because the team does,
      # and the file appears with the first post. Not an error, an empty thread.
      if is_team_board "$BOARD"; then
        echo "EMPTY: the '$BOARD' team's wipeboard has no posts yet — 'tejun-wipeboard $BOARD post <text>' starts the thread ($f)"
        exit 0
      fi
      echo "NO-WIPEBOARD: '$BOARD' has never been written to ($f)"; exit 3
    fi
    # Everything down to the last n post headers — the Brief always comes with it, since
    # a thread read without the brief is a conversation with no subject.
    awk -v n="$n" '
      /^### / { k++ }
      { line[NR] = $0; hdr[k] = (hdr[k] ? hdr[k] : NR) }
      END {
        start = (k > n) ? hdr[k - n + 1] : 1
        for (i = 1; i < start && line[i] !~ /^### /; i++) print line[i]
        if (start > 1) print "…"
        for (i = start; i <= NR; i++) print line[i]
      }' "$f"
    exit 0
    ;;

  *) usage ;;
esac
