#!/usr/bin/env bash
# tejun-wipeboard — THE ONE ACTION: what you have not read, on every wipeboard you are on.
#
# Usage: tejun-wipeboard                              everything unread, then it is read
#        tejun-wipeboard boards                       which wipeboards exist
#        tejun-wipeboard <wipeboard>                  the brief + what it still holds
#        tejun-wipeboard <wipeboard> read [n]         the last n, explicitly
#        tejun-wipeboard <wipeboard> find <text…>     search what it still holds
#        tejun-wipeboard <wipeboard> post [--to a,b|none] [--session s] <text…>
#        tejun-wipeboard --session <s> …             who is typing, when $TMUX is unset
#
# A WIPEBOARD IS A TRANSPORT, NOT A RECORD (owner, 2026-08-23). Posts are delivered and
# then reaped — when every reader they were for has read them, or when they age out. It
# is not history: RIREKI's tape holds what your tile printed, and a decision worth
# keeping belongs in your TEGAMI or a docs/ page.
#
# YOU NEVER MANAGE IDS, TIMESTAMPS, CURSORS, PAGES OR FILES. The bare form knows which
# session it is running in and what it has already seen. Run it; that is the whole job.
#
# --to decides who gets INTERRUPTED, not who can read: everyone on the wipeboard still
# receives the post on their next check. Address it to whoever has to act on it; leave it
# open only when everyone has to.
#
# src/wipeboard-cli.ts calls the operator HTTP surface and prints its reply.
set -u
# RESOLVE PAST THE PROJECTED SYMLINK. A session's tools arrive as symlinks in the
# session-commands store (src/routine-tools.ts); BASH_SOURCE is the link, not this file,
# and ../ from the link is a store with no src/ or bin/ — measured 2026-09-02 (desk audit):
# resolve the shipped tool rather than the projection directory.
SELF=${BASH_SOURCE[0]}
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
HERE=$(cd "$(dirname "$SELF")/.." && pwd)
cd "$HERE" || { echo "NO-REPO: cannot reach the Ronin tree"; exit 1; }
exec npx tsx src/wipeboard-cli.ts "$@"
