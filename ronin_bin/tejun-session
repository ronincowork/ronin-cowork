#!/usr/bin/env bash
# tejun-session — raise a session onto your team, in one line.
#
# Usage: tejun-session <name> [--prompt <text>] [--role <session_role>] [--team <team>]
#                             [--lead] [--root <project_root>] [--mode manual|assisted]
#                             [--cmd <cli>] [--mcp on|off] [--tags a,b] [--seed p1,p2]
#
# ONLY THE NAME IS REQUIRED. Everything else falls through the same ladder a ＋ New
# launch uses (system < team_roster < session_role < what you name here) — this is that
# launch, through a second door (`POST /api/session`, src/routes/launch.ts).
#
# THE TEAM IS YOURS UNLESS YOU SAY OTHERWISE (owner, 2026-08-26). Nearly every call is
# a session growing its own team, so with no --team the newborn joins the FIRST team
# you are on; on no team, it is born a rōnin. Neither is a refusal — nothing here asks
# you to go and create a team first, and a session that lands in the rōnin column can
# be dragged onto a team from the page. `--team <t>` names a different one; `--lead`
# makes the newborn the 人 of whichever team it resolved to.
#
# An agent session needs a --prompt (it is the agent's first message). A name with
# nothing else is a bare shell.
#
# Verdicts: BORN <name> on <team> · BORN <name> (rōnin) · REFUSED: <why> · UNREACHABLE.
# Exit 0 born, 2 bad arguments, 4 refused (name taken, unknown role, box full…),
# 5 Ronin unreachable.
set -u
die() { printf '%s\n' "$*" >&2; exit "${2:-4}"; }
# WHICH SESSION AM I — asked of tmux, never guessed (the same resolver every tejun uses).
me() {
  local win s sid
  if [ -n "${TMUX_PANE:-}" ]; then
    win=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null) || win=""
    if [ -n "$win" ]; then
      s=$(tmux list-windows -a -F '#{session_name}	#{window_id}' 2>/dev/null \
          | awk -F'	' -v w="$win" '$2==w && $1 !~ /^grid_/ {print $1; exit}')
      [ -n "$s" ] && { printf '%s\n' "$s"; return 0; }
    fi
  fi
  if [ -n "${TMUX:-}" ]; then
    sid=${TMUX##*,}
    s=$(tmux list-sessions -F '#{session_id}	#{session_name}' 2>/dev/null \
        | awk -F'	' -v i="\$$sid" '$1==i && $2 !~ /^grid_/ {print $2; exit}')
    [ -n "$s" ] && { printf '%s\n' "$s"; return 0; }
  fi
  return 1
}

NAME="${1:-}"
[ -n "$NAME" ] && [ "${NAME#-}" = "$NAME" ] || die "usage: tejun-session <name> [--prompt <text>] [--role <session_role>] [--team <team>] [--lead] …" 2
shift
PROMPT="" ROLE="" TEAM="" LEAD="" ROOT="" MODE="" CMD="" MCP="" TAGS="" SEED=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt) PROMPT="${2:-}"; shift 2 ;;
    --role|--session_role) ROLE="${2:-}"; shift 2 ;;
    --team) TEAM="${2:-}"; shift 2 ;;
    --lead) LEAD=1; shift ;;
    --root|--project_root) ROOT="${2:-}"; shift 2 ;;
    --mode) MODE="${2:-}"; shift 2 ;;
    --cmd) CMD="${2:-}"; shift 2 ;;
    --mcp) MCP="${2:-}"; shift 2 ;;
    --tags) TAGS="${2:-}"; shift 2 ;;
    --seed) SEED="${2:-}"; shift 2 ;;
    *) die "BAD-ARG: $1" 2 ;;
  esac
done
ME=$(me 2>/dev/null || true)

url="${RONIN_URL:-$(tmux show-option -s -qv @ronin-url 2>/dev/null || true)}"
[ -n "$url" ] || url="http://127.0.0.1:3006"
AUTH=()
[ -n "${RONIN_AUTH:-}" ] && AUTH=(-u "$RONIN_AUTH")

# The body — only what was named, so the ladder fills the rest. Python for the JSON:
# a prompt is prose, and prose is exactly what a hand-rolled quote gets wrong.
body=$(NAME="$NAME" ME="$ME" PROMPT="$PROMPT" ROLE="$ROLE" TEAM="$TEAM" LEAD="$LEAD" ROOT="$ROOT" \
       MODE="$MODE" CMD="$CMD" MCP="$MCP" TAGS="$TAGS" SEED="$SEED" python3 - <<'PY'
import json, os
e = os.environ
b = {"name": e["NAME"]}
if e["ME"]: b["caller"] = e["ME"]
for k, v in (("prompt", "PROMPT"), ("session_role", "ROLE"), ("team", "TEAM"),
             ("project_root", "ROOT"), ("mode", "MODE"), ("cmd", "CMD")):
    if e[v]: b[k] = e[v]
if e["LEAD"]: b["team_lead"] = True
if e["MCP"]: b["mcp"] = e["MCP"].lower() in ("on", "true", "1", "yes")
for k, v in (("tags", "TAGS"), ("seed", "SEED")):
    if e[v]: b[k] = [t.strip() for t in e[v].split(",") if t.strip()]
print(json.dumps(b))
PY
) || die "BAD-ARG: could not build the request" 2

out=/tmp/tejun-session.$$
code=$(curl -sS -m 60 "${AUTH[@]+"${AUTH[@]}"}" -o "$out" -w '%{http_code}' \
       -H 'content-type: application/json' -X POST --data "$body" "$url/api/session" 2>/dev/null) \
  || { rm -f "$out"; die "UNREACHABLE: Ronin did not answer at $url" 5; }
python3 - "$code" "$out" <<'PY'
import json, sys
code, path = int(sys.argv[1]), sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
if code == 200 and d.get("ok"):
    r = d.get("receipt") or {}
    team = r.get("team") or ""
    how = d.get("team_from", "none")
    tail = f"on {team}" + (" (your team)" if how == "caller" else "") if team else "(rōnin)"
    if r.get("team_lead"): tail += " as 人"
    print(f"BORN {d.get('name')} {tail}")
    sys.exit(0)
print(f"REFUSED: {d.get('error') or f'HTTP {code}'}", file=sys.stderr)
sys.exit(4)
PY
rc=$?
rm -f "$out"
exit $rc
