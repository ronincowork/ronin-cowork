#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" secret "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
die() { echo "$1" >&2; exit "${2:-2}"; }
usage() { cat <<'EOF_USAGE'
Usage:
  secret ask <name> [--for "<what it is>"]   opens a paste field on your tile for the owner; waits; answers saved: <name> or cancelled: <name>
  secret path <name>                    the file holding it: how you use it (--password-file <path>, or read it in your own script)
  secret ls                             the names saved, each with its expiry date when it has one; never a value
  secret expires <name> <YYYY-MM-DD|none>   set or clear a saved secret's expiry date; the value is not touched
A name is a-z, 0-9, _ and -. Each secret is one file in ~/ronin/services_secrets, readable only by
this machine's user (0600). The tool never prints a value, and a value never goes on a command line: pass the
file's path, never its contents, and never echo it into a reply or a log. The owner can give an
expiry date in the paste field beside the value; it is kept beside the value file, never in it.
EOF_USAGE
}
case "${1:-}" in -h|--help|'') usage; [ "$#" -eq 1 ]; exit $?;; esac
NAME_RE='^[a-z0-9_-]+$'
name_ok() { [[ "$1" =~ $NAME_RE ]] || die "BAD-ARG: \"$1\" is not a secret name: use a-z, 0-9, _ and -."; }
. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
# One call, printing the reply's field $3 (a list one per line). A POST's body comes on stdin, so
# no value is ever an argument.
call() {
  local method=$1 path=$2 field=$3 out body=()
  [ "$method" = GET ] || body=(-X "$method" -H 'content-type: application/json' --data-binary @-)
  out=$(curl -sS "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" "${body[@]}" -w '\n%{http_code}' "$url$path") \
    || { echo "UNREACHABLE: Ronin did not answer at $url" >&2; return 5; }
  printf '%s' "${out%$'\n'*}" | python3 -c '
import json, sys
try: d = json.loads(sys.stdin.read())
except Exception: sys.exit("Ronin answered without JSON")
if d.get("error"): sys.exit(d["error"])
if sys.argv[1] == "names_expires":
    ex = d.get("expires") or {}
    print("\n".join(f"{n}  expires {ex[n]}" if ex.get(n) else n for n in d.get("names", [])))
    sys.exit()
v = d.get(sys.argv[1], "")
print("\n".join(v) if isinstance(v, list) else v)' "$field"
}
case "$1" in
  ls)
    [ "$#" -eq 1 ] || die 'Usage: secret ls'
    call GET /api/secrets names_expires ;;
  expires)
    [ "$#" -eq 3 ] || die 'Usage: secret expires <name> <YYYY-MM-DD|none>'; name_ok "$2"
    day=$(python3 -c 'import json,sys; print(json.dumps({"expires": "" if sys.argv[1] == "none" else sys.argv[1]}))' "$3" \
      | call POST "/api/secrets/$2/expires" expires) || exit $?
    if [ -n "$day" ]; then printf '%s expires %s\n' "$2" "$day"; else printf '%s has no expiry\n' "$2"; fi ;;
  path)
    [ "$#" -eq 2 ] || die 'Usage: secret path <name>'; name_ok "$2"
    dir=$(call GET /api/secrets dir) || exit $?
    [ -f "$dir/$2" ] || die "No secret $2 yet: ask the owner for it with secret ask $2." 4
    printf '%s\n' "$dir/$2" ;;
  ask)
    [ "$#" -ge 2 ] || die 'Usage: secret ask <name> [--for "<what it is>"]'; name=$2; shift 2; name_ok "$name"
    what=''
    while [ "$#" -gt 0 ]; do case "$1" in --for) [ -n "${2:-}" ] || die 'BAD-ARG: --for needs a value'; what=$2; shift 2 ;; *) die "BAD-ARG: secret ask takes --for, not $1" ;; esac; done
    me=$(ronin_session_me 2>/dev/null) || die 'secret ask is for an Agent: run it from the Agent'"'"'s own session.' 4
    answer=$(python3 -c 'import json,sys; print(json.dumps({"session": sys.argv[1], "name": sys.argv[2], "for": sys.argv[3]}))' "$me" "$name" "$what" \
      | call POST /api/secrets/ask answer) || exit $?
    printf '%s: %s\n' "$answer" "$name" ;;
  *) die "BAD-ARG: secret takes ask, path, ls or expires, not $1. Run secret --help." ;;
esac
