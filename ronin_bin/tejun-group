#!/usr/bin/env bash
# tejun-group — THE RETIRED NAME, kept as a door. `group` left the house vocabulary
# (KOTOBA § R32, 2026-08-22): a roster-scoped set of collaborating sessions is a TEAM,
# and the tool is `tejun-team`. This forwards whole, so an agent's old habit still
# answers — speaking the new word. Not in TOOLS.md on purpose: the catalog teaches the
# name that exists, and this file exists to be unneeded.
# RESOLVE PAST THE PROJECTED SYMLINK. A session's tools arrive as symlinks in the
# session-commands store (src/routine-tools.ts); BASH_SOURCE is the link, not this file,
# and ../ from the link is a store with no src/ or bin/ — measured 2026-09-02 (desk audit):
# resolve the shipped tool rather than the projection directory.
SELF=${BASH_SOURCE[0]}
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
exec "$(dirname "$SELF")/tejun-team" "$@"
