#!/usr/bin/env bash
# ronin-desk-settle — reconcile unrecorded managed residue, never checkout Git.
# Usage: ronin-desk-settle --dry-run | --yes
set -u
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
HERE=$(cd "$(dirname "$SELF")/.." && pwd)
cd "$HERE" || { echo "NO-REPO: cannot reach the Ronin tree"; exit 1; }
exec npx tsx src/commands/settle.ts "$@"
