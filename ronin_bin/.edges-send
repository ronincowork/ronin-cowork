#!/usr/bin/env bash
# edges send — put one inbound session message through the durable delivery queue.
# Usage: edges send <session> <message...>
# The operator's message verb (/api/cli/message) queues it; ronin-http.sh carries the call.
set -euo pipefail
[ $# -ge 2 ] || { echo "usage: edges send <session> <message...>" >&2; exit 2; }
TOOL_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
. "$TOOL_DIR/ronin-http.sh"
ronin_cli_run message tell "$@"
