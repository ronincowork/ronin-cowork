#!/usr/bin/env bash
# machine-settings — the typed, secret-free Agent door onto Machine Settings.
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")

die() { printf '%s\n' "$1" >&2; exit "${2:-4}"; }
need() { [ "$#" -ge 2 ] && [ -n "$2" ] && [ "${2#-}" = "$2" ] || die "BAD-ARG: $1 requires a value. Run machine-settings --help." 2; }

help() {
  cat <<'EOF'
machine-settings — read or change typed Machine and Campaign settings

Usage:
  machine-settings read [--campaign <id>]
  machine-settings campaign read [--campaign <id>]
  machine-settings campaign write title|description <value> [--campaign <id>]
  machine-settings campaign archive [--campaign <id>]
  machine-settings installations read [--campaign <id>]
  machine-settings installations write <name> on|off [--campaign <id>]
  machine-settings defaults read [--campaign <id>]
  machine-settings defaults write <field> <value> [--campaign <id>]
  machine-settings project-root list [--campaign <id>] [--all]
  machine-settings project-root read <workspace-folder-handle> [--campaign <id>]
  machine-settings project-root create <workspace-folder-handle> --title <title> --dir <path> [field flags]
  machine-settings project-root write <workspace-folder-handle> <field> <value>
  machine-settings project-root archive <workspace-folder-handle>
  machine-settings project-root exclude <workspace-folder-handle>
  machine-settings provider read [--campaign <id>]
  machine-settings provider write-default <provider> <model>
  machine-settings provider write-preferred <provider> <model>
  machine-settings machine read
  machine-settings machine write name|where|monitor <value>
  machine-settings owner read | machine-settings owner write name <value>
  machine-settings session-defaults read
  machine-settings session-defaults write max|desk-profile|mika-level <value>
  machine-settings messages read | machine-settings messages write auto-force-after-s <seconds>
  machine-settings requirements read | machine-settings requirements write <wanted-json-array>

Without --campaign, Campaign operations resolve RONIN_SESSION by exact live-session name
and refuse when it has no Campaign. Writes use only the existing typed Campaign, Machine
Settings, activation, or Workspace Folder routes; observed/status/needed facts are read-only.
Bare read keeps catalogued, observed, Campaign-on, and new-Team-default states separate.
Provider reads dynamically use the canonical Campaign/provider model catalog shared with
the UI dropdowns; no model list is maintained by this command or its capability document.
Run `machine-settings <operation> --help` for the accepted fields and examples.
EOF
}

case "${1:-}" in -h|--help|'') help; exit 0;; esac

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
api() {
  local method=$1 path=$2 body=${3-} out
  if [ -n "$body" ]; then
    out=$(curl -sS -m 60 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -H 'content-type: application/json' -X "$method" --data "$body" "$url$path") \
      || die "UNREACHABLE: Ronin did not answer at $url" 5
  else
    out=$(curl -sS -m 60 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -H 'content-type: application/json' -X "$method" "$url$path") \
      || die "UNREACHABLE: Ronin did not answer at $url" 5
  fi
  printf '%s' "$out" | ROUTE="$path" python3 -c 'import json,os,sys
s=sys.stdin.read()
route=os.environ["ROUTE"]
try: v=json.loads(s)
except Exception: print(f"Request to {route} returned a non-JSON answer. Run machine-settings --help for usage.", file=sys.stderr); raise SystemExit(4)
if isinstance(v,dict) and v.get("error"):
 error=v["error"]
 print(f"Request to {route} failed: {error} Run machine-settings --help for usage.", file=sys.stderr); raise SystemExit(4)
print(s,end="")' || exit $?
}

CAMPAIGN=''
take_campaign() {
  local -a rest=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --campaign) need "$@"; CAMPAIGN=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  REMAINING=("${rest[@]}")
}

resolve_campaign() {
  if [ -z "$CAMPAIGN" ]; then
    [ -n "${RONIN_SESSION:-}" ] || die 'NO-CAMPAIGN: say --campaign <id>; this process has no RONIN_SESSION to inherit' 3
    local sessions
    sessions=$(api GET '/api/sessions')
    CAMPAIGN=$(printf '%s' "$sessions" | RONIN_SESSION="$RONIN_SESSION" python3 -c 'import json,os,sys
rows=[x for x in json.load(sys.stdin) if x.get("name")==os.environ["RONIN_SESSION"]]
if len(rows)!=1: raise SystemExit(3)
print(rows[0].get("campaign_id") or "")') || die "NO-CAMPAIGN: no exact live session named '$RONIN_SESSION'" 3
    [ -n "$CAMPAIGN" ] || die "NO-CAMPAIGN: session '$RONIN_SESSION' has no Campaign" 3
  fi
  case "$CAMPAIGN" in *[!a-z0-9_-]*|'') die "BAD-ARG: invalid Campaign id '$CAMPAIGN'" 2;; esac
}

campaign_json() { resolve_campaign; api GET "/api/campaigns/$CAMPAIGN"; }
json_body() { python3 -c "$1" "${@:2}"; }
pretty() {
  local input
  input=$(cat)
  [ -n "$input" ] || return 0
  printf '%s' "$input" | python3 -m json.tool
}

COMMAND=$1; shift
case "$COMMAND" in
  read)
    take_campaign "$@"; [ "${#REMAINING[@]}" -eq 0 ] || die 'BAD-ARG: read accepts only --campaign <id>.' 2
    resolve_campaign
    campaign=$(api GET "/api/campaigns/$CAMPAIGN")
    settings=$(api GET '/api/machine-settings')
    catalog=$(api GET '/api/installations')
    installed=$(api GET '/api/installed')
    providers=$(api GET '/api/provider-catalog')
    roots=$(api GET "/api/project-roots/detail?campaign_id=$CAMPAIGN")
    CAMPAIGN_JSON="$campaign" SETTINGS_JSON="$settings" CATALOG_JSON="$catalog" INSTALLED_JSON="$installed" PROVIDERS_JSON="$providers" ROOTS_JSON="$roots" python3 - <<'PY'
import json,os
c=json.loads(os.environ['CAMPAIGN_JSON']); ms=json.loads(os.environ['SETTINGS_JSON'])
catalog=json.loads(os.environ['CATALOG_JSON']); observed=json.loads(os.environ['INSTALLED_JSON'])
defaults=c.get('config',{}).get('defaults',{}); chosen=set(defaults.get('behaviours') or [])
switches=c.get('config',{}).get('installations',{}); services=observed.get('services',{})
rows=[]
for item in catalog:
    name=item.get('name',''); provides=item.get('provides') or []
    fact={'state':'unknown'}
    if name=='ronin_services':
        fact={'state':'installed' if services.get('installed') else 'not-installed',
              'activated':bool(services.get('activated')), 'stage':services.get('stage'),
              'loaded':services.get('loaded') or [], 'parked':services.get('parked') or [],
              'restart_needed':bool(services.get('restart_needed'))}
    rows.append({'name':name,'label':item.get('label',name),'catalogued':True,
                 'observed':fact,'campaign_on':switches.get(name) is True,
                 'default_selected':bool(set(provides)&chosen),'provides':provides,
                 'requires':item.get('requires') or []})
print(json.dumps({'campaign':{k:c.get(k) for k in ('id','title','description','state')},
 'installations':rows,'defaults':defaults,'machine_settings':{
   'set':ms.get('set',{}),'observed':ms.get('observed',{}),'status':ms.get('status',{}),'needed':ms.get('needed',[])},
 'providers':{'catalog':json.loads(os.environ['PROVIDERS_JSON']),'observed':c.get('providers')},
 'project_roots':json.loads(os.environ['ROOTS_JSON']).get('roots',[])},indent=2))
PY
    ;;
  campaign)
    sub=${1:-}; shift || true
    case "$sub" in
      -h|--help|'') echo 'Usage: machine-settings campaign read|archive [--campaign <id>]; machine-settings campaign write title|description <value> [--campaign <id>]';;
      read) take_campaign "$@"; [ "${#REMAINING[@]}" -eq 0 ] || die 'BAD-ARG: campaign read accepts only --campaign.' 2; resolve_campaign; api GET "/api/campaigns/$CAMPAIGN" | pretty;;
      archive) take_campaign "$@"; [ "${#REMAINING[@]}" -eq 0 ] || die 'BAD-ARG: campaign archive accepts only --campaign.' 2; resolve_campaign; api POST "/api/campaigns/$CAMPAIGN/archive" '{}' | pretty;;
      write) field=${1:-}; value=${2-}; [ "$#" -ge 2 ] || die 'BAD-ARG: campaign write needs field and value.' 2; shift 2; take_campaign "$@"; [ "${#REMAINING[@]}" -eq 0 ] || die 'BAD-ARG: unexpected campaign write argument.' 2; case "$field" in title|description) ;; *) die 'BAD-ARG: Campaign field is title or description.' 2;; esac; resolve_campaign; body=$(json_body 'import json,sys; print(json.dumps({sys.argv[1]:sys.argv[2]}))' "$field" "$value"); api PUT "/api/campaigns/$CAMPAIGN" "$body" | pretty;;
      *) die "BAD-ARG: unknown campaign operation '$sub'." 2;; esac
    ;;
  installations)
    sub=${1:-}; shift || true
    case "$sub" in
      -h|--help|'') echo 'Usage: machine-settings installations read [--campaign <id>]; machine-settings installations write <name> on|off [--campaign <id>]';;
      read) take_campaign "$@"; [ "${#REMAINING[@]}" -eq 0 ] || die 'BAD-ARG: installations read accepts only --campaign.' 2; resolve_campaign; c=$(api GET "/api/campaigns/$CAMPAIGN"); a=$(api GET '/api/installations'); i=$(api GET '/api/installed'); CAMPAIGN_JSON="$c" CATALOG_JSON="$a" INSTALLED_JSON="$i" python3 - <<'PY'
import json,os
c=json.loads(os.environ['CAMPAIGN_JSON']); a=json.loads(os.environ['CATALOG_JSON']); i=json.loads(os.environ['INSTALLED_JSON']); s=i.get('services',{}); on=c.get('config',{}).get('installations',{})
print(json.dumps([{'name':x.get('name'),'catalogued':True,'observed':({'installed':bool(s.get('installed')),'activated':bool(s.get('activated')),'loaded':s.get('loaded',[]),'parked':s.get('parked',[])} if x.get('name')=='ronin_services' else 'unknown'),'campaign_on':on.get(x.get('name')) is True} for x in a],indent=2))
PY
        ;;
      write) name=${1:-}; choice=${2:-}; [ "$#" -ge 2 ] || die 'BAD-ARG: installations write needs name and on|off.' 2; shift 2; take_campaign "$@"; [ "${#REMAINING[@]}" -eq 0 ] || die 'BAD-ARG: unexpected installations write argument.' 2; case "$choice" in on) flag=true;; off) flag=false;; *) die 'BAD-ARG: installation choice is on or off.' 2;; esac; resolve_campaign; c=$(api GET "/api/campaigns/$CAMPAIGN"); body=$(printf '%s' "$c" | NAME="$name" FLAG="$flag" python3 -c 'import json,os,sys; c=json.load(sys.stdin); m=dict(c.get("config",{}).get("installations",{})); m[os.environ["NAME"]]=os.environ["FLAG"]=="true"; print(json.dumps({"config":{"installations":m}}))'); api PUT "/api/campaigns/$CAMPAIGN" "$body" | pretty;;
      *) die "BAD-ARG: unknown installations operation '$sub'." 2;; esac
    ;;
  defaults)
    sub=${1:-}; shift || true
    case "$sub" in
      -h|--help|'') echo 'Fields: provider, model, reach, recruit, output, behaviours, launch-mode. Lists use comma-separated values.';;
      read) take_campaign "$@"; resolve_campaign; api GET "/api/campaigns/$CAMPAIGN" | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin).get("config",{}).get("defaults",{}),indent=2))';;
      write) field=${1:-}; value=${2-}; [ "$#" -ge 2 ] || die 'BAD-ARG: defaults write needs field and value.' 2; shift 2; take_campaign "$@"; resolve_campaign; c=$(api GET "/api/campaigns/$CAMPAIGN"); body=$(printf '%s' "$c" | FIELD="$field" VALUE="$value" python3 -c 'import json,os,sys
c=json.load(sys.stdin); d=dict(c.get("config",{}).get("defaults",{})); f=os.environ["FIELD"].replace("-","_"); v=os.environ["VALUE"]
if f not in {"provider","model","reach","recruit","output","behaviours","launch_mode"}: raise SystemExit(2)
d[f]=[x.strip() for x in v.split(",") if x.strip()] if f in {"output","behaviours"} else v
print(json.dumps({"config":{"defaults":d}}))') || die 'BAD-ARG: unknown defaults field.' 2; api PUT "/api/campaigns/$CAMPAIGN" "$body" | pretty;;
      *) die "BAD-ARG: unknown defaults operation '$sub'." 2;; esac
    ;;
  project-root)
    sub=${1:-}; shift || true
    case "$sub" in
      -h|--help|'') echo 'Usage: project-root list|read|create|write|archive|exclude. Commands identify a Workspace Folder by its workspace-folder-handle. Writable fields: title, dir, match, remit, docs, plans, campaign_id.';;
      list) all=false; args=(); while [ "$#" -gt 0 ]; do case "$1" in --all) all=true; shift;; *) args+=("$1"); shift;; esac; done; take_campaign "${args[@]}"; resolve_campaign; path="/api/project-roots/detail?campaign_id=$CAMPAIGN"; [ "$all" = false ] || path='/api/project-roots/detail'; api GET "$path" | pretty;;
      read) need id "${1-}"; id=$1; shift; take_campaign "$@"; resolve_campaign; api GET "/api/project-roots/detail?campaign_id=$CAMPAIGN" | ID="$id" python3 -c 'import json,os,sys; rows=[x for x in json.load(sys.stdin).get("roots",[]) if x.get("name")==os.environ["ID"]]; print(json.dumps(rows[0],indent=2)) if len(rows)==1 else (_ for _ in ()).throw(SystemExit(3))' || die "NO-PROJECT-ROOT: '$id' is not in Campaign '$CAMPAIGN'" 3;;
      create) need id "${1-}"; id=$1; shift; title='' dir='' campaign_id='' remit='' match='' docs='' plans=''; while [ "$#" -gt 0 ]; do need "$@"; case "$1" in --title) title=$2;; --dir) dir=$2;; --campaign) campaign_id=$2;; --remit) remit=$2;; --match) match=$2;; --docs) docs=$2;; --plans) plans=$2;; *) die "BAD-ARG: unknown project-root flag '$1'." 2;; esac; shift 2; done; [ -n "$dir" ] || die 'BAD-ARG: --dir is required.' 2; CAMPAIGN=$campaign_id; resolve_campaign; body=$(json_body 'import json,sys; keys=["name","title","dir","campaign_id","remit","match","docs","plans"]; print(json.dumps({k:v for k,v in zip(keys,sys.argv[1:]) if v}))' "$id" "$title" "$dir" "$CAMPAIGN" "$remit" "$match" "$docs" "$plans"); api POST '/api/project-roots' "$body" | pretty;;
      write) id=${1:-}; field=${2:-}; value=${3-}; [ "$#" -eq 3 ] || die 'BAD-ARG: project-root write needs workspace-folder-handle, field, value.' 2; case "$field" in title|dir|match|remit|docs|plans|campaign_id) ;; *) die 'BAD-ARG: project-root field is title, dir, match, remit, docs, plans, or campaign_id.' 2;; esac; body=$(json_body 'import json,sys; print(json.dumps({sys.argv[1]:sys.argv[2]}))' "$field" "$value"); api PUT "/api/project-roots/$id" "$body" | pretty;;
      archive) [ "$#" -eq 1 ] || die 'BAD-ARG: project-root archive needs one workspace-folder-handle.' 2; api PUT "/api/project-roots/$1" '{"archived":true}' | pretty;;
      exclude) [ "$#" -eq 1 ] || die 'BAD-ARG: project-root exclude needs one workspace-folder-handle.' 2; api DELETE "/api/project-roots/$1" '{}' | pretty;;
      *) die "BAD-ARG: unknown project-root operation '$sub'." 2;; esac
    ;;
  provider)
    sub=${1:-}; shift || true
    case "$sub" in
      -h|--help|'') echo 'Usage: provider read [--campaign <id>]; provider write-default <provider> <model>; provider write-preferred <provider> <model>';;
      read) take_campaign "$@"; resolve_campaign; c=$(api GET "/api/campaigns/$CAMPAIGN"); m=$(api GET '/api/machine-settings'); p=$(api GET '/api/provider-catalog'); CAMPAIGN_JSON="$c" SETTINGS_JSON="$m" PROVIDERS_JSON="$p" python3 -c 'import json,os; c=json.loads(os.environ["CAMPAIGN_JSON"]); m=json.loads(os.environ["SETTINGS_JSON"]); print(json.dumps({"catalog":json.loads(os.environ["PROVIDERS_JSON"]),"observed":c.get("providers"),"preferences":m.get("set",{}).get("agents",{}).get("sessions",{})},indent=2))';;
      write-default|write-preferred) [ "$#" -eq 2 ] || die "BAD-ARG: provider $sub needs provider and model." 2; provider=$1; model=$2; if [ "$sub" = write-default ]; then body=$(json_body 'import json,sys; print(json.dumps({"sessions":{"default":{"provider":sys.argv[1],"model":sys.argv[2]}}}))' "$provider" "$model"); else body=$(json_body 'import json,sys; print(json.dumps({"sessions":{"by_provider":{sys.argv[1]:sys.argv[2]}}}))' "$provider" "$model"); fi; envelope=$(BODY="$body" python3 -c 'import json,os; print(json.dumps({"family":"agents","value":json.loads(os.environ["BODY"])}))'); api PATCH '/api/machine-settings' "$envelope" | pretty;;
      *) die "BAD-ARG: unknown provider operation '$sub'." 2;; esac
    ;;
  machine|owner|session-defaults|messages|requirements)
    scope=$COMMAND; sub=${1:-}; shift || true
    case "$sub" in -h|--help|'') echo "Run machine-settings --help for $scope operations."; exit 0;; esac
    settings=$(api GET '/api/machine-settings')
    if [ "$sub" = read ]; then
      SCOPE="$scope" printf '%s' "$settings" | SCOPE="$scope" python3 -c 'import json,os,sys; a=json.load(sys.stdin); s=a.get("set",{}); k=os.environ["SCOPE"]; v={"machine":s.get("machine",{}),"owner":s.get("owner",{}),"session-defaults":{"max":a.get("status",{}).get("session_max"),"desk":s.get("desk",{}),"agents":s.get("agents",{}).get("jobs",{})},"messages":s.get("messages",{}),"requirements":{"wanted":s.get("wanted",[]),"needed":a.get("needed",[])}}[k]; print(json.dumps(v,indent=2))'
      exit 0
    fi
    [ "$sub" = write ] || die "BAD-ARG: unknown $scope operation '$sub'." 2
    field=${1:-}; value=${2-}; [ "$#" -eq 2 ] || die "BAD-ARG: $scope write needs field and value." 2
    case "$scope:$field" in
      machine:name|machine:where) family=machine; body=$(json_body 'import json,sys; print(json.dumps({sys.argv[1]:sys.argv[2]}))' "$field" "$value");;
      machine:monitor) family=machine; case "$value" in true|on) b=true;; false|off) b=false;; *) die 'BAD-ARG: monitor is on/off or true/false.' 2;; esac; body="{\"monitor\":$b}";;
      owner:name) family=owner; body=$(json_body 'import json,sys; print(json.dumps({"name":sys.argv[1]}))' "$value");;
      session-defaults:max) family=session-max; body=$(json_body 'import json,sys; print(json.dumps({"max":int(sys.argv[1])}))' "$value") || die 'BAD-ARG: max is an integer.' 2;;
      session-defaults:desk-profile) family=desk; body=$(json_body 'import json,sys; print(json.dumps({"profile":sys.argv[1]}))' "$value");;
      session-defaults:mika-level) family=agents; body=$(json_body 'import json,sys; print(json.dumps({"jobs":{"mikaassist":{"level":sys.argv[1]}}}))' "$value");;
      messages:auto-force-after-s) family=messages; body=$(json_body 'import json,sys; print(json.dumps({"auto_force_after_s":int(sys.argv[1])}))' "$value") || die 'BAD-ARG: seconds is an integer.' 2;;
      requirements:wanted) family=wanted; body=$(VALUE="$value" python3 -c 'import json,os; v=json.loads(os.environ["VALUE"]); assert isinstance(v,list); print(json.dumps({"wanted":v}))') || die 'BAD-ARG: wanted must be a JSON array.' 2;;
      *) die "BAD-ARG: '$field' is not a writable $scope field." 2;; esac
    envelope=$(BODY="$body" FAMILY="$family" python3 -c 'import json,os; print(json.dumps({"family":os.environ["FAMILY"],"value":json.loads(os.environ["BODY"])}))')
    api PATCH '/api/machine-settings' "$envelope" | pretty
    ;;
  *) die "BAD-ARG: unknown operation '$COMMAND'. Run machine-settings --help." 2;;
esac
