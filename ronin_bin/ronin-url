#!/usr/bin/env bash
# ronin-url — where the live Ronin answers, for zero-dependency shell tools.
#
# Prints one line: RONIN_URL when it is set (an explicit development/test target over
# HTTP), otherwise the path of the operator's own socket. The socket is the address, held
# by the kernel: it lives at <data root>/run/ronin.sock — the same rule every Ronin store is
# found by — or wherever RONIN_SOCKET says, which a session is told at birth. No tmux is
# consulted; the tmux server option that used to carry the address was retired 2026-09-05.
#
# Exit 4 with one of two refusals, so "never started" and "stopped" stop wearing the same
# words. Callers build their request through the sibling ronin-http.sh.
set -u

if [ -n "${RONIN_URL:-}" ]; then
  printf '%s\n' "$RONIN_URL"
  exit 0
fi

sock=${RONIN_SOCKET:-${RONIN_DATA_ROOT:-$HOME/.ronin}/run/ronin.sock}

if [ ! -e "$sock" ]; then
  cat >&2 <<EOF
REFUSED: no Ronin has started on this box (no socket at $sock).
Start Ronin, or set RONIN_URL for a development/test target.
EOF
  exit 4
fi

# Somebody must be listening: a socket file outlives a crash. Connecting is the check —
# no HTTP, nothing that can hang — and python3 is already this tool's one dependency.
if ! SOCK="$sock" python3 - <<'PY' 2>/dev/null
import os, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(2)
try:
    s.connect(os.environ["SOCK"])
except OSError:
    sys.exit(1)
finally:
    s.close()
PY
then
  cat >&2 <<EOF
REFUSED: Ronin is not running (socket at $sock, nobody listening).
journalctl --user -u ronin.service -n 50 says why; start it with: systemctl --user start ronin
EOF
  exit 4
fi

printf '%s\n' "$sock"
