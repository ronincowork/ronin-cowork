#!/usr/bin/env bash
# office — the office's facts (KAN-768, src/facts.ts): one file each in ~/ronin/library/facts/,
# rewritten when what they read changes. `read` builds them all now and prints them as one
# (GET /api/office/read); `read <fact>` builds and prints one (GET /api/facts/<fact>).
# ~/ronin/library/MACHINE_STATUS.md is the same suite in one file, kept current.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" office "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
usage() { cat <<'EOF_USAGE'
Usage:
  office read          every fact, built now, as one: about_user, machine, account (hosted),
                       workspaces, integrations_authentications, teams_agents, epics, defaults
  office read <fact>   one of them, built now
The files: ~/ronin/library/facts/<fact>.md, current whenever read; all of them in one:
~/ronin/library/MACHINE_STATUS.md. The people's notes: ~/ronin/library/ABOUT_USER.md.
EOF_USAGE
}
case "${1:-}" in
  read)
    [ "$#" -le 2 ] || { echo "office: read takes at most one fact name (office --help)" >&2; exit 2; } ;;
  -h|--help) usage; exit 0 ;;
  '') usage >&2; exit 2 ;;
  *) echo "office: unknown command $1 (office --help)" >&2; exit 2 ;;
esac
FACT=${2:-}
case "$FACT" in ''|[a-z_]*) ;; *) echo "office: a fact name is lower-case (office --help)" >&2; exit 2 ;; esac

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
route=/api/office/read
[ -n "$FACT" ] && route="/api/facts/$FACT"
out=$(curl -sS -m 60 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -w '\n%{http_code}' "$url$route") || { echo "UNREACHABLE: Ronin did not answer at $url" >&2; exit 5; }
OFFICE=$out python3 -c '
import json, os, sys
body, _, status = os.environ["OFFICE"].rpartition("\n")
try: d = json.loads(body)
except Exception: d = None
if not d or not d.get("ok"): print((d or {}).get("error") or "HTTP %s: Ronin answered without the facts" % status, file=sys.stderr); sys.exit(3)
print(d["text"].rstrip() or "Not a fact of this office.")
'
