#!/usr/bin/env bash
# harness — sign a harness in without a terminal (owner, 24 Nov; samurai_lab/wip/SETUP_HARNESS.md):
# Ronin runs the CLI's own login for the way chosen and the Helpful Assistant hears how it ends.
# Over the Harness page's own routes: /api/setup/sign-in, /api/setup/providers/<id>/sign-in.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" harness "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
usage() { cat <<'EOF_USAGE'
Usage:
  harness sign-in <claude|codex> subscription|api_key   start its sign-in; prints the link and code
  harness state                                         the sign-ins open now: link, code, what to paste
  harness cancel <claude|codex>                         stop that sign-in
The code or key is pasted into the box on the page by the person, never sent here. How it ends
comes to you as a House notice. Other harnesses sign in on their own page: ronin-help provider-sign-in.
EOF_USAGE
}
cmd=${1:-}; [ "$#" -gt 0 ] && shift
case "$cmd" in
  -h|--help|'') usage; [ -n "$cmd" ]; exit $? ;;
  sign-in) [ "$#" -eq 2 ] && { [ "$2" = subscription ] || [ "$2" = api_key ]; } || { usage >&2; exit 2; } ;;
  state) [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
  cancel) [ "$#" -eq 1 ] || { usage >&2; exit 2; } ;;
  *) echo "harness: unknown command $cmd (harness --help)" >&2; exit 2 ;;
esac

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
RONIN_BASE="$url" CMD="$cmd" python3 - "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" --args "$@" <<'EOF_PY'
import json, os, subprocess, sys, time
argv = sys.argv[1:]
split = argv.index('--args')
curl_opts, args = argv[:split], argv[split + 1:]
base, cmd = os.environ['RONIN_BASE'], os.environ['CMD']
def call(method, route, body=None):
    line = ['curl', '-sS', '-m', '60', *curl_opts, '-w', '\n%{http_code}', '-X', method, base + route]
    if body is not None: line += ['-H', 'Content-Type: application/json', '--data-binary', json.dumps(body)]
    out = subprocess.run(line, capture_output=True, text=True)
    text, _, status = out.stdout.rpartition('\n')
    data = json.loads(text) if text.strip().startswith(('{', '[')) else {}
    if not status.startswith('2'): sys.exit(f"harness: {data.get('error') or text.strip() or out.stderr.strip() or status}")
    return data
def runs(): 
    state = call('GET', '/api/setup/sign-in')
    return state.get('runs', state) if isinstance(state, dict) else state
def show(run):
    paste = {'code': 'the person pastes the code into the box on the page', 'key': 'the person pastes the key into the box on the page'}.get(run.get('paste'), 'nothing to paste')
    print(f"{run.get('label') or run.get('provider')} ({run.get('way')}): link {run.get('link') or 'not yet'}{', code ' + run['code'] if run.get('code') else ''}; {paste}{' (sent)' if run.get('sent') else ''}")
if cmd == 'sign-in':
    provider, way = args
    run = call('POST', f'/api/setup/providers/{provider}/sign-in', {'way': way, 'tell': 'irasshai'}).get('run') or {}
    for _ in range(20):  # the CLI prints its link within seconds
        if run.get('link'): break
        time.sleep(0.5)
        found = runs(); found = found.values() if isinstance(found, dict) else found
        run = next((r for r in found if isinstance(r, dict) and r.get('provider') == provider), run)
    show(run)
elif cmd == 'state':
    found = runs(); found = list(found.values()) if isinstance(found, dict) else list(found or [])
    if not found: print('No sign-in is open.')
    for run in found:
        if isinstance(run, dict): show(run)
else:
    call('POST', f'/api/setup/providers/{args[0]}/sign-in/cancel', {})
    print(f'{args[0]} sign-in cancelled.')
EOF_PY
