#!/usr/bin/env bash
# harness — sign a harness in without a terminal (owner, 24 Nov; docs/architecture/setup-workbench.md "Harnesses"):
# Ronin runs the CLI's own login for the way chosen and the Helpful Assistant hears how it ends.
# Over the Harness page's own routes: /api/setup/sign-in, /api/setup/harnesses/<id>/sign-in.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" harness "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
usage() { cat <<'EOF_USAGE'
Usage:
  harness sign-in <claude|codex> subscription|api_key   start its sign-in; prints the link and code
  harness state                                         each one's sign-in way, and the sign-ins open now
  harness cancel <claude|codex>                         stop that sign-in
  harness open <id>                                     open another harness's terminal sign-in on its page
  harness close <id>                                    close that terminal sign-in
  harness entries                                       Hermes's model services (Ronin Gateway, each key) and model entries
  harness entry add <service> <model> [--name N] [--reasoning R] [--approvals off|prompt]
                                                        add a model entry on a key (name: the model; default; off)
  harness entry remove <name>                           remove a model entry
The code or key is pasted into the box on the page by the person, never sent here. How it ends
comes to you as a House notice. Other harnesses sign in on their own page: ronin-help harness-sign-in.
EOF_USAGE
}
cmd=${1:-}; [ "$#" -gt 0 ] && shift
case "$cmd" in
  -h|--help|'') usage; [ -n "$cmd" ]; exit $? ;;
  sign-in) [ "$#" -eq 2 ] && { [ "$2" = subscription ] || [ "$2" = api_key ]; } || { usage >&2; exit 2; } ;;
  state) [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
  cancel|open|close) [ "$#" -eq 1 ] || { usage >&2; exit 2; } ;;
  entries) [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
  entry) { [ "${1:-}" = add ] && [ "$#" -ge 3 ] && [ $(( $# % 2 )) -eq 1 ]; } || { [ "${1:-}" = remove ] && [ "$#" -eq 2 ]; } || { usage >&2; exit 2; } ;;
  *) echo "harness: unknown command $cmd (harness --help)" >&2; exit 2 ;;
esac

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
RONIN_BASE="$url" CMD="$cmd" python3 - "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" --args "$@" <<'EOF_PY'
import json, os, subprocess, sys, time
argv = sys.argv[1:]
split = argv.index('--args')
curl_opts, args = argv[:split], argv[split + 1:]
base, cmd = os.environ['RONIN_BASE'], os.environ['CMD']
def call(method, route, body=None):
    line = ['curl', '-sS', '-m', '60', *curl_opts, '-w', '\n%{http_code}', '-X', method, base + route]
    if body is not None: line += ['-H', 'Content-Type: application/json', '--data-binary', json.dumps(body)]
    out = subprocess.run(line, capture_output=True, text=True)
    text, _, status = out.stdout.rpartition('\n')
    data = json.loads(text) if text.strip().startswith(('{', '[')) else {}
    if not status.startswith('2'): sys.exit(f"harness: {data.get('error') or text.strip() or out.stderr.strip() or status}")
    return data
def runs():
    state = call('GET', '/api/setup/sign-in')
    return state.get('runs', state) if isinstance(state, dict) else state
WAY = {'subscription': 'subscription', 'api_key': 'API key'}
def show(run):
    paste = {'code': 'the person pastes the code into the box on the page', 'key': 'the person pastes the key into the box on the page'}.get(run.get('paste'), 'nothing to paste')
    print(f"{run.get('label') or run.get('provider')} ({run.get('way')}): link {run.get('link') or 'not yet'}{', code ' + run['code'] if run.get('code') else ''}; {paste}{' (sent)' if run.get('sent') else ''}")
if cmd == 'sign-in':
    provider, way = args
    run = call('POST', f'/api/setup/harnesses/{provider}/sign-in', {'way': way, 'tell': 'irasshai'}).get('run') or {}
    for _ in range(20):  # the CLI prints its link within seconds
        if run.get('link'): break
        time.sleep(0.5)
        found = runs(); found = found.values() if isinstance(found, dict) else found
        run = next((r for r in found if isinstance(r, dict) and r.get('provider') == provider), run)
    show(run)
elif cmd == 'state':
    state = call('GET', '/api/setup/sign-in')
    for provider, way in (state.get('ways') or {}).items():  # as each CLI's own status says
        print(f"{provider}: {'signed in with its ' + WAY[way] if way else 'not signed in'}")
    found = state.get('runs') or []
    if not found: print('No sign-in is open.')
    for run in found:
        if isinstance(run, dict): show(run)
elif cmd == 'cancel':
    call('POST', f'/api/setup/harnesses/{args[0]}/sign-in/cancel', {})
    print(f'{args[0]} sign-in cancelled.')
elif cmd == 'open':  # the page's own press: its terminal opens on the harness's page
    opened = call('POST', f'/api/setup/harnesses/{args[0]}/login', {}).get('opened')
    print(f"{args[0]} sign-in {'opened' if opened else 'was already open'} on its page; the person signs in there.")
elif cmd == 'close':
    call('POST', f'/api/setup/harnesses/{args[0]}/close', {})
    print(f'{args[0]} sign-in closed.')
else:  # Hermes: its model services (the Ronin Gateway, the person's keys, typed on the page) and their model entries
    services = call('GET', '/api/model-services').get('services') or []
    gateway = [x for x in services if x.get('service_type') == 'gateway']
    keys = [x for x in services if x.get('service_type') != 'gateway' and x.get('configured')]
    entries = [(x, m) for x in services for m in (x.get('models') or [])]
    if cmd == 'entries':
        for x in gateway: print(f"Ronin Gateway: every model it lists is already an entry ({', '.join(x.get('discovered') or []) or 'none read yet'})")
        for x in keys: print(f"Key {x.get('name')}: models {', '.join(x.get('discovered') or []) or 'none read yet'}")
        if not keys: print('No key of their own yet: they add one under API key or OpenRouter on the Hermes panel.')
        for x, m in entries: print(f"Entry {m['name']}: {m['model']} on {x.get('name')}, reasoning {m.get('reasoning')}, approvals {m.get('approvals')}")
    elif args[0] == 'add':
        want, model, flags = args[1], args[2], dict(zip(args[3::2], args[4::2]))
        if set(flags) - {'--name', '--reasoning', '--approvals'}: sys.exit('harness: entry add takes --name, --reasoning and --approvals (harness --help)')
        x = next((x for x in keys if want in (x['id'], x.get('name')) or want.lower() == (x.get('name') or '').lower()), None)
        if not x: sys.exit(f"harness: no key {want}; Ronin Gateway models are already entries (harness entries)")
        name = flags.get('--name', model)
        call('POST', '/api/model-services/save-model', {'service_id': x['id'], 'name': name, 'model': model, 'reasoning': flags.get('--reasoning', 'default'), 'approvals': flags.get('--approvals', 'off')})
        print(f"Added model entry {name}: {model} on {x.get('name')}.")
    else:
        m = next((m for _, m in entries if m['name'].lower() == args[1].lower()), None)
        if not m: sys.exit(f"harness: no model entry {args[1]} (harness entries)")
        call('POST', '/api/model-services/delete-model', {'id': m['id']})
        print(f"Removed model entry {m['name']}.")
EOF_PY
