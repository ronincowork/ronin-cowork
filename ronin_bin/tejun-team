#!/usr/bin/env bash
# tejun-team — resolve a team name to its sessions (TEJUN team-roster).
# Usage: tejun-team [team]          no arg = list every team in play
#
# A "team" (KOTOBA: session_team) is just the sessions carrying the same tag in
# @ronin-tags — there is no team object to create or clean up, and a tag dies with its
# session. This reads tmux directly (not the Ronin HTTP API) so it still answers when
# Ronin isn't running. Read-only: it reports each member's dial but changes nothing,
# and never tags anything.
set -u

VIEWER_PREFIX="grid_"   # browser viewer sessions — never on a team

# name·tags·dial·leads for every real session, viewers dropped.
#
# SEP is \x1f (unit separator), NOT a tab. Tab is an IFS *whitespace* character, so bash
# collapses a RUN of them into one delimiter: an untagged session emitted as
# `name<TAB><TAB>write` read back as tags="write", and every such session then matched a
# team called "write". \x1f is not whitespace, so an empty field stays an empty field.
# Nothing in a name, tag, dial or lead can contain it.
SEP=$'\x1f'
roster() {
  while IFS=$SEP read -r name tags dial leads; do
    printf '%s%s%s%s%s%s%s\n' "$name" "$SEP" "$tags" "$SEP" "$dial" "$SEP" "$leads"
  done < <(tmux list-sessions -F "#{session_name}${SEP}#{@ronin-tags}${SEP}#{@ronin-control}${SEP}#{@ronin-lead}" 2>/dev/null \
    | grep -v "^${VIEWER_PREFIX}")
}

# Does $1 (a comma list) contain the exact team $2?
has_team() { case ",${1// /}," in *",${2},"*) return 0 ;; *) return 1 ;; esac; }

if [ $# -eq 0 ]; then
  # Every team in play + its size. Sessions with no tags are reported as loose, so
  # "not in the list" never silently means "I forgot to tag it".
  #
  # A team's leads are named beside it — the 人, the hand-set designation, which
  # implies MEMBERSHIP: a lead is tagged into the team it runs like anyone else, so a
  # team cannot exist by virtue of somebody leading an empty one.
  out=$(roster | awk -F'\037' '
    { if ($2 == "") { loose++; next }
      n = split($2, t, ",")
      m = split($4, l, ","); for (j = 1; j <= m; j++) gsub(/^[ \t]+|[ \t]+$/, "", l[j])
      for (i = 1; i <= n; i++) { gsub(/^[ \t]+|[ \t]+$/, "", t[i])
        if (t[i] != "") { c[t[i]]++; seen[t[i]] = 1
          for (j = 1; j <= m; j++) if (l[j] == t[i]) qb[t[i]] = (qb[t[i]] == "" ? $1 : qb[t[i]] " + " $1) } }
    }
    END { for (g in seen) printf "%s\037%d\037%s\n", g, c[g], qb[g]; if (loose) printf "\001untagged\037%d\037\n", loose }' \
    | sort)
  [ -n "$out" ] || { echo "NO-TEAMS: no session carries a tag yet (owner tags them in the Ronin UI)"; exit 3; }
  printf '%s\n' "$out" | while IFS=$SEP read -r g n qb; do
    case "$g" in
      $'\001untagged') printf '%-24s %s session(s), on no team\n' '(untagged)' "$n" ;;
      *) if [ -n "${qb:-}" ]; then
           printf '%-24s %s session(s), led by %s\n' "$g" "$n" "$qb"
         else
           printf '%-24s %s session(s)\n' "$g" "$n"
         fi ;;
    esac
  done
  exit 0
fi

G=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
found=0
# The leads go first, then the rest — the same order a Team View draws. 人 marks the
# designated leads; the dial still decides who may drive whom.
while IFS=$SEP read -r name tags dial leads; do
  has_team "${tags:-}" "$G" || continue
  has_team "${leads:-}" "$G" || continue
  found=1
  printf '%-24s %-8s %s\n' "$name" "${dial:-write}" '人'
done < <(roster)

while IFS=$SEP read -r name tags dial leads; do
  # exact tag match, not substring: 'kojin' must not match 'kojinsa'
  has_team "${tags:-}" "$G" || continue
  has_team "${leads:-}" "$G" && continue   # already printed, at the head
  found=1
  printf '%-24s %-8s %s\n' "$name" "${dial:-write}" '-'
done < <(roster)

[ "$found" = 1 ] || { echo "NO-TEAM: nothing is tagged '$G' — run 'tejun-team' to see the teams that exist"; exit 3; }
