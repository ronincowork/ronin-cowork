#!/usr/bin/env bash
# tejun-account — who this install belongs to, and what it is entitled to
# (TEJUN survey-account).
# Usage: tejun-account          no arguments
#
# The account side of the story. SETTEI answers what the owner chose; the activation
# aggregate answers which entitlement Shiwake issued. `tejun-secrets` answers which
# CREDENTIAL is in force. These are different facts with different owners.
#
# Read-only, and it never prints a credential — BY SELECTION, not because the file has
# none: `ronin.json` now carries the login record (auth + passkeys), so this tool prints
# only the named fields below and the file is never served or echoed whole, by anything.
#
# THE LOCAL FILE READ IS BLESSED HERE (ruling, 2026-08-18). Doctrine says surfaces
# convert the one door (`GET /api/machine-settings`) and bash reads the bus; this tool reads the
# file directly because it must answer on a box whose operator is not running — the
# exact moment an account question gets asked. Named keys only, never the document.
set -u

# RESOLVE PAST THE PROJECTED SYMLINK. A session's tools arrive as symlinks in the
# session-commands store (src/routine-tools.ts); BASH_SOURCE is the link, not this file,
# and ../ from the link is a store with no src/ or bin/ — measured 2026-09-02 (desk audit):
# resolve the shipped tool rather than the projection directory.
SELF=${BASH_SOURCE[0]}
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case $link in /*) SELF=$link ;; *) SELF=$(dirname "$SELF")/$link ;; esac
done
STORE="$(cd "$(dirname "$SELF")/../bin" && pwd)/ronin-store"
[ -x "$STORE" ] || STORE=ronin-store
CONFIG_DIR="$("$STORE" config 2>/dev/null)"
CONFIG="${CONFIG_DIR:+$CONFIG_DIR/ronin.json}"
ACTIVATION="${CONFIG_DIR:+$CONFIG_DIR/services-activation.json}"

echo "ACCOUNT — who this install belongs to"

if { [ -z "$CONFIG" ] || [ ! -f "$CONFIG" ]; } && { [ -z "$ACTIVATION" ] || [ ! -f "$ACTIVATION" ]; }; then
  printf '  %-16s %s\n' "config file" "not created yet — nothing has been set"
  echo
  echo "  A fresh install: no owner name, no entitlement, no limits of their own."
  echo "  That is the ordinary first-run state, not a fault."
  exit 0
fi

# One python3 pass — the house allows it where JSON is unavoidable, and hand-parsing
# nested JSON in bash is how a config file starts lying to you.
python3 - "$CONFIG" "$ACTIVATION" <<'PY'
import json, os, sys

def read(path, label):
    if not path or not os.path.isfile(path):
        return {}
    try:
        return json.load(open(path))
    except Exception as e:
        print(f"  {label:<16} UNREADABLE ({e.__class__.__name__})")
        return {}

cfg = read(sys.argv[1], "config file")
activation = read(sys.argv[2], "activation")

def row(k, v):
    print(f"  {k:<16} {v}")

owner = (cfg.get("owner") or {}).get("name")
if isinstance(owner, str) and owner.strip():
    row("owner name", f"{owner.strip()}  (set)")
else:
    # user-config.ts falls back to the OS username so nothing shipped ever names a
    # person. A fallback is not an answer — it is the absence of one, wearing a name.
    row("owner name", f"NOT SET — falling back to the OS username ({os.environ.get('USER','?')})")

# The non-secret activation aggregate is authoritative. The token that authorizes Services
# is deliberately in another 0600 store and this read-only identity survey never opens it.
ent = activation.get("entitlement_id")
if ent:
    verified = activation.get("verified_at")
    row("entitlement", f"{ent}  (" + ("verified " + verified if verified else "identity recorded") + ")")
else:
    stage = activation.get("stage")
    row("entitlement", f"none recorded" + (f"  (activation: {stage})" if stage else " — a free cowork install"))

mx = (cfg.get("sessions") or {}).get("max")
row("session max", mx if mx is not None else "not set — the built-in default applies")

row("config file", sys.argv[1])

missing = []
if not (isinstance(owner, str) and owner.strip()):
    missing.append("owner name")
print()
if missing:
    print("  Not yet answered: " + ", ".join(missing) + ".")
    print("  Ask before assuming — a name Ronin guessed from the login is not one the")
    print("  owner gave, and nothing shipped may name a person (ronin_sops/accounts.md).")
else:
    print("  Everything this tool asks about has an answer.")
PY

echo
echo "SETTEI supplies the owner choices; the activation record supplies entitlement identity."
echo "For which credential is actually in force, run tejun-secrets."
