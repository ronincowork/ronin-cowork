#!/usr/bin/env bash
# tejun-secrets — what keys this project holds, and whether git can see them
# (TEJUN survey-secrets).
# Usage: tejun-secrets [path]     path = the project directory (default: $PWD)
#
# **It prints key NAMES and never key VALUES.** A name (STRIPE_SECRET_KEY) is what you
# need to reason about; a value is the thing itself, and a tool that echoed one would put
# it in a pane, a tape, a scrollback and a log in a single breath. There is no flag to
# make it print values, deliberately.
#
# Read-only: it reads env files and asks git what it tracks. It never writes, never stages
# and never edits .gitignore — the SOP says what to do, a person decides to do it.
set -u

TARGET="${1:-$PWD}"
[ -d "$TARGET" ] || { echo "NO-PATH $TARGET" >&2; exit 3; }
cd "$TARGET" || exit 3

IS_REPO=no
git rev-parse --is-inside-work-tree >/dev/null 2>&1 && IS_REPO=yes

echo "SECRETS — $TARGET"
[ "$IS_REPO" = no ] && echo "  (not a git repo — nothing can be committed from here yet)"

# Every env-shaped file at the top level. Not a recursive hunt: a key file buried three
# directories down is a different conversation, and a tool that walked node_modules would
# spend a minute to say nothing.
shopt -s nullglob
FILES=(.env .env.* *.env)
[ ${#FILES[@]} -eq 0 ] && echo "  no env files here"

exposed=0
for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  # Key names only: strip comments and blanks, take what is left of the first `=`.
  names=$(sed 's/#.*//' "$f" 2>/dev/null | awk -F= '/=/ && $1 ~ /[A-Za-z_]/ {gsub(/^[ \t]*(export[ \t]+)?|[ \t]*$/, "", $1); print $1}')
  count=$(printf '%s\n' "$names" | grep -c . || true)

  # A TEMPLATE is supposed to be tracked — that is its whole job, telling the next person
  # which keys to set. Flagging it would be the tool crying wolf, and a check that cries
  # wolf gets turned off, taking the real alarm with it.
  case "$f" in
    *.example|*.sample|*.template|*.dist|example.env|sample.env)
      printf '  %-20s %2s key(s)   template — tracked on purpose, holds names not values\n' "$f" "$count"
      [ "$count" -gt 0 ] && printf '%s\n' "$names" | sed 's/^/      · /'
      continue ;;
  esac

  state="ok"
  if [ "$IS_REPO" = yes ]; then
    if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      state="EXPOSED — tracked by git"; exposed=1
    elif ! git check-ignore -q "$f" 2>/dev/null; then
      state="UNIGNORED — one \`git add .\` from being committed"
    fi
  fi

  printf '  %-20s %2s key(s)   %s\n' "$f" "$count" "$state"
  [ "$count" -gt 0 ] && printf '%s\n' "$names" | sed 's/^/      · /'
done

# Does the ignore rule exist at all? A project with no env file today and no rule will
# grow one tomorrow, and the rule is worth having BEFORE the file does.
if [ "$IS_REPO" = yes ]; then
  echo
  if [ -f .gitignore ] && grep -qE '(^|/)\.env' .gitignore 2>/dev/null; then
    echo "  .gitignore covers .env"
  else
    echo "  .gitignore does NOT mention .env — add the rule before the file exists"
  fi
fi

# WHICH CREDENTIAL A LAUNCHED AGENT WOULD USE. Resolution order is fixed:
# ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> the ANTHROPIC_PROFILE-selected or active
# OAuth profile -> Workload Identity Federation vars -> the default profile on disk.
# The trap this section exists for: a set ANTHROPIC_API_KEY silently outranks every
# profile — an EMPTY one still wins its slot — so a subscription login can be shadowed by
# a stale export nobody remembers, and the only symptom is the bill.
echo
echo "PROVIDER AUTH — which credential a launched agent would use"
winner=""
if [ -n "${ANTHROPIC_API_KEY+x}" ]; then
  if [ -z "$ANTHROPIC_API_KEY" ]; then
    printf '  %-22s %s\n' "ANTHROPIC_API_KEY" "set but EMPTY — still outranks every profile"
  else
    printf '  %-22s %s\n' "ANTHROPIC_API_KEY" "set (value never shown)"
  fi
  winner="ANTHROPIC_API_KEY"
else
  printf '  %-22s %s\n' "ANTHROPIC_API_KEY" "not set"
fi
if [ -n "${ANTHROPIC_AUTH_TOKEN+x}" ]; then
  printf '  %-22s %s\n' "ANTHROPIC_AUTH_TOKEN" "set (value never shown)"
  [ -z "$winner" ] && winner="ANTHROPIC_AUTH_TOKEN"
else
  printf '  %-22s %s\n' "ANTHROPIC_AUTH_TOKEN" "not set"
fi
if command -v ant >/dev/null 2>&1; then
  printf '  %-22s %s\n' "ant profile" "$(ant auth status 2>&1 | head -1)"
  [ -z "$winner" ] && winner="an ant profile (see above)"
else
  printf '  %-22s %s\n' "ant profile" "ant not installed — no OAuth profile on this box"
fi
if [ -n "$winner" ]; then
  echo "  → $winner wins."
else
  echo "  → no env credential here; a subscription login in the CLI itself would serve."
  echo "    This tool cannot see that — ask the CLI (\`claude\` → /status)."
fi
echo "  Checked THIS shell. A pane Ronin spawns inherits the service's environment, not"
echo "  yours — if they differ, that is BYOKI and the pane is the one that counts."

echo
echo "Names only, never values. If anything says EXPOSED, the key is already public:"
echo "rotate it, and do not spend the afternoon rewriting history (ronin_sops/secrets.md)."
[ "$exposed" = 1 ] && exit 4
exit 0
