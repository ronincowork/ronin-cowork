#!/usr/bin/env bash
# workspace-doc — the office's Workspace docs, one Markdown file per Workspace at
# ~/ronin/office/workspaces/<handle>.md: a Summary, then notes (KAN-713, src/workspace-doc.ts).
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" workspace-doc "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
usage() { cat <<'EOF_USAGE'
Usage:
  workspace-doc list                       every Workspace, its handle and its Summary (or "no summary yet")
  workspace-doc read <handle>              its title, objective, repositories and folders with their
                                           directories, then its doc
  workspace-doc summary <handle> <text>    replace its Summary; <text> - reads it from stdin
  workspace-doc note <handle> <text>       add a note at the end, dated and signed with your name
The handle is the Workspace's name. Each doc is ~/ronin/office/workspaces/<handle>.md, made with
its Workspace, or on the first read for an older one; grep the folder to search them all.
The Summary says what the Workspace is for and what is in it, in a few lines: office read shows it.
EOF_USAGE
}
cmd=${1:-}; [ "$#" -gt 0 ] && shift
case "$cmd" in
  -h|--help|'') usage; [ -n "$cmd" ]; exit $? ;;
  list) [ "$#" -eq 0 ] || { usage >&2; exit 2; } ;;
  read) [ "$#" -eq 1 ] || { usage >&2; exit 2; } ;;
  summary|note) [ "$#" -ge 2 ] || { usage >&2; exit 2; } ;;
  *) echo "workspace-doc: unknown command $cmd (workspace-doc --help)" >&2; exit 2 ;;
esac
handle=${1:-}; [ "$#" -gt 0 ] && shift
text="$*"; [ "$text" = - ] && text=$(cat)
case "$handle" in */*|.*) echo "workspace-doc: \"$handle\" is not a Workspace handle" >&2; exit 2 ;; esac

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
body=$(TEXT="$text" BY="${RONIN_SESSION:-}" python3 -c 'import json, os; print(json.dumps({"text": os.environ["TEXT"], "by": os.environ["BY"]}))')
case "$cmd" in
  list) out=$(curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -w '\n%{http_code}' "$url/api/workspace-docs") ;;
  read) out=$(curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -w '\n%{http_code}' "$url/api/workspaces/$handle/doc") ;;
  summary) out=$(curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -w '\n%{http_code}' -X PUT -H 'Content-Type: application/json' --data-binary "$body" "$url/api/workspaces/$handle/doc/summary") ;;
  note) out=$(curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -w '\n%{http_code}' -X POST -H 'Content-Type: application/json' --data-binary "$body" "$url/api/workspaces/$handle/doc/note") ;;
esac || { echo "UNREACHABLE: Ronin did not answer at $url" >&2; exit 5; }
printf '%s' "${out%$'\n'*}" | REPLY_STATUS=${out##*$'\n'} CMD=$cmd python3 -c '
import json, os, sys
status, cmd = os.environ["REPLY_STATUS"], os.environ["CMD"]
try: d = json.loads(sys.stdin.read())
except Exception: print("HTTP %s: Ronin answered without JSON" % status, file=sys.stderr); sys.exit(3)
if not d.get("ok"): print(d.get("error") or "HTTP %s" % status, file=sys.stderr); sys.exit(3)
if cmd == "list":
    rows = d.get("workspaces") or []
    if not rows: print("No Workspaces yet.")
    for w in rows:
        print("%s — %s" % (w["name"], w.get("title") or w["name"]))
        print("  " + ("\n  ".join(w["summary"].splitlines()) if w.get("summary") else "no summary yet"))
    sys.exit(0)
if cmd == "read":
    print("%s — %s" % (d["name"], d.get("title") or d["name"]))
    if d.get("objective"): print("Objective: " + d["objective"])
    for l in d.get("locations") or []:
        print("%s %s: %s%s" % (l["kind"], l["name"], l.get("dir") or "(no directory registered)", " — " + l["note"] if l.get("note") else ""))
    if not d.get("locations"): print("No repositories or folders yet.")
    print("Doc: " + d["path"]); print()
    print(d["text"].rstrip()); sys.exit(0)
print(("Summary written: " if cmd == "summary" else "Note added: ") + d["path"])
'
