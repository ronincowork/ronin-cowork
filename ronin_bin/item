#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" item "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
die() { echo "$1" >&2; exit "${2:-2}"; }
usage() { cat <<'EOF_USAGE'
Usage:
  item create --title <t> [--kind <type>] [--parent <id>] [--objective <o>] [--priority <p>] [--team <t>]
  item read <id>
  item search [--campaign <id>] [--team <t>] [--holder <name>|none] [--parent <id>|--no-parent] [--status <s>] [--kind <k>] [--text <words>]
  item edit <id> --title|--objective|--kind|--parent <id|none>|--priority|--trello|--github <value> ...
  item transition <ids> "<status>"
  item assign <ids> <agent>|team:<name>
  item handoff <ids> <agent>|team:<name>|none [--from <agent>|team:<name>]
  item watch <ids> [<agent>|team:<name>]  item unwatch <ids> [<agent>|team:<name>]
  item flag <ids> [<why>]             item unflag <ids> [<comment>]
  item comment <id> <text>            item comment <id> --edit <n> <text>
  item attach <id> <path>|<url>       item attach <id> --remove <path>|<url>
  item link <id> <type> <id> [--remove]
  item delete <ids> [--in-jira]
<ids> is one id or several (w12 w13 KAN-65), each acted on in turn; every id an item has had
finds it (a w id still finds the item after it takes its Jira key), here, in read, edit and
--parent. create answers "created <id> under <parent>" on its first line. --text matches
every word in the title or objective, any case.
Status, kind, priority and link type are the space's own names, exactly; unconnected,
Jira's: To Do, In Progress, In Review, Done; Epic, Task, Story, Bug, Feature, Subtask;
Highest, High, Medium, Low, Lowest; Blocks, Relates, Duplicate, Cloners. Anything else is
refused, naming the set. The kind sets the level: 1 Epic, 0 Task/Story/Bug/Feature,
-1 Subtask; a new item is one below its parent, and --parent moves it there (to none, the
level stays). The one rule: nothing goes below -1; children follow their parent
("w39 can't go there.").
create lands on you, or on your team when you lead one; leading several, name it with
--team. A new item needs an epic above it (--parent), unless it is an Epic.
watch tracks an item without holding it (yourself unless named; a team's on its roster).
A move to In Review by its holder is a hand-in: the item goes to the Team. On a Jira-connected
campaign, a parent or kind Jira would refuse is refused here, with the reason.
handoff takes you off and the receiver on; --from names the giver instead: take your team's
item with item handoff <id> <you> --from team:<name>, and it shows on the team through you.
delete takes the item's subtasks with it, in Ronin and in Jira; an epic's other children are
left with no parent. An item that came from Jira is deleted only with --in-jira.
--trello, --github set an external key; blank clears. Every change adds a trail line.
Related: work-record --help; team --help
EOF_USAGE
}
case "${1:-}" in -h|--help|'') [ "$#" -le 1 ] || die 'Run item --help.'; usage; [ "$#" -eq 1 ]; exit $?;; esac
. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
# The caller is named on every trail line: this session, or the shell user.
BY=$(ronin_session_me 2>/dev/null || id -un)
# --field value pairs, each from the allowed list, into one JSON body carrying who called.
fields() { python3 -c 'import json,sys
by, allowed, *a = sys.argv[1:]; d = {"by": by}; ok = allowed.split(",")
while a:
    k = a.pop(0)
    if not k.startswith("--") or not a: sys.exit("BAD-ARG: fields go as --field <value> pairs")
    if k[2:] not in ok: sys.exit("BAD-ARG: %s is not a field here; use %s" % (k, ", ".join("--" + f for f in ok)))
    d[k[2:]] = a.pop(0)
print(json.dumps(d))' "$BY" "$@"; }
json() { python3 -c 'import json,sys; a=sys.argv[1:]; print(json.dumps(dict(zip(a[::2], a[1::2]))))' by "$BY" "$@"; }
verb=$1; shift
case "$verb" in
  create) body=$(fields title,objective,parent,kind,priority,team "$@") || exit 2; ronin_item_call POST /api/work-items "$body"; exit $? ;;
  search)
    q=''
    quote() { python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"; }
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --campaign|--team|--holder|--parent|--status|--kind|--text) [ -n "${2:-}" ] || die "BAD-ARG: $1 needs a value"; q="$q&${1#--}=$(quote "$2")"; shift 2 ;;
        --no-parent) q="$q&no_parent=1"; shift ;;
        *) die "BAD-ARG: item search takes --campaign, --team, --holder, --parent, --no-parent, --status, --kind or --text, not $1" ;;
      esac
    done
    ronin_item_call GET "/api/work-items?${q#&}"; exit $? ;;
esac
id=${1:-}; [ -n "$id" ] || die "BAD-ARG: item $verb needs the item's id"; shift
# SEVERAL IDS: the acts that take them read every leading argument that is an id (w12, KAN-65).
# One id goes to the item's own route; several go to /api/work-items/many/<act> { ids }, the
# same body, each id answered on its own line.
ids=("$id")
case "$verb" in
  transition|handoff|assign|watch|unwatch|flag|unflag|delete)
    while [ "$#" -gt 0 ] && [[ $1 =~ ^(w[1-9][0-9]*|[A-Z][A-Z0-9_]+-[1-9][0-9]*)$ ]]; do ids+=("$1"); shift; done ;;
esac
# item_act <act> <method> <body>: the one route for one id, the many route for several.
item_act() {
  if [ "${#ids[@]}" -eq 1 ]; then
    if [ "$1" = delete ]; then ronin_item_call DELETE "/api/work-items/$id" "$3"; else ronin_item_call "$2" "/api/work-items/$id/$1" "$3"; fi
  else
    ronin_item_call POST "/api/work-items/many/$1" "$(python3 -c 'import json,sys; d = json.loads(sys.argv[1]); d["ids"] = sys.argv[2:]; print(json.dumps(d))' "$3" "${ids[@]}")"
  fi
}
case "$verb" in
  read) [ "$#" -eq 0 ] || die 'BAD-ARG: item read takes only <id>'; ronin_item_call GET "/api/work-items/$id" ;;
  edit) [ "$#" -ge 2 ] || die 'BAD-ARG: item edit takes <id> --field <value> ...'
    body=$(fields title,objective,kind,parent,priority,trello,github "$@") || exit 2; ronin_item_call PUT "/api/work-items/$id" "$body" ;;
  transition) [ "$#" -eq 1 ] || die 'BAD-ARG: item transition takes <ids> <status>'
    item_act transition POST "$(json status "$1")" ;;
  assign) [ "$#" -eq 1 ] || die 'BAD-ARG: item assign takes <ids> <agent>|team:<name>'
    case "$1" in
      none) die 'BAD-ARG: use item handoff <id> none to let go' ;;
      team:*) to=$(json team "${1#team:}") ;;
      *) to=$(json session "$1") ;;
    esac
    item_act assign POST "$to" ;;
  handoff) from=''
    [ "$#" -eq 3 ] && [ "$2" = --from ] && { from=$3; set -- "$1"; }
    [ "$#" -eq 1 ] || die 'BAD-ARG: item handoff takes <ids> <agent>|team:<name>|none [--from <agent>|team:<name>]'
    case "$1" in
      none) to=$(python3 -c 'import json,sys; d = {"by": sys.argv[1], "none": True}
if sys.argv[2]: d["from"] = sys.argv[2]
print(json.dumps(d))' "$BY" "$from") ;;
      team:*) to=$(json team "${1#team:}" ${from:+from "$from"}) ;;
      *) to=$(json session "$1" ${from:+from "$from"}) ;;
    esac
    item_act handoff POST "$to" ;;
  watch|unwatch) [ "$#" -le 1 ] || die "BAD-ARG: item $verb takes <ids> [<agent>|team:<name>]"
    case "${1:-}" in
      '') who=$(json) ;;
      team:*) who=$(json team "${1#team:}") ;;
      *) who=$(json session "$1") ;;
    esac
    item_act "$verb" POST "$who" ;;
  comment)
    if [ "${1:-}" = --edit ]; then
      [ "$#" -eq 3 ] || die 'BAD-ARG: item comment takes <id> --edit <n> <text>, the text quoted'
      ronin_item_call POST "/api/work-items/$id/comment" "$(json edit "$2" text "$3")"
    else
      [ "$#" -eq 1 ] || die 'BAD-ARG: item comment takes <id> <text>, the text quoted'
      ronin_item_call POST "/api/work-items/$id/comment" "$(json text "$1")"
    fi ;;
  flag|unflag) [ "$#" -le 1 ] || die "BAD-ARG: item $verb takes <ids> [<comment>], the comment quoted"
    item_act "$verb" POST "$(json ${1:+comment "$1"})" ;;
  attach)
    remove=''; [ "${1:-}" = --remove ] && { remove=true; shift; }
    [ "$#" -eq 1 ] || die 'BAD-ARG: item attach takes <id> [--remove] <path>|<url>'
    # A path is resolved here, against the caller's cwd: the item stores the absolute path.
    case "$1" in http://*|https://*) at=$1 ;; *) at=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$1") ;; esac
    ronin_item_call POST "/api/work-items/$id/attach" "$(json path "$at" ${remove:+remove true})" ;;
  link)
    remove=''; args=()
    for a in "$@"; do [ "$a" = --remove ] && remove=true || args+=("$a"); done
    [ "${#args[@]}" -eq 2 ] || die 'BAD-ARG: item link takes <id> <type> <id> [--remove], the type as the space names it (Blocks)'
    ronin_item_call POST "/api/work-items/$id/link" "$(json type "${args[0]}" to "${args[1]}" ${remove:+remove true})" ;;
  delete) [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --in-jira ]; } || die 'BAD-ARG: item delete takes <ids> [--in-jira]'
    item_act delete DELETE "$(json ${1:+in_jira true})" ;;
  *) usage >&2; exit 2 ;;
esac
