#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" item "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
# Every command prints plain lines (w694); --json, anywhere after the verb, prints only the
# reply as JSON, for a script (w995).
as_json=''
if [ "$#" -gt 1 ]; then a=("$1"); shift; for x in "$@"; do [ "$x" = --json ] && as_json=1 || a+=("$x"); done; set -- "${a[@]}"; fi
[ -z "$as_json" ] || export ITEM_JSON=1
plain() { local out; out=$(ronin_item_call GET "$2") || return $?; if [ -n "$as_json" ]; then printf '%s\n' "$out"; else printf '%s\n' "$out" | python3 "$TOOL_DIR/../libexec/item-plain" "$1"; fi; }
die() { echo "$1" >&2; exit "${2:-2}"; }
usage() { cat <<'EOF_USAGE'
Usage:
  item create --title <t> [--title <t> ...] [--kind <type>] [--parent <id>] [--objective <o>] [--priority <p>] [--team <t>|--workspace <w>] [--playbook]
  item read <ids>
  item search [--campaign <id>] [--team <t>] [--holder <name>|none] [--parent <id>|--no-parent] [--status <s>] [--kind <k>] [--text <words>] [--archived] [--playbook]
  item checkout PLAYBOOK-<n> [<agent>|team:<name>]   item checkout <live id> --playbook
  item edit <ids> --title|--objective|--kind|--parent <id|none>|--priority|--trello|--github <value> ...
  item transition <ids> "<status>" [--note "<what they can try>"]
  item handoff <ids> <agent>|team:<name>|workspace:<name> [--from <agent>|team:<name>] [--keep-holding]
  item handover <ids> <agent>|team:<name> "<where it stands; what is next>" [--to-do] [--flag "<the question>"]
  item watch <ids> [<agent>|team:<name>]  item unwatch <ids> [<agent>|team:<name>]
  item flag <ids> [<why>]             item unflag <ids> [<comment>]
  item comment <ids> <text>           item comment <ids> --edit <n> <text>
  item attach <ids> <path>|<url>|plan:<name>   item attach <ids> --remove <path>|<url>|plan:<name>
  item link <id> <type> <id> [--remove]
  item archive <ids>                  item archive --done [--team <t>]
  item delete <ids>
<ids> is one id or several (w12 w13 KAN-65), each acted on in turn: every command but link
(one item to another) and checkout. create takes several --title, one item each, the rest
shared. One reply line each, what was done with the id, or why not; if any was not done the
tool exits 4: read the reply, in a script too. Every id an item has had
finds it, here, in read, edit and --parent. --text matches every word in the title or objective, any case. An item Done five days is archived: off
every list and out of search unless --archived; item read still finds it.
Status, kind, priority and link type are the space's own names, exactly; by default:
To Do, In Progress, In Review, Done; Epic, Task, Story, Bug, Feature, Subtask;
Highest, High, Medium, Low, Lowest; Blocks, Relates, Duplicate, Cloners. Anything else is
refused, naming the set. The kind sets the level: 1 Epic, 0 Task/Story/Bug/Feature,
-1 Subtask. In create or edit --parent, the kind follows the parent: under an epic, the kind
asked if it is a Task, Story, Bug or Feature, else a Task; under one of those, a Subtask; no
parent, the kind asked, or a Task for a Subtask. Nothing goes under a Subtask: refused, the
reply naming its Task. Children follow; a move that would put one under a Subtask is refused.
Refused too: an item under itself, or a change Jira cannot make to a paired item.
read prints the item plainly: title, id, kind, status, holder, parent (none when empty), the
objective whole, its children one line each, then its latest comments and trail lines, newest
last. With --json, the whole item as JSON, every comment and trail line.
search prints one line per item, '<id> | <status> | <holder> | <title>', the title in full;
with --json, the JSON ({"items": [...]}) instead.
create lands on you, or with --team <t> on that Team (a lead's create lands on its team;
leading several, name it), or with --workspace <w> on that Workspace: an open item of the
project that no Team has yet, or a want under its Icebox. Any kind, an Epic too, with --parent or none. It answers
"created <id>, a <kind> under <parent>" on its first line: "created KAN-820, a Subtask under
KAN-801".
checkout PLAYBOOK-<n> makes that playbook's epic, tasks and subtasks as plain new items, To Do,
held by the receiver (you, unless named), on its holds and tile; they keep no tie to the
playbook. A playbook is work items, status Playbook, each its own PLAYBOOK-<n> with a parent:
stock in ronin_stock/playbooks/, your own in ~/ronin/custom/playbooks/, which replaces stock by
id. item search --playbook lists them (--no-parent the tops), item read PLAYBOOK-<n> reads one,
and edit, comment and delete work on it as on any item, written to your own copy (delete removes
your copy, and the stock one is back). checkout <live id> --playbook files a live item and its
children as a new playbook.
create --playbook makes a new playbook; with --parent PLAYBOOK-<n>, an item under that one.
attach plan:<name> points an epic at its order (plan --help): stored as plan:<workspace>/<name>.
watch tracks an item without holding it (yourself unless named; a team's on its roster).
transition to In Review by its holder is a hand-in: the item goes to the Team, and --note is the
Handed in comment: one short line telling the user what to look at. Without one, or long, the
move still goes and the reply prompts for it; --note again on an item In Review replaces it.
handover is how an ending Agent hands an item on: the note becomes a comment headed "Handover
from <you>", you come off, the receiver goes on, the status stays (--to-do puts it back to To
Do). Can't decide? --flag "<the question>": it is flagged and your lead is told.
flag asks for a reason, quoted ("<who>: <what you need>"); it becomes the comment "Flagged:
<why>". Without one the flag still goes on, and the reply asks you to add it as that comment.
The Agents holding the item show the flag on their pill. unflag takes an optional comment.
Flagged items: Epics, filtered by Flagged.
handoff takes the giver off and the receiver on. The giver is you, with any Team of yours
that holds the item and any Team of the receiver's that holds it; --from names it instead.
--keep-holding, the rare case, keeps the giver on too. Any other holder stays: a second Agent
handed it leaves the first on. Nothing goes to nobody: give work back with item handoff
<id> team:<t>; an ending is handover.
archive takes a Done item off every list now, as five days Done does: archived, one trail line,
nobody told; item read still finds it, and leaving Done brings it back. An item
not Done is refused. --done archives every Done item you or your Teams hold; --team narrows it.
delete takes the item's subtasks with it; an epic's other children are left with no parent.
edit --trello, --github set an external key; blank clears. Every change adds a trail line.
--json, on every command, anywhere after it: only the reply as JSON, nothing else, for a script
(a write: {acknowledgement, item, ...}, the id at .item.id; several at once: {ok, answers:
[{id, ok, item}]}). Without it, plain lines only. A flag the command does not take is refused
by name, with the command's usage, and nothing is done.
Related: work-record --help; team --help
EOF_USAGE
}
case "${1:-}" in -h|--help|'') [ "$#" -le 1 ] || die 'Run item --help.'; usage; [ "$#" -eq 1 ]; exit $?;; esac
# item <command> --help: that command's usage lines and its rule, not the whole page. The rules
# come last in usage, each starting with its command's name, so a rule runs to the next one.
# The --json rule is every command's, so every command's help carries it.
cmd_usage() { usage | python3 -c 'import re,sys
v, text = sys.argv[1], sys.stdin.read().splitlines()
verbs = {m for l in text if l.startswith("  ") for m in re.findall(r"\bitem (\w+)", l)}
if v not in verbs: sys.exit("BAD-ARG: no item command %s; run item --help" % v)
out, keep = [l for l in text if re.match(r"  item (un)?%s\b" % v, l)], False
for l in text:
    if l.startswith(("  ", "Usage", "Related")): keep = False; continue
    first = l.split(" ", 1)[0]
    if first in verbs: keep = first == v
    elif first == "--json,": keep = True
    if keep: out.append(l)
print("\n".join(out))' "$1"; }
for a in "$@"; do case "$a" in -h|--help) cmd_usage "$1"; exit $?;; esac; done
# A flag the command does not take is refused by name, with its usage, before anything is
# sent (w995): a script never runs on past a wrong flag. Values after a flag that takes one
# are not flags. Several words, or a word not --lower-case, is text, never a flag.
takes() { case "$1" in
  create) echo '--title= --kind= --parent= --objective= --priority= --team= --workspace= --playbook' ;;
  search) echo '--campaign= --team= --holder= --parent= --no-parent --status= --kind= --text= --archived --playbook' ;;
  checkout) echo '--playbook' ;;
  edit) echo '--title= --objective= --kind= --parent= --priority= --trello= --github=' ;;
  transition) echo '--note=' ;;
  handoff) echo '--from= --keep-holding' ;;
  handover) echo '--to-do --flag=' ;;
  comment) echo '--edit=' ;;
  attach|link) echo '--remove' ;;
  archive) echo '--done --team=' ;;
  *) echo '' ;;
esac; }
if [ "$#" -gt 1 ]; then
  allowed=" $(takes "$1") "; skip=''
  for a in "${@:2}"; do
    [ -z "$skip" ] || { skip=''; continue; }
    [[ $a =~ ^--[a-z][a-z-]*$ ]] || continue
    case "$allowed" in
      *" $a= "*) skip=1 ;;
      *" $a "*) ;;
      *) { echo "BAD-ARG: item $1 does not take $a; nothing was done."; cmd_usage "$1"; } >&2; exit 2 ;;
    esac
  done
fi
. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
# The caller is named on every trail line: this session, or the shell user.
BY=$(ronin_session_me 2>/dev/null || id -un)
# --field value pairs, each from the allowed list, into one JSON body carrying who called.
fields() { python3 -c 'import json,sys
by, allowed, *a = sys.argv[1:]; d = {"by": by}; ok = allowed.split(",")
while a:
    k = a.pop(0)
    if not k.startswith("--") or not a: sys.exit("BAD-ARG: fields go as --field <value> pairs")
    if k[2:] not in ok: sys.exit("BAD-ARG: %s is not a field here; use %s" % (k, ", ".join("--" + f for f in ok)))
    d[k[2:]] = a.pop(0)
print(json.dumps(d))' "$BY" "$@"; }
json() { python3 -c 'import json,sys; a=sys.argv[1:]; print(json.dumps(dict(zip(a[::2], a[1::2]))))' by "$BY" "$@"; }
verb=$1; shift
case "$verb" in
  create) playbook=''; args=(); titles=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --playbook) playbook=true; shift ;;
        --title) [ "$#" -ge 2 ] || die 'BAD-ARG: --title needs the title'; titles+=("$2"); shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    [ "${#titles[@]}" -gt 0 ] || die 'BAD-ARG: item create needs --title <t>, one or several'
    body=$(fields objective,parent,kind,priority,team,workspace "${args[@]}") || exit 2
    # One title or several: { titles }, each made with the rest of the body, one reply line each.
    body=$(python3 -c 'import json,sys; d = json.loads(sys.argv[1]); d["titles"] = sys.argv[3:]; d["playbook"] = sys.argv[2] == "true" or None; print(json.dumps({k: v for k, v in d.items() if v is not None}))' "$body" "$playbook" "${titles[@]}")
    ronin_item_call POST /api/work-items "$body"; exit $? ;;
  search)
    q=''
    quote() { python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"; }
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --campaign|--team|--holder|--parent|--status|--kind|--text) [ -n "${2:-}" ] || die "BAD-ARG: $1 needs a value"; q="$q&${1#--}=$(quote "$2")"; shift 2 ;;
        --no-parent) q="$q&no_parent=1"; shift ;;
        --archived) q="$q&archived=1"; shift ;;
        --playbook) q="$q&playbook=1"; shift ;;
        *) die "BAD-ARG: item search takes --campaign, --team, --holder, --parent, --no-parent, --status, --kind, --text, --archived, --playbook or --json, not $1" ;;
      esac
    done
    plain search "/api/work-items?${q#&}"; exit $? ;;
  archive) [ "${1:-}" = --done ] && {
      shift; team=''
      if [ "$#" -eq 2 ] && [ "$1" = --team ]; then team=$2; elif [ "$#" -ne 0 ]; then die 'BAD-ARG: item archive takes <ids>, or --done [--team <t>]'; fi
      ronin_item_call POST /api/work-items/archive-done "$(json ${team:+team "$team"})"; exit $?; } ;;
esac
id=${1:-}; [ -n "$id" ] || die "BAD-ARG: item $verb needs the item's id"; shift
# SEVERAL IDS (owner, 2026-11-25): every act but link and checkout reads every leading argument
# that is an id (w12, KAN-65). One id goes to the item's own route; several go to
# /api/work-items/many/<act> { ids }, the same body, each id answered on its own line; read
# reads each in turn.
ids=("$id")
case "$verb" in
  link|checkout) ;;
  *) while [ "$#" -gt 0 ] && [[ $1 =~ ^(w[1-9][0-9]*|[A-Z][A-Z0-9_]+-[1-9][0-9]*)$ ]]; do ids+=("$1"); shift; done ;;
esac
# item_act <act> <method> <body>: the one route for one id, the many route for several.
item_act() {
  if [ "${#ids[@]}" -eq 1 ]; then
    if [ "$1" = delete ]; then ronin_item_call DELETE "/api/work-items/$id" "$3"
    elif [ "$1" = edit ]; then ronin_item_call PUT "/api/work-items/$id" "$3"
    else ronin_item_call "$2" "/api/work-items/$id/$1" "$3"; fi
  else
    ronin_item_call POST "/api/work-items/many/$1" "$(python3 -c 'import json,sys; d = json.loads(sys.argv[1]); d["ids"] = sys.argv[2:]; print(json.dumps(d))' "$3" "${ids[@]}")"
  fi
}
case "$verb" in
  read) [ "$#" -eq 0 ] || die 'BAD-ARG: item read takes only <ids> [--json]'
    # Each in turn, a blank line between; a missing one says so and the rest still read.
    rc=0; first=1
    for one in "${ids[@]}"; do
      [ -n "$first" ] || echo; first=''
      plain read "/api/work-items/$one" || rc=$?
    done
    exit $rc ;;
  edit) [ "$#" -ge 2 ] || die 'BAD-ARG: item edit takes <ids> --field <value> ...'
    body=$(fields title,objective,kind,parent,priority,trello,github "$@") || exit 2; item_act edit PUT "$body" ;;
  transition) [ "$#" -eq 1 ] || { [ "$#" -eq 3 ] && [ "$2" = --note ]; } || die 'BAD-ARG: item transition takes <ids> <status> [--note "<what they can try>"]'
    item_act transition POST "$(json status "$1" ${3:+note "$3"})" ;;
  handover) [ "$#" -ge 1 ] || die 'BAD-ARG: item handover takes <ids> <agent>|team:<name> "<note>" [--to-do] [--flag "<the question>"]'
    to=$1; shift; note=''; todo=''; flag=''
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --to-do) todo=true; shift ;;
        --flag) [ -n "${2:-}" ] || die 'BAD-ARG: --flag needs the question, quoted'; flag=$2; shift 2 ;;
        --*) die "BAD-ARG: item handover takes --to-do or --flag, not $1" ;;
        *) [ -z "$note" ] || die 'BAD-ARG: item handover takes one note, quoted'; note=$1; shift ;;
      esac
    done
    case "$to" in
      team:*) who=(team "${to#team:}") ;;
      none) die 'BAD-ARG: a handover goes to your team (team:<name>) or an Agent, never none' ;;
      *) who=(session "$to") ;;
    esac
    item_act handover POST "$(json "${who[@]}" ${note:+note "$note"} ${todo:+to_do "$todo"} ${flag:+flag "$flag"})" ;;
  handoff) from=''; keep=''
    while [ "$#" -gt 1 ]; do
      case "$2" in
        --from) [ -n "${3:-}" ] || die 'BAD-ARG: --from needs <agent>|team:<name>'; from=$3; set -- "$1" "${@:4}" ;;
        --keep-holding) keep=true; set -- "$1" "${@:3}" ;;
        *) break ;;
      esac
    done
    [ "$#" -eq 1 ] || die 'BAD-ARG: item handoff takes <ids> <agent>|team:<name> [--from <agent>|team:<name>] [--keep-holding]'
    case "$1" in
      none) die 'BAD-ARG: item handoff needs a receiver, an Agent or team:<name>' ;;
      team:*) to=$(json team "${1#team:}" ${from:+from "$from"} ${keep:+keep_holding "$keep"}) ;;
      workspace:*) to=$(json workspace "${1#workspace:}" ${from:+from "$from"} ${keep:+keep_holding "$keep"}) ;;
      *) to=$(json session "$1" ${from:+from "$from"} ${keep:+keep_holding "$keep"}) ;;
    esac
    item_act handoff POST "$to" ;;
  watch|unwatch) [ "$#" -le 1 ] || die "BAD-ARG: item $verb takes <ids> [<agent>|team:<name>]"
    case "${1:-}" in
      '') who=$(json) ;;
      team:*) who=$(json team "${1#team:}") ;;
      *) who=$(json session "$1") ;;
    esac
    item_act "$verb" POST "$who" ;;
  comment)
    if [ "${1:-}" = --edit ]; then
      [ "$#" -eq 3 ] || die 'BAD-ARG: item comment takes <ids> --edit <n> <text>, the text quoted'
      item_act comment POST "$(json edit "$2" text "$3")"
    else
      [ "$#" -eq 1 ] || die 'BAD-ARG: item comment takes <ids> <text>, the text quoted'
      item_act comment POST "$(json text "$1")"
    fi ;;
  flag|unflag) [ "$#" -le 1 ] || die "BAD-ARG: item $verb takes <ids> [<comment>], the comment quoted"
    item_act "$verb" POST "$(json ${1:+comment "$1"})" ;;
  attach)
    remove=''; [ "${1:-}" = --remove ] && { remove=true; shift; }
    [ "$#" -eq 1 ] || die 'BAD-ARG: item attach takes <ids> [--remove] <path>|<url>|plan:<name>'
    # A path is resolved here, against the caller's cwd: the item stores the absolute path.
    # plan:<name> or plan:<workspace>/<name> goes as written: the store resolves it (plan --help).
    case "$1" in http://*|https://*|plan:*) at=$1 ;; *) at=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$1") ;; esac
    item_act attach POST "$(json path "$at" ${remove:+remove true})" ;;
  link)
    remove=''; args=()
    for a in "$@"; do [ "$a" = --remove ] && remove=true || args+=("$a"); done
    [ "${#args[@]}" -eq 2 ] || die 'BAD-ARG: item link takes <id> <type> <id> [--remove], the type as the space names it (Blocks)'
    ronin_item_call POST "/api/work-items/$id/link" "$(json type "${args[0]}" to "${args[1]}" ${remove:+remove true})" ;;
  checkout) [ "$#" -le 1 ] || die 'BAD-ARG: item checkout takes PLAYBOOK-<n> [<agent>|team:<name>], or <live id> --playbook'
    if [ "${1:-}" = --playbook ]; then ronin_item_call POST "/api/work-items/$id/checkout" "$(json playbook true)"
    else ronin_item_call POST "/api/work-items/$id/checkout" "$(json ${1:+to "$1"})"; fi ;;
  archive) [ "$#" -eq 0 ] || die 'BAD-ARG: item archive takes <ids>, or --done [--team <t>]'
    item_act archive POST "$(json)" ;;
  delete) [ "$#" -eq 0 ] || die 'BAD-ARG: item delete takes <ids>'
    item_act delete DELETE "$(json)" ;;
  *) usage >&2; exit 2 ;;
esac
