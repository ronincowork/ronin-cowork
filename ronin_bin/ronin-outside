#!/usr/bin/env bash
# ronin-outside — Ronin's own tools on a machine outside the office (KAN-737): a daimyo's,
# the user's own AI manager. The tool package (bin/ronin-tools-pack) installs this file under
# each tool's name (item, team, edges, session_create, …); called as `item`, it picks the
# office, sets RONIN_URL and RONIN_CLI_TOKEN (the address, and the token sent as the Bearer),
# and runs the real ronin_bin/item beside it. Nothing else differs from inside the office.
#
# Which office: `--office <name>` as the first argument, else RONIN_OFFICE, else RONIN_URL as
# already set, else the one office in the offices file. The file
# (${XDG_CONFIG_HOME:-~/.config}/ronin/offices.json, or RONIN_OFFICES) holds
#   { "<name>": { "url": "https://…", "token": "…" }, … }
set -u
HERE=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
tool=$(basename "$0")
CONFIG=${RONIN_OFFICES:-${XDG_CONFIG_HOME:-$HOME/.config}/ronin/offices.json}

if [ "$tool" = ronin-outside ]; then
  cat <<EOF
ronin-outside — Ronin's tools, reaching an office from this machine.
Run a tool by its name: item, team, edges, session_create, office read, …
  <tool> --office <name> …   use that office from $CONFIG
  RONIN_OFFICE=<name>        the same, for every call
With one office in the file, or RONIN_URL and RONIN_CLI_TOKEN set, no name is needed.
EOF
  exit 0
fi

office=${RONIN_OFFICE:-}
if [ "${1:-}" = --office ]; then
  [ $# -ge 2 ] || { echo "$tool: --office needs a name" >&2; exit 2; }
  office=$2; shift 2
fi
if [ -n "$office" ] || [ -z "${RONIN_URL:-}" ]; then
  picked=$(OFFICE="$office" python3 - "$CONFIG" <<'PY'
import json, os, sys
try: offices = json.load(open(sys.argv[1]))
except FileNotFoundError: sys.exit("no office: set RONIN_URL and RONIN_CLI_TOKEN, or write %s" % sys.argv[1])
except Exception as e: sys.exit("%s is not readable JSON: %s" % (sys.argv[1], e))
name = os.environ["OFFICE"]
if not name:
    if len(offices) != 1: sys.exit("several offices in %s: name one with --office <name> (%s)" % (sys.argv[1], ", ".join(sorted(offices))))
    name = next(iter(offices))
o = offices.get(name)
if not isinstance(o, dict) or not o.get("url"): sys.exit("no office %r in %s (%s)" % (name, sys.argv[1], ", ".join(sorted(offices)) or "none"))
print(o["url"]); print(o.get("token", ""))
PY
) || exit 2
  RONIN_URL=$(printf '%s\n' "$picked" | sed -n 1p)
  RONIN_CLI_TOKEN=$(printf '%s\n' "$picked" | sed -n 2p)
  export RONIN_URL RONIN_CLI_TOKEN
fi
exec "$HERE/$tool" "$@"
