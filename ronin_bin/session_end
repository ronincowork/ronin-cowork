#!/usr/bin/env bash
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" session_end "$@"
# session_end — end YOUR OWN session. The last act of `land` / `delete`.
#
# Usage: session_end [--ignore-items]   — you do not name a session.
#
# This is a HANDOFF, not a procedure. It tells Ronin which pane it is standing in and
# stops there. Ronin resolves that pane to its real session and ends it
# with the same code path the UI's delete button uses. Nothing here knows how a session
# is killed, and it must stay that way: one implementation of the dangerous thing, in
# Ronin, not a second copy in bash that drifts from it. (An earlier version of this file
# held that copy, and a `kill-session -a` in it once ended every session on the box.)
#
# There is no output on success: the session — and this process with it — is gone.
# That silence IS the proof. Never report "session ended" without running this.
set -u
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")

help() {
  cat <<'EOF'
session_end — close this Agent's managed worktrees and archive it: the one way to go

Usage:
  session_end [--ignore-items]

Ronin checks every assigned managed worktree first. Clean worktrees whose tips are already
contained in their Team lines close automatically, including immediately after an
ACCEPTED hand-in; global-dev promotion and a separate worktree close are not required.
Dirty files, pending/rejected hand-ins, unique commits, shared custody, or another
session in the worktree keep every worktree and this Agent alive and print exact NEXT
actions. Work items you hold In Progress or In Review, not flagged, stop you once too, each
named, the same check archive and the UI's Delete make. It is a nudge, never a wall:
  1. Finish the item if you can (In Review is finished when your lead or the owner makes it Done).
  2. If you can't, flag it: item flag <id> "<where it stands; what is missing>".
  3. Clean your desks: commit and hand in.
  4. Then session_end. An item you flagged needs nothing more; --ignore-items goes past the rest.
Each item still goes to the Team, flagged "Ended without handover: <you>, <status>", and the
lead is told once. To Do goes back to your Team by itself. Nothing goes to nobody; the
worktree check still applies.

The end is an archive, not a delete: once the worktrees close, Ronin archives this Agent the
way session_archive does, so an Agent that ended too early comes back with
session_restore <archive-id>. Your lead's notice of the end names the id and the command.
Your items still go to the Team as above; a restored Agent takes back what it wants
(item handoff <id> <you> --from team:<team>) and reopens a worktree with worktree-desk open.
Only a conversation Ronin cannot resume ends outright. Hard Delete stays the owner's.
Related: session_restore --help, worktree-desk --help, item --help.
EOF
}

ignore_items=false
case "$#:${1:-}" in
  0:) ;;
  1:--ignore-items) ignore_items=true ;;
  1:-h|1:--help) help; exit 0 ;;
  *) cat >&2 <<EOF
REFUSED: session_end takes no session name (only --ignore-items) — it ends the session you are in.
Ending a DIFFERENT session is a separate, deliberate act: ask the owner, or use the trash
button in Ronin.
Run session_end --help.
EOF
      exit 4 ;;
esac

# The one fact we contribute. $TMUX_PANE is set by tmux inside every pane; asking tmux
# is the fallback for a subshell that lost it. We deliberately do NOT ask for '#S' — a
# browser viewer would answer with itself. Resolving pane -> session is Ronin's job.
pane="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)}"
[ -n "$pane" ] || { echo "NOT-IN-TMUX: no session to end (are you inside a tmux pane?)" >&2; exit 2; }

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?


response_file=$(mktemp)
trap 'rm -f "$response_file"' EXIT
# 30s outlasts the server's own 25s shutdown budget, so its answer — done or why not — arrives.
body=$(curl -sS -m 30 -o "$response_file" -w '%{http_code}' "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" \
  -X POST "$url/api/harakiri" \
  -H 'content-type: application/json' \
  -d "{\"pane\":\"$pane\",\"ignore_items\":$ignore_items}" 2>&1) || {
  echo "STUCK: could not reach Ronin at $url — your session is still here." >&2
  echo "STUCK: $body" >&2
  echo "STUCK: report to the owner; do not hand-roll a kill." >&2
  exit 5
}

# Every answer that is not success says why: Ronin's own reply is printed after the verdict.
said() { cat "$response_file" >&2; echo >&2; }
case "$body" in
  200) ;;
  401) echo "STUCK: Ronin rejected the request (auth on). Set RONIN_AUTH=user:pass." >&2; said; exit 5 ;;
  404) echo "STUCK: Ronin does not see pane $pane in any session." >&2; said; exit 5 ;;
  409) echo "REFUSED: Ronin kept this Agent and its worktrees open. Complete every NEXT action below, then run session_end again." >&2
       said
       exit 4 ;;
  *)   echo "STUCK: Ronin answered $body — your session is still here. Ronin said:" >&2; said; exit 5 ;;
esac

# Accepted. Now wait to die: the kill lands a moment after the reply. Returning here
# would let a caller carry on and announce an ending that has not happened yet — the
# exact failure this action warns about. If we are still breathing after 15s, say so.
sleep 15
echo "STUCK: Ronin accepted the request but this session is still alive after 15s." >&2
exit 5
