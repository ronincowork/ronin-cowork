#!/usr/bin/env bash
# mcp — any MCP server, at run time: list them, see one's tools, call one. The Ronin Services part
# `mcp` (/api/mcp/*) holds each server's record and key, connects, asks and closes; this tool only
# carries the words. docs/architecture/integrations.md.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/tool-count.sh" mcp "$@"
set -u -o pipefail
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/tool-path.sh"
TOOL_DIR=$(dirname "$SELF")
die() { echo "$1" >&2; exit "${2:-2}"; }
usage() { cat <<'EOF_USAGE'
Usage:
  mcp list                                  the MCP servers set up in Settings: name and what it is for
  mcp tools <name> [<tool>]                 its tools, one line each with their arguments (? optional);
                                            with a tool, that one whole
  mcp call <name> <tool> [--json '<args>']  run a tool; --json - reads the arguments from stdin
  mcp add                                   the integrations Ronin ships ready to set up (Netlify, …)
  mcp add <name>                            set up one of those: its record is written in Settings
                                            and its key asked for on your tile (secret ask)
  mcp add <name> <url|command> [--sign-in key|oauth|none] [--secret <s>] [--send '<header>'|'env NAME']
          [--label <l>] [--description <d>]
                                            add a server: Ronin connects, reads what it is for and
                                            writes its record; without its key yet, the record is
                                            written and it asks for the key (secret ask)
  mcp remove <name>                         its record and its key go
Ronin attaches the key: you never handle it. The key is the secret <name>-api-key unless --secret
names another; it goes as Authorization: Bearer unless --send says otherwise. Adding turns it on
in Settings, so Workspaces made from then on tell their Agents of it. A web API: api add.
Related: secret --help; ronin-help integrations
EOF_USAGE
}
case "${1:-}" in -h|--help|'') usage; exit 0;; esac

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?
BY=$(ronin_session_me 2>/dev/null || id -un)
cmd=$1; shift
json=''; sign_in=''; secret=''; send=''; label=''; description=''; args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json|--sign-in|--secret|--send|--label|--description)
      [ "$#" -ge 2 ] || die "BAD-ARG: $1 needs a value"
      case "$1" in --json) json=$2;; --sign-in) sign_in=$2;; --secret) secret=$2;; --send) send=$2;; --label) label=$2;; --description) description=$2;; esac
      shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

# mcp_call METHOD PATH [JSON]: the lines printed, or the one sentence of what is wrong
# (exit 4 when something is not set, 3 when the server or Ronin failed, 5 unreachable). A key
# not saved leaves its secret's name in $NEED_SECRET.
NEED_SECRET=''
mcp_call() {
  local method=$1 path=$2 body=${3-} out status rc
  local opts=(-sS -m 120 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -X "$method")
  if [ -n "$body" ]; then opts+=(-H 'content-type: application/json' --data-binary @-)
  else opts+=(-G --data-urlencode "by=$BY" --data-urlencode "name=${name-}" --data-urlencode "tool=${tool-}")
  fi
  out=$(printf '%s' "$body" | curl "${opts[@]}" -w '\n%{http_code}' "$url$path") || { echo "UNREACHABLE: Ronin did not answer at $url" >&2; return 5; }
  status=${out##*$'\n'}
  NEED_SECRET=$(printf '%s' "${out%$'\n'*}" | python3 -c 'import json,sys
try: print(json.loads(sys.stdin.read()).get("secret",""))
except Exception: pass' 2>/dev/null)
  printf '%s' "${out%$'\n'*}" | REPLY_STATUS=$status python3 -c '
import json, os, sys
status = os.environ["REPLY_STATUS"]
try: d = json.loads(sys.stdin.read())
except Exception:
    if status == "404":
        print("The MCP broker (a Ronin Services part) is not running here. Use the provider'"'"'s own CLI or API, with its key by secret path.", file=sys.stderr); sys.exit(4)
    print("HTTP %s: Ronin answered without JSON" % status, file=sys.stderr); sys.exit(3)
if not d.get("ok"):
    print(d.get("error") or "HTTP %s" % status, file=sys.stderr); sys.exit(4 if d.get("missing") else (2 if status == "400" else 3))
print("\n".join(d.get("lines", [])))
'
}
body() { python3 -c 'import json, sys; a = sys.argv[1:]; print(json.dumps({a[i]: a[i+1] for i in range(0, len(a), 2) if a[i+1] != ""}))' "$@"; }

case "$cmd" in
  list) [ "$#" -eq 0 ] || die 'BAD-ARG: mcp list takes no words'; mcp_call GET /api/mcp ;;
  tools)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die 'BAD-ARG: mcp tools <name> [<tool>]'
    name=$1; tool=${2-}; mcp_call GET /api/mcp/tools ;;
  call)
    [ "$#" -eq 2 ] || die "BAD-ARG: mcp call <name> <tool> [--json '{…}'] (mcp tools <name> lists them)"
    [ "$json" = '-' ] && json=$(cat)
    payload=$(BY=$BY N=$1 T=$2 J=${json:-'{}'} python3 -c '
import json, os, sys
try: args = json.loads(os.environ["J"])
except Exception: print("BAD-ARG: --json is not JSON", file=sys.stderr); sys.exit(2)
print(json.dumps({"by": os.environ["BY"], "name": os.environ["N"], "tool": os.environ["T"], "args": args}))') || exit 2
    mcp_call POST /api/mcp/call "$payload" ;;
  add)
    [ "$#" -le 2 ] || die 'BAD-ARG: mcp add [<name> [<url|command>]] (mcp --help)'
    if [ "$#" -eq 0 ]; then
      # The starting records Ronin ships: one line each.
      curl -sS -m 30 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" "$url/api/mcp/stock" | python3 -c '
import json, sys
try: d = json.loads(sys.stdin.read())
except Exception: print("The MCP broker (a Ronin Services part) is not running here.", file=sys.stderr); sys.exit(4)
for r in d.get("stock", []): print("%s: %s" % (r["name"], r.get("description") or r.get("label")))
print("mcp add <name> sets one up and asks for its key.")' || exit $?
      exit 0
    fi
    if [ "$#" -eq 1 ]; then
      label=${label:-$1}
      mcp_call POST /api/mcp/stock "$(body by "$BY" name "$1")"; rc=$?
    else
      payload=$(body by "$BY" name "$1" reach "$2" sign_in "$sign_in" secret "$secret" send "$send" label "$label" description "$description")
      mcp_call POST /api/mcp/add "$payload"; rc=$?
    fi
    # Add now, authenticate later: the record is written; ask for a key it still needs.
    if [ "$rc" -eq 0 ] && [ -n "$NEED_SECRET" ]; then
      echo "Asking for $NEED_SECRET on your tile…" >&2
      saved=$("$TOOL_DIR/secret" ask "$NEED_SECRET" --for "${label:-$1} key") || exit 4
      echo "$saved"
    fi
    exit "$rc" ;;
  remove)
    [ "$#" -eq 1 ] || die 'BAD-ARG: mcp remove <name>'
    mcp_call POST /api/mcp/remove "$(body by "$BY" name "$1")" ;;
  *) die "BAD-ARG: mcp $cmd: list, tools, call, add or remove (mcp --help)" ;;
esac
