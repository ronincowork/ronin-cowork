#!/bin/sh
# GET-RONIN — the one-line door. The README's install command fetches THIS file and
# pipes it to sh; everything a stranger's terminal needs is downstream of here.
#
#   curl -fsSL https://raw.githubusercontent.com/ronincowork/ronin-cowork/master/scripts/get-ronin | sh
#
# What it does, and all it does: pick the bundled artifact for this box's platform,
# download it with its checksum, verify, then hand over to the release's own
# bin/ronin-update (layout, current-symlink) and setup.sh (units, URL, browser).
# The bundle carries its own node, tmux, and node_modules, so this script may assume
# NOTHING is installed — it uses only sh, curl/wget, tar, and uname.
#
#   RONIN_HOME=<dir>          install home (default: the user root, asked of the
#                             release's own store table — ronin-store --root user)
#   RONIN_RELEASE_REPO=<slug> release feed (default ronincowork/ronin-cowork)
set -eu

REPO="${RONIN_RELEASE_REPO:-ronincowork/ronin-cowork}"

say() { printf '%s\n' "$*"; }
die() { printf 'get-ronin: %s\n' "$*" >&2; exit 1; }

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64)              PLAT=linux-x64 ;;
  Linux-aarch64|Linux-arm64) PLAT=linux-arm64 ;;
  Darwin-arm64)              PLAT=darwin-arm64 ;;
  Darwin-x86_64)             PLAT=darwin-x64 ;;
  MINGW*|MSYS*|CYGWIN*)      die "on Windows, Ronin runs inside WSL2: run 'wsl --install' in PowerShell once, then run this same command inside the WSL shell (docs/DEPENDENCY_BUNDLE_INSTALL.md)" ;;
  *)                         die "unsupported platform: $(uname -s) $(uname -m)" ;;
esac

fetch() { # <url> <outfile>
  if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 3 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else die "neither curl nor wget is on this box"; fi
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

say "==> asking $REPO for its latest release"
fetch "https://api.github.com/repos/$REPO/releases/latest" "$WORK/latest.json"
VER="$(sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' "$WORK/latest.json" | head -1)"
[ -n "$VER" ] || die "could not learn the latest release"

NAME="ronin-cowork-$VER-$PLAT.tar.gz"
say "==> fetching $NAME"
fetch "https://github.com/$REPO/releases/download/$VER/$NAME" "$WORK/$NAME" \
  || die "release $VER has no bundled artifact for $PLAT (a release predating the bundle?) — see the git path in the README"
fetch "https://github.com/$REPO/releases/download/$VER/SHA256SUMS" "$WORK/SHA256SUMS"

WANT="$(awk -v n="$NAME" '$2==n{print $1}' "$WORK/SHA256SUMS")"
[ -n "$WANT" ] || die "SHA256SUMS carries no line for $NAME"
[ "$(sha256_of "$WORK/$NAME")" = "$WANT" ] || die "CHECKSUM MISMATCH on $NAME — refusing to install; the download is not the release"
say "==> checksum verified"

# The release's own machinery does the actual install: ronin-update owns the
# <home>/releases layout and the current-symlink, setup.sh owns everything after.
# The install home is never spelled by hand (docs/stores.md) — the release's own
# store table answers where the user root lives on THIS machine.
tar -xzf "$WORK/$NAME" -C "$WORK"
TREE="$WORK/ronin-cowork-$VER"
HOME_DIR="${RONIN_HOME:-$("$TREE/bin/ronin-store" --root user)}"
"$TREE/bin/ronin-update" --file "$WORK/$NAME" --home "$HOME_DIR"
cd "$HOME_DIR/current"
exec ./setup.sh
