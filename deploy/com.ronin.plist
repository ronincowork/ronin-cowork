<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd agent template. setup.sh renders paths, installs this file in
  ~/Library/LaunchAgents, and starts Ronin in the owner's launchd domain.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ronin</string>
  <key>WorkingDirectory</key><string>__REPO_DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_DIR__/npm</string>
    <string>start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__TMUX_DIR__:__NODE_DIR__:/usr/local/bin:/usr/bin:/bin</string>
    <key>NODE_ENV</key><string>production</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
