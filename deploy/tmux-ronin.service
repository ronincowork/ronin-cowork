# systemd --user unit for tmux-ronin. THIS FILE IS THE UNIT — edit it here.
#
# `./setup.sh` copies it to ~/.config/systemd/user/tmux-ronin.service, filling in two
# placeholder tokens as it goes: the repo directory and the node bin directory (see
# render_unit() in setup.sh). setup.sh holds no unit text of its own, so there is
# nothing for this file to drift away from. Change something here, re-run ./setup.sh.
# To install without running the rest of setup.sh: copy this file into
# ~/.config/systemd/user/, replace the two tokens by hand, `systemctl --user
# daemon-reload`, then `systemctl --user enable --now tmux-ronin`.
#
# Keep it running without an active login:
#   sudo loginctl enable-linger "$USER"

[Unit]
Description=tmux-ronin — browser grid of tmux sessions
After=network-online.target
Wants=network-online.target
# The tmux server must exist BEFORE ronin can be the one to start it: a server
# started by this service lives in this service's cgroup, and stopping the service
# then kills every session on the box. See deploy/tmux-server.service.
Wants=tmux-server.service
After=tmux-server.service

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
# If the server died since tmux-server.service last ran, that unit is still
# "active (exited)" and Wants= won't re-run it. Restart it only when there is no
# server at all — i.e. when there are no sessions to lose. --no-block is required:
# a blocking systemctl call for a unit we are ordered After= can deadlock our own
# activation. Ronin also re-checks before it creates any session (src/host-guard.ts),
# so the brief async window costs nothing.
ExecStartPre=-/bin/sh -c 'tmux list-sessions >/dev/null 2>&1 || systemctl --user --no-block restart tmux-server.service'
# Node bin dir, resolved to a stable path (fnm/nvm shims are ephemeral).
Environment=PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# Reads __REPO_DIR__/.env for PORT / BIND / GRID_USER / GRID_PASS / TMUX_WINDOW_SIZE / TMUX_MOUSE
ExecStart=__NODE_DIR__/npm start
# RENDERING GATE — check that the page actually works after every start, whether or
# not anybody remembered to. Detached (`&`) so it never delays the unit, and `-` so a
# failing gate can never wedge the service into a restart loop: it REPORTS.
#   journalctl --user -u tmux-ronin -f | grep 'RONIN GATE'
# For a deploy whose exit code you want to act on, use bin/ronin-deploy.
# Needs a headless browser (Playwright Chromium — see docs/host-tools.md); absent, the
# gate says so and the service is unaffected.
ExecStartPost=-/bin/sh -c '__REPO_DIR__/libexec/ronin-gate &'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
