#!/usr/bin/env bash
# Internal read implementation for `work-record`.
# Usage: work-record read                      your letter, teaching lines and all
#        work-record read --json               just the block, for a machine
#        work-record read --session <name> …   another session (dial 👁 read or 🤖 write)
#
# NO ARGUMENTS, BY DESIGN. You do not name a session and you do not learn a path: the
# tool knows which pane it is running in, and where the file lives is Ronin's business.
# Both facts have already moved once. An agent that memorised either would keep using it
# afterwards, which is how a wrong path becomes a wrong record becomes a tile that lies —
# and coordinators had begun pasting shell incantations to derive session keys by hand.
#
# Read-only. `work-record update_record` is the other half, and there is no third tool.
set -u

die() { printf '%s\n' "$*" >&2; exit 3; }
help() {
  cat <<'EOF'
work-record read — read a session's work record

Usage:
  work-record read
  work-record read --json
  work-record read --session <name> [--json]

Common tasks:
  Use the bare form for the complete record with the items held and their status,
  and --json for its data block.

This tool reads records; it does not author progress. Reading may refresh the
machine-owned Team summary in the record. Related: work-record update_record --help;
item read <id>
EOF
}
case "${1-}" in
  -h|--help) [ "$#" -eq 1 ] || die "work-record read: --help takes no other arguments. Run work-record read --help."; help; exit 0 ;;
esac

# WHICH SESSION AM I — and it must NEVER guess.
#
# This function had a fallback that silently wrote one session's ladder into another's
# letter, destroying it. `tmux display-message -p -t "$TMUX_PANE"` looks safe until
# TMUX_PANE is EMPTY — which it is in some agents' tool shells — because `-t ""` does not
# fail. It answers for the ATTACHED CLIENT: whichever tile the owner happens to have
# focused in the browser at that instant. Writes followed the owner's mouse. The only
# symptom was one line of output nobody reads, and a letter was lost.
#
# Three sources, each authoritative, none the attached client — resolved by the one
# ronin_session_me in tool-path.sh, shared with every tool that acts on its own letter:
#   TMUX_PANE  the pane this shell runs in -> its window -> the non-viewer session holding it
#   $TMUX      socket,pid,SESSION_ID — set for any process started inside a session
#   the path   <session-commands>/<session>/<tool>, the directory a born session reaches
#              its tools through — for the tool shells that are not inside tmux at all
# If none answers, DIE. A tool that cannot tell whose letter it is has exactly one
# correct behaviour, and it is not "pick the one on screen".
me() {
  ronin_session_me && return 0
  die "work-record read: cannot tell which session this is — TMUX_PANE and \$TMUX are both unset, and this
  was not run through a session's own command directory.
  Refusing rather than guessing: this used to fall back to the focused tile and wrote one
  session's ladder into another's letter. Pin the pane and retry:
    TMUX_PANE=\$(tmux list-panes -t <your-session> -F '#{pane_id}' | head -1) work-record read ..."
}

# <name> -> the session KEY, by EXACT name.
#
# Not `display-message -t <name>`: that prefix-matches (so `tegami` could answer for
# `tegami_probe`), and the `=name` exact-match form returns EMPTY on this tmux — which
# does not fail, it just yields a wrong path. One list, one exact match, no guessing.
#
# Prefers the stamped @ronin-key so a rename cannot change the answer; falls back to
# <name>-<created>, which the recorder derives identically with no Ronin involved.
key_of() {
  local row stamped created
  row=$(tmux list-sessions -F '#{session_name}	#{@ronin-key}	#{session_created}' 2>/dev/null \
        | awk -F'	' -v n="$1" '$1==n {print; exit}')
  [ -n "$row" ] || die "work-record read: no such session: $1"
  stamped=$(printf '%s' "$row" | cut -f2)
  created=$(printf '%s' "$row" | cut -f3)
  if   [ -n "${stamped// /}" ]; then printf '%s\n' "$stamped"
  elif [ -n "${created// /}" ]; then printf '%s\n' "$1-$created"
  else printf '%s\n' "$1"; fi
}

MODE=block
TARGET=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json)    MODE=json ;;
    --session) shift; TARGET=${1-} ;;
    *) die "work-record read: unknown argument: $1. Run work-record read --help." ;;
  esac
  shift
done

. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/../ronin_bin/tool-path.sh"
RONIN_TOOL_INVOKED=${WORK_RECORD_INVOKED:-$RONIN_TOOL_INVOKED}
if [ -n "$TARGET" ]; then
  NAME=$TARGET
else
  NAME=$(me) || exit 3
fi
# Where the session record lives on THIS machine — asked, never spelled. See docs/stores.md.
STORE="$(cd "$(dirname "$SELF")/../bin" && pwd)/ronin-store"
[ -x "$STORE" ] || STORE=ronin-store
FILE="$("$STORE" session)/$(key_of "$NAME")/tegami.md"
[ -f "$FILE" ] || die "work-record read: @$NAME has no letter yet — Ronin seeds one within a minute."

# THE AGENT READING — what this session holds and watches, with each item's status, every held
# item's attachments, and for a lead each team's items (what the team and each member hold and
# watch) — comes from Ronin, derived from the work item store, never from this file.
TOOL_DIR="$(cd "$(dirname "$SELF")/../ronin_bin" && pwd)"
. "$TOOL_DIR/ronin-http.sh"
# In a file, never the environment: a big team's reading passes the 128 KB a single env
# string may hold, and every exec after it fails ("Argument list too long").
READING=$(mktemp) || die "work-record read: no temporary file"
trap 'rm -f "$READING"' EXIT
if ronin_connect 2>/dev/null; then
  curl -sS -m 15 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$READING" "$url/api/work-items?session=$NAME" 2>/dev/null || : > "$READING"
fi
export READING
# THE RECORD'S OWN DOCUMENTS: the session's drop/, a link read as the document it names
# (work-record add_doc holding no item; src/tegami-read.ts dropped). Listed before the
# held items' attachments, as the tile's Docs lists them.
OWN_DOCS=$(python3 - "$(dirname "$FILE")/drop" <<'PY'
import json, os, sys
d = sys.argv[1]
names = sorted(n for n in os.listdir(d) if not n.startswith(".")) if os.path.isdir(d) else []
print(json.dumps([os.readlink(os.path.join(d, n)) if os.path.islink(os.path.join(d, n)) else os.path.join(d, n) for n in names]))
PY
)
export OWN_DOCS
BLOCK=$(awk '/^```/{f=!f; if(f) next; else exit} f' "$FILE")
if [ "$MODE" = json ]; then
  # The letter block with the reading beside it: "items" what is held, "attachments"
  # theirs, "documents" the record's own. Derived, never written back.
  printf '%s' "$BLOCK" | python3 -c '
import json, os, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit("work-record read: the letter block does not parse")
try: r = json.load(open(os.environ["READING"]))
except Exception: r = {}
own = json.loads(os.environ.get("OWN_DOCS") or "[]")
d["documents"] = own
if r.get("ok"):
    d["attachments"] = r.get("attachments") or []
    d["items"] = [{k: i.get(k) for k in ("id", "title", "level", "kind", "status", "flagged", "parent")} for i in r.get("items") or []]
    d["watching"] = [{k: i.get(k) for k in ("id", "title", "level", "kind", "status", "flagged", "parent")} for i in r.get("watching") or []]
    d["layers"] = r.get("layers") or []
    brief = lambda items: [{k: i.get(k) for k in ("id", "title", "level", "kind", "status", "flagged", "parent")} for i in items or []]
    if r.get("teams"):
        d["team_items"] = [{"team": t["team"], "items": brief(t.get("items")), "watching": brief(t.get("watching")),
            "members": [{"name": m["name"], "items": brief(m.get("items")), "watching": brief(m.get("watching"))} for m in t.get("members") or []]} for t in r["teams"]]
print(json.dumps(d, indent=2, ensure_ascii=False))
'
else
  cat "$FILE"
  python3 -c '
import json, os
try: r = json.load(open(os.environ["READING"]))
except Exception: r = {}
if not r.get("ok"):
    print("\n(Ronin did not answer: the work items you hold are not shown.)"); raise SystemExit
items = r.get("items") or []
# OPEN ITEMS ONLY (owner, 2026-11-05; KAN-271): a Done item waiting for the five-day archive is
# off the open lists at once; under each list it is counted on one line, ids only, newest first.
import datetime, re
def since(i):
    for l in reversed(i.get("trail") or []):
        if (l.get("op") == "status" and l.get("to") == "Done") or (l.get("op") == "edit" and re.search(r"(^|, |; )status Done(,|;|$)", l.get("note") or "")):
            return l.get("at")
    return (i.get("created") or {}).get("at")
def ago(at):
    try: s = (datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(at.replace("Z", "+00:00"))).total_seconds()
    except Exception: return ""
    return "%d min ago" % max(1, s // 60) if s < 3600 else "%d h ago" % (s // 3600) if s < 172800 else "%d days ago" % (s // 86400)
def status(i):
    if i.get("status") != "Done": return i.get("status")
    when = ago(since(i) or "")
    return "Done · %s" % when if when else "Done"
def listed(held, watched=()):
    for i in held or []:
        if i.get("status") != "Done": print(line(i))
    for i in watched or []:
        if i.get("status") != "Done": print(line(i) + " · watched")
    done = sorted([i for i in list(held or []) + list(watched or []) if i.get("status") == "Done"], key=lambda i: since(i) or "", reverse=True)
    ids = list(dict.fromkeys(i["id"] for i in done))
    if ids: print("- Done, not yet archived: %d (%s%s)" % (len(ids), ", ".join(ids[:8]), ", …" if len(ids) > 8 else ""))
# A TEAM, IN FOUR LAYERS (KAN-331; src/team-layers.ts): each Team you are on, one line per layer,
# read live where it lives, each naming the command that reads it whole.
one = lambda h: "@" + h[6:] if h.startswith("agent:") else "Team " + h[5:] if h.startswith("team:") else h
who = lambda h: ", ".join(one(x.strip()) for x in h.split(",") if x.strip()) or "nobody"
for l in r.get("layers") or []:
    print("\n## Team %s" % l["team"])
    w = l.get("workspace")
    if w:
        print("- Workspace %s: %s · repos %s · folders %s · integrations %s (work-record workspace list)" % (w.get("title") or w["name"], w.get("objective") or "no objective", ", ".join(w.get("repos") or []) or "none", ", ".join(w.get("folders") or []) or "none", ", ".join(str(i.get("provider")) for i in w.get("integrations") or []) or "none"))
    else:
        print("- Workspace: none (the Team is launched in no Workspace)")
    print("- Plans: %s (plan read <name>)" % ("; ".join("%s · %s · %s" % (p["name"], p["status"], ("Team %s" % p["team"]) if p.get("team") else "no Team") for p in l.get("plans") or []) or "none"))
    print("- Canvases: %s (canvas read <name>)" % ("; ".join(c["name"] for c in l.get("canvases") or []) or "none"))
    print("- Epics: %s (item read <id>)" % ("; ".join("%s %s · %s · %s" % (e["id"], e["title"], who(e.get("holder") or ""), e["status"]) for e in l.get("epics") or []) or "none"))
print("\n## Work items you hold" if items else "\n## You hold no work items — your team holds your work; item create puts it there" if r.get("teams") else "\n## You hold no work items — item create --parent <epic> makes one yours")
line = lambda i: "- %s %s · %s%s" % (i["id"], i["title"], status(i), " · flagged" if i.get("flagged") else "")
listed(items)
if r.get("watching"):
    print("\n## Work items you watch")
    listed(r["watching"])
for t in r.get("teams") or []:
    print("\n## Work items of team %s" % t["team"])
    for who, held, watched in [("The team", t.get("items"), t.get("watching"))] + [(m["name"], m.get("items"), m.get("watching")) for m in t.get("members") or []]:
        if not held and not watched: continue
        print("\n### %s" % who)
        listed(held, watched)
docs = list(dict.fromkeys(json.loads(os.environ.get("OWN_DOCS") or "[]") + (r.get("attachments") or [])))
if docs:
    print("\n## Documents\n" + "\n".join("- " + doc for doc in docs))
'
fi
