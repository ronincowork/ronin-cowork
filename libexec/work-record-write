#!/usr/bin/env bash
# Internal write implementation for `work-record`.
# Usage: work-record update_record < record.json                      your own, whole block on stdin
#        work-record update_record --on_tangent                       stepped off your ladder
#        work-record update_record --on_track                         back on it
#
# WHERE THINGS LIVE. The letter (tegami.md) keeps objective, mandate, repos, holds and
# ladder_state. Work items (no ladder: Jira has none) and their attachments are the item
# tool's, the item always named; this tool keeps only what is about the Agent.
#
# FIELD VERBS — one field, your own session, no block. Several may be combined in one
# call; they apply in order, through the same validator as a whole-block save, so
# "holds" and "teams" are carried through untouched.
#        work-record update_record --objective <text>                 your objective sentence
#        work-record update_record --repo <repo>:<branch>             add or keep a checkout row
#        work-record update_record --unrepo <repo>[:<branch>]         remove one
#        cat <<'EOF' | work-record update_record
#        { "objective": "…", "repos": [ … ] }
#        EOF
#
# NO SESSION ARGUMENT, BY DESIGN — yours is the only letter you can write, the tool
# knows which pane it is running in, and you never learn the path. A session writes its own letter
# and no one else's — same asymmetry as the dials (write own, read any at dial ≥ read).
#
# What you send is the block: { "objective": "…", "repos": [ … ] }. The teaching lines
# are Ronin's and are rewritten every time, so you cannot lose them and need not preserve
# them by hand. What IS checked is the shape.
set -u

die() { printf '%s\n' "$*" >&2; exit 3; }
help() {
  cat <<'EOF'
work-record update_record — update the current session's work record

Usage:
  work-record update_record --objective <text>
  work-record update_record --repo <repo-or-url>[:<branch>] | --unrepo <repo-or-url>[:<branch>]
  work-record update_record --on_tangent | --on_track
  work-record update_record < work-record.json

--objective changes the objective. For repository URLs and branches, use work-record
workspace add|remove|list; its --branch flag avoids URL ambiguity. A work item's ladder,
documents and fields are the item tool's, the item always named: item --help.

The tool validates record shape but not progress claims. It never edits another
session. Related: work-record read; item --help
EOF
}

case "${1-}" in
  -h|--help) [ "$#" -eq 1 ] || die "work-record update_record: --help takes no other arguments. Run work-record update_record --help."; help; exit 0 ;;
esac

# WHICH SESSION AM I — and it must NEVER guess.
#
# This function had a fallback that silently wrote one session's ladder into another's
# letter, destroying it. `tmux display-message -p -t "$TMUX_PANE"` looks safe until
# TMUX_PANE is EMPTY — which it is in some agents' tool shells — because `-t ""` does not
# fail. It answers for the ATTACHED CLIENT: whichever tile the owner happens to have
# focused in the browser at that instant. Writes followed the owner's mouse. The only
# symptom was one line of output nobody reads, and a letter was lost.
#
# Three sources, each authoritative, none the attached client — resolved by the one
# ronin_session_me in tool-path.sh, shared with every tool that acts on its own letter:
#   TMUX_PANE  the pane this shell runs in -> its window -> the non-viewer session holding it
#   $TMUX      socket,pid,SESSION_ID — set for any process started inside a session
#   the path   <session-commands>/<session>/<tool>, the directory a born session reaches
#              its tools through — for the tool shells that are not inside tmux at all
# If none answers, DIE. A tool that cannot tell whose letter it is has exactly one
# correct behaviour, and it is not "pick the one on screen".
me() {
  ronin_session_me && return 0
  die "work-record update_record: cannot tell which session this is — TMUX_PANE and \$TMUX are both unset, and this
  was not run through a session's own command directory.
  Refusing rather than guessing: this used to fall back to the focused tile and wrote one
  session's ladder into another's letter. Pin the pane and retry:
    TMUX_PANE=\$(tmux list-panes -t <your-session> -F '#{pane_id}' | head -1) work-record update_record ..."
}

# <name> -> the session KEY, by EXACT name.
#
# Not `display-message -t <name>`: that prefix-matches (so `tegami` could answer for
# `tegami_probe`), and the `=name` exact-match form returns EMPTY on this tmux — which
# does not fail, it just yields a wrong path. One list, one exact match, no guessing.
#
# Prefers the stamped @ronin-key so a rename cannot change the answer; falls back to
# <name>-<created>, which the recorder derives identically with no Ronin involved.
key_of() {
  local row stamped created
  row=$(tmux list-sessions -F '#{session_name}	#{@ronin-key}	#{session_created}' 2>/dev/null \
        | awk -F'	' -v n="$1" '$1==n {print; exit}')
  [ -n "$row" ] || die "work-record update_record: no such session: $1"
  stamped=$(printf '%s' "$row" | cut -f2)
  created=$(printf '%s' "$row" | cut -f3)
  if   [ -n "${stamped// /}" ]; then printf '%s\n' "$stamped"
  elif [ -n "${created// /}" ]; then printf '%s\n' "$1-$created"
  else printf '%s\n' "$1"; fi
}

# Where the session record lives on THIS machine. Asked, never spelled: this file used to
# hardcode the path while the rest of Ronin resolved it, so moving the store sent the
# letters one way and the tape the other. See docs/stores.md.
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/../ronin_bin/tool-path.sh"
RONIN_TOOL_INVOKED=${WORK_RECORD_INVOKED:-$RONIN_TOOL_INVOKED}
TOOL_DIR="$(cd "$(dirname "$SELF")/../ronin_bin" && pwd)"
STORE="$(cd "$(dirname "$SELF")/../bin" && pwd)/ronin-store"
[ -x "$STORE" ] || STORE=ronin-store
SESSION_STORE="$("$STORE" session)"

# THE RECORD'S OWN DOCUMENTS — `work-record add_doc` with no item held, and its --remove.
#
# Not a field of the letter: a document on the record is a link in the session's own drop/,
# the folder the tile's Docs already lists beside the held items' attachments (src/tegami-read.ts,
# dropped). The link's target is the document, so the list shows the document's own path.
# --remove takes off only a link; a file the owner dropped stays theirs.
case "${1-}" in
  --doc-add|--doc-remove)
    [ "$#" -eq 2 ] && [ -n "$2" ] || die "work-record update_record: $1 takes one <path>|<url>"
    NAME=$(me) || exit 3
    DROP="$SESSION_STORE/$(key_of "$NAME")/drop"
    python3 - "$DROP" "$1" "$2" "$NAME" <<'DOCMARK'
import datetime, os, re, sys
drop, verb, doc, name = sys.argv[1:5]
if not re.match(r"https?://", doc):
    doc = os.path.abspath(os.path.expanduser(doc))
links = [os.path.join(drop, n) for n in (sorted(os.listdir(drop)) if os.path.isdir(drop) else []) if not n.startswith(".")]
mine = [p for p in links if os.path.islink(p) and os.readlink(p) == doc]
if verb == "--doc-remove":
    if not mine:
        print("BAD-ARG: %s is not on your work record; work-record read lists it" % doc, file=sys.stderr); sys.exit(2)
    for p in mine: os.unlink(p)
    print("@%s's work record has %s removed" % (name, doc)); sys.exit(0)
if not doc.startswith("http") and not os.path.exists(doc):
    print("BAD-ARG: no such file: %s" % doc, file=sys.stderr); sys.exit(2)
if mine:
    print("@%s's work record has %s" % (name, doc)); sys.exit(0)
os.makedirs(drop, exist_ok=True)
# Named as a browser drop is (src/routes/drop-api.ts dropName), so the folder sorts by arrival.
base = re.sub(r"^[._]+", "", re.sub(r"[^A-Za-z0-9._-]+", "_", os.path.basename(doc.rstrip("/"))))[-120:] or "file"
stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")
link, n = os.path.join(drop, "%s-%s" % (stamp, base)), 1
while os.path.lexists(link):
    n += 1; link = os.path.join(drop, "%s-%d-%s" % (stamp, n, base))
os.symlink(doc, link)
print("@%s's work record has %s" % (name, doc))
DOCMARK
    exit $? ;;
esac

STATE=""
# Field verbs collect here as "verb<US>arg<US>arg" and apply in order, after the parse.
US=$(printf '\037'); EDITS=()
need() { [ -n "${2-}" ] || die "work-record update_record: $1 needs a value: work-record update_record $1 $3"; }
while [ $# -gt 0 ]; do
  case "$1" in
    --on_track)   STATE=on_track ;;
    --on_tangent) STATE=on_tangent ;;
    --objective)  need "$1" "${2-}" "<text>";        EDITS+=("objective$US$2"); shift ;;
    --repo)       need "$1" "${2-}" "<repo-or-url>[:<branch>]"; EDITS+=("repo$US$2"); shift ;;
    --unrepo)     need "$1" "${2-}" "<repo-or-url>[:<branch>]"; EDITS+=("unrepo$US$2"); shift ;;
    --repo-pair)  need "$1" "${2-}" "<repo-or-url> <branch>"; EDITS+=("repo-pair$US$2$US${3-}"); shift 2 ;;
    --unrepo-pair) need "$1" "${2-}" "<repo-or-url> <branch>"; EDITS+=("unrepo-pair$US$2$US${3-}"); shift 2 ;;
    *) die "work-record update_record: unknown argument: $1. Run work-record update_record --help." ;;
  esac
  shift
done
if [ ${#EDITS[@]} -gt 0 ] && [ -n "$STATE" ]; then
  die "work-record update_record: field verbs travel alone — not with --on_track/--on_tangent."
fi

# THE STATE SWITCH — one word, your own session, no block.
#
# work-record update_record otherwise takes the whole letter on stdin, and a session mid-riff will not
# re-emit its entire block to say "back in ten minutes". A switch that costs a rewrite is
# decoration; this one costs a word, which is the difference between a key that gets used
# and a key that gets documented.
if [ -n "$STATE" ]; then
  NAME=$(me) || exit 3
  SFILE="$SESSION_STORE/$(key_of "$NAME")/tegami.md"
  [ -f "$SFILE" ] || die "work-record update_record: you have no letter yet."
  python3 - "$SFILE" "$STATE" "$NAME" <<'STATEMARK' || exit 3
import json, os, re, sys
src, want = sys.argv[1], sys.argv[2]
text = open(src).read()
m = re.search(r"```(?:json)?\s*\n([\s\S]*?)\n```", text)
if not m:
    sys.exit("work-record update_record: no json block in your letter")
d = json.loads(m.group(1))
# on_track is the ABSENCE of the key, not a value written into it: the normal case should
# leave no trace, and a letter that never mentions it is on track by definition.
if want == "on_track":
    d.pop("ladder_state", None)
else:
    d["ladder_state"] = want
# "holds" and "at" are in this list because this path rebuilds the whole block from a
# fixed set of keys, so a key missing from it is a key this switch DELETES.
block = json.dumps({k: d[k] for k in ("objective", "mandate", "teams", "configuration", "repos", "holds", "ladder_state", "at") if k in d},
                   indent=2, ensure_ascii=False)
tmp = src + ".sw"
open(tmp, "w").write(text[:m.start(1)] + block + text[m.end(1):])
os.replace(tmp, src)
print("work-record update_record: @%s %s" % (sys.argv[3], want.replace("_", " ")))
STATEMARK
  exit 0
fi

# `|| exit 3` is the refusal itself: die inside $(…) ends only the subshell, and without it
# the tool went on with an empty name, wrote <store>/tegami.md and reported the save.
NAME=$(me) || exit 3
DIR="$SESSION_STORE/$(key_of "$NAME")"
FILE="$DIR/tegami.md"

LETTER_EDITS=(${EDITS[@]+"${EDITS[@]}"})
if [ ${#LETTER_EDITS[@]} -gt 0 ]; then
  # THE FIELD VERBS. Read the current block, apply each edit in order, and hand the result
  # to the validator below exactly as if the agent had sent it on stdin. One validator,
  # one save path: a verb can never write a shape the block form would refuse, and it
  # inherits the carry-through of "at", "holds" and "teams" for free.
  PREVB=$(awk '/^```/{f=!f; if(f) next; else exit} f' "$FILE" 2>/dev/null)
  BODY=$(RONIN_PREV_BLOCK="$PREVB" python3 - "${LETTER_EDITS[@]}" <<'EDIT'
import json, os, sys
US = "\037"
# The block arrives in the environment: stdin is this script (the heredoc), so a pipe
# would be swallowed by it.
try:
    d = json.loads(os.environ.get("RONIN_PREV_BLOCK") or "{}")
except Exception:
    d = {}
if not isinstance(d, dict):
    d = {}
out = {k: d[k] for k in ("objective", "mandate", "repos", "ladder_state") if k in d}
said = []
def repo_argument(raw, existing, removing=False):
    value = raw.strip()
    if not value:
        sys.exit("work-record update_record: repository name or URL is empty. Run work-record --help.")
    # A URL contains its own colon. Prefer an exact recorded repository before treating
    # the final colon as a branch separator; this also handles URLs without a branch.
    if removing and any(isinstance(r, dict) and r.get("repo") == value for r in existing):
        return value, ""
    repo, separator, branch = value.rpartition(":")
    if not separator or (value.endswith(".git") and ("://" in value or "@" in value)):
        return value, ""
    if branch.startswith("//") or ("/" in branch and ("://" in value or "@" in value) and ".git:" not in value):
        return value, ""
    return repo.strip(), branch.strip()

for raw in sys.argv[1:]:
    f = raw.split(US)
    verb, args = f[0], f[1:]
    if verb == "objective":
        out["objective"] = args[0].strip(); said.append("objective set")
    elif verb in ("repo", "repo-pair"):
        repos = out.setdefault("repos", [])
        repo, branch = (args[0].strip(), args[1].strip()) if verb == "repo-pair" else repo_argument(args[0], repos)
        if not repo:
            sys.exit("work-record update_record: --repo needs a repository name or URL. Run work-record --help.")
        if not any(isinstance(r, dict) and r.get("repo") == repo and r.get("branch", "") == branch for r in repos):
            repos.append({"repo": repo, "branch": branch})
            said.append("repository %s%s listed" % (repo, ":" + branch if branch else ""))
        else:
            said.append("repository %s%s already listed; unchanged" % (repo, ":" + branch if branch else ""))
    elif verb in ("unrepo", "unrepo-pair"):
        repo, branch = (args[0].strip(), args[1].strip()) if verb == "unrepo-pair" else repo_argument(args[0], out.get("repos") or [], removing=True)
        before = len(out.get("repos") or [])
        out["repos"] = [r for r in (out.get("repos") or [])
                        if not (isinstance(r, dict) and r.get("repo") == repo and (not branch or r.get("branch", "") == branch))]
        removed = before - len(out["repos"])
        if removed:
            said.append("repository %s: %d row(s) removed" % (args[0], removed))
        else:
            said.append("repository %s: no row matched; unchanged. Run work-record --help for repository forms" % args[0])
print("work-record update_record: " + "; ".join(said), file=sys.stderr)
print(json.dumps(out, ensure_ascii=False))
EDIT
) || exit 3
else
  BODY=$(cat)
  [ -n "${BODY// /}" ] || die "work-record update_record: nothing on stdin. Send the json block."
fi

# Validate the shape and normalise the spacing, so what lands on disk is what the tile
# will read. Rejects rather than silently dropping: an unknown key is either a typo or a
# word we retired, and both are worth being told about.
# The validator is handed the CURRENT block too, so it can carry "holds", "teams" and
# "configuration" through without the agent ever seeing them.
PREV=$(awk '/^```/{f=!f; if(f) next; else exit} f' "$FILE" 2>/dev/null)
PREVF=$(mktemp); printf '%s' "${PREV:-{\}}" > "$PREVF"
BLOCK=$(printf '%s' "$BODY" | python3 -c '
import json, sys
ALLOWED   = {"objective", "mandate", "repos", "ladder_state"}
# What is happening to the ladder AS A WHOLE — not a rung. Absent means "on_track", so
# nothing has to be migrated and the normal case costs nobody a keystroke.
#
# There is no "on hold": waiting on a person is a flag and a comment on the item, and a
# second way to say the same thing is how a format rots.
LADDER_STATES = {"on_track", "on_tangent"}
STATUSES  = {"PLANNED", "ACTIVE", "DONE"}
try:
    d = json.load(sys.stdin)
except Exception as e:
    sys.exit(f"work-record update_record: that is not valid json — {e}")
if not isinstance(d, dict):
    sys.exit("work-record update_record: the block must be an object: { \"objective\": …, \"repos\": [ … ] }")

# REFUSED HERE, CARRIED THROUGH BELOW. Neither of these has the block as its door, and
# each is named individually because the fix differs.
NOT_YOURS = {
    "teams": "\"teams\" is not yours to write.\n"
          "  It is DERIVED: one entry per team you are on, which Ronin writes again when a\n"
          "  roster or a membership changes, with a one-line notice. Membership itself is\n"
          "  your tags; leadership is the owner-set 人. Drop \"teams\" and save again.",
    "configuration": "\"configuration\" is not yours to write.\n"
          "  It is DERIVED: the title and Workspace Folder Ronin keeps for you.\n"
          "  Drop \"configuration\" and save again; it is carried through.",
    "role_family": "\"role_family\" is retired (R35, 2026-08-23).\n"
          "  A session has no identity axis of its own any more: identity is the TEAM\"s\n"
          "  team_role, on the team roster, worn contextually. Work readings are selected\n"
          "  as behaviours at birth. Drop \"role_family\".",
    "holds": "\"holds\" is not yours to write.\n"
             "  It lists the work items you hold; assign, return and backlog move them.\n"
             "  Drop \"holds\" and save again; the list is carried through.",
}
extra = sorted(set(d) - ALLOWED)
if extra:
    blocked = [k for k in extra if k in NOT_YOURS]
    if blocked and len(blocked) == len(extra):
        print("work-record update_record: warning: " + ", ".join(blocked) + " are maintained by Ronin and were ignored.", file=sys.stderr)
        for k in blocked: d.pop(k, None)
        extra = []
if extra:
    sys.exit("work-record update_record: unknown key(s): " + ", ".join(extra) +
             "\n  A TEGAMI holds: objective, mandate and repos; work items belong to the item tool."
             "\n  (\"teams\" is machinery-derived; membership lives in your tags.)"
             "\n  asks / blocked / decided / handoff / plan / side_ladder / v were removed —"
             "\n  nothing reads them. A question for a person is a comment on the item; everything"
             "\n  else belongs in your plan doc or on a wipeboard.")

st_ = (d.get("ladder_state") or "").strip().lower()
if st_ and st_ not in LADDER_STATES:
    if st_ in ("on_hold", "on hold"):
        sys.exit("work-record update_record: ladder_state \"on hold\" — waiting on someone is a flag\n"
                 "  on the item, saying WHAT you are waiting for: item flag <id> \"<why>\".")
    sys.exit("work-record update_record: ladder_state %r — use \"on_track\" (or leave it out) or \"on_tangent\"." % st_)

mandate = d.get("mandate") or {}
if not isinstance(mandate, dict):
    sys.exit("work-record update_record: mandate must be an object with reach, recruit and output.")
defaults = {"reach": "plan", "recruit": "propose agents", "output": ["open"]}
choices = {
    "reach": {"open", "discuss", "plan", "execute"},
    "recruit": {"open", "nobody", "propose agents", "staff agents"},
    "output": {"open", "a plan", "ideas", "code", "an artifact", "the team", "no code"},
}
unknown = sorted(set(mandate) - set(defaults))
if unknown:
    sys.exit("work-record update_record: unknown mandate key(s): " + ", ".join(unknown))
for key, fallback in defaults.items():
    value = mandate.get(key) or fallback
    if key == "output":
        value = value if isinstance(value, list) else [value]
        if not value or any(item not in choices[key] for item in value):
            sys.exit("work-record update_record: mandate.output has invalid value(s) %r." % value)
    elif value not in choices[key]:
        sys.exit("work-record update_record: mandate.%s has no value %r." % (key, value))
    mandate[key] = value
d["mandate"] = mandate

repos = d.get("repos", [])
if not isinstance(repos, list):
    sys.exit("work-record update_record: \"repos\" must be a list of { \"repo\": …, \"branch\": … } entries.")
# A repos entry is the agent-owned { repo, branch } plus the two DESK FIELDS the letter is
# seeded with at a managed birth — "worktree" (the desk mounted on the branch) and
# "line" (the team line it hands in to; src/tegami.ts TegamiCheckout). The seed wrote
# them and this tool refused them (measured 2026-09-02): a session could not save the
# letter it was born with. They are accepted here, and carried through below when a
# save names the same repo+branch without them — the same protection "at" and "holds"
# have, because the desk row on the roster (src/desk-state.ts) reads them.
REPO_KEYS = {"repo", "branch", "worktree", "line"}
prev_repos = {}
try:
    _p = json.loads(open(sys.argv[1]).read()) if len(sys.argv) > 1 else {}
    for _e in (_p.get("repos") or []):
        if isinstance(_e, dict):
            prev_repos[(str(_e.get("repo", "")).strip(), str(_e.get("branch", "")).strip())] = _e
except Exception:
    prev_repos = {}
for i, checkout in enumerate(repos, 1):
    if not isinstance(checkout, dict) or set(checkout) - REPO_KEYS:
        sys.exit(f"work-record update_record: repo {i} may hold only \"repo\", \"branch\", \"worktree\" and \"line\".")
    for k in REPO_KEYS:
        if k in checkout and not isinstance(checkout[k], str):
            sys.exit(f"work-record update_record: repo {i} needs a string \"{k}\" value.")
    if not checkout.get("repo", "").strip():
        sys.exit(f"work-record update_record: repo {i} needs a repository name or URL.")
    checkout.setdefault("branch", "")
    was = prev_repos.get((checkout["repo"].strip(), checkout["branch"].strip()))
    for k in ("worktree", "line"):
        if not checkout.get(k, "").strip():
            checkout.pop(k, None)
            if was and isinstance(was.get(k), str) and was[k].strip():
                checkout[k] = was[k].strip()

# Hand the normalised block back on STDOUT. Not via a temp file: $$ is not expanded
# inside this single-quoted block, so the two halves would name different files — which
# is how an empty ladder once got written over a real one. Notes go to stderr, so stdout
# stays exactly the payload.
prev = json.loads(open(sys.argv[1]).read()) if len(sys.argv) > 1 else {}
# "teams" IS DERIVED, NEVER TAKEN FROM THE BLOCK — the same contract as "holds":
# Ronin writes it whenever a roster or a membership changes (tegami.ts teamChanged) and
# this save carries it through untouched. An empty list is a ronin, an ordinary state.
_teams = prev.get("teams") if isinstance(prev.get("teams"), list) else []
out = {"objective": d.get("objective", ""),
       "mandate": mandate,
       "teams": _teams,
       "repos": repos}
if isinstance(prev.get("configuration"), dict):
    out["configuration"] = prev["configuration"]
# CARRY "holds" THROUGH: the work item ids this session holds. Assign and release move
# them, through the work item routes; a whole-block save never drops them.
_holds = [h for h in (prev.get("holds") or []) if isinstance(h, str)]
if _holds:
    out["holds"] = _holds
ls_ = (d.get("ladder_state") or "").strip().lower()
if ls_ and ls_ != "on_track":
    out["ladder_state"] = ls_
print(json.dumps(out, indent=2, ensure_ascii=False))
' "$PREVF") || { rm -f "$PREVF"; exit 3; }
rm -f "$PREVF"

[ -n "${BLOCK// /}" ] || die "work-record update_record: internal — validator produced nothing; letter untouched."

# KEEP THE TEACHING LINES THAT ARE ALREADY THERE.
#
# The `>` block is wording the OWNER edits — he softened it once already — so this tool
# carries forward whatever the file says rather than stamping its own copy back over
# his. Only a letter with no teaching lines at all gets the stock ones, and the stock
# text lives in ONE place (src/tegami.ts, the seeder) so there is nothing to drift.
KEEP=$(awk '/^```/{exit} {print}' "$FILE" 2>/dev/null)
case "$KEEP" in *'>'*) ;; *) KEEP="" ;; esac

mkdir -p "$DIR"
# Write beside, then rename: the tile may read this file at any moment, and a half-written
# block would read as "no ladder" for exactly as long as the write took.
TMP="$DIR/.tegami.$$"
{
  if [ -n "$KEEP" ]; then
    printf '%s\n' "$KEEP"
  else
    printf '# TEGAMI — %s\n' "$NAME"
    cat <<'TEACH'
> Your work record is what the owner reads on your tile. Keep it true.
> - **objective:** one sentence on what you are doing now:
>   `work-record update_record --objective "…"`.
