#!/usr/bin/env bash
# Internal implementation for `ronin-host restart`.
#
# WHY IT TAKES NO ARGUMENT, which is the whole of its safety. Two services run here and
# they are one keystroke apart. `ronin` is the app: the browser grid, the API, the
# launcher. Restarting it is ordinary and cheap — pick up a code change, clear a wedged
# process — because sessions do not live inside it. The other is the tmux server, and
# that one OWNS every session, agent and shell on the box. Stopping it ends all of them
# simultaneously, including whoever typed the command, and there is no undo.
#
# An agent with no sanctioned way to restart Ronin will reach for `systemctl` on its
# own, and from there the unit that wipes the box is one word away. That is not a
# hypothesis — it is how this machine lost every live session twice in a single day. So
# the capability ships as a tool with a vocabulary of exactly one thing: there is no
# unit to name, no flag to get wrong, and nothing here to point somewhere else.
#
# If you believe the session engine itself is unhealthy, that is not yours to fix from
# inside it: by definition the repair would kill you mid-command. Say what you saw,
# name it on the board, and stop.
#
# Sessions are NOT restarted, ended, or disturbed by this. Browser tiles reconnect.
set -u

case "${1:-}" in
  '') ;;
  *) cat >&2 <<'EOF'
REFUSED: ronin-host restart takes no arguments — it restarts Ronin, and only Ronin.
There is deliberately no way to aim it at another service. If you believe something else
on this box needs restarting, that is the owner's call, not yours: say what you saw and
stop. Never hand-roll it with systemctl.
EOF
     exit 4 ;;
esac

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$ROOT/libexec/ronin-machine.sh"
kind="$(machine_service_kind)"
if [ "$kind" = systemd ]; then
  unit=ronin.service
else
  unit="$(machine_operator_unit)"
fi
if [ "$kind" = none ]; then
  echo "NO-SERVICE: Ronin has no supported service manager here. Whoever started it must restart it." >&2
  exit 2
fi
if { [ "$kind" = systemd ] && ! systemctl --user cat "$unit" >/dev/null 2>&1; } ||
   { [ "$kind" = launchd ] && ! machine_operator_loaded; }; then
  echo "NO-UNIT: $unit is not loaded. Run setup before using Restart." >&2
  exit 2
fi

echo "restarting $unit — every session stays up; browser tiles reconnect."
case "$kind" in
  systemd) systemctl --user restart "$unit" ;;
  launchd) launchctl kickstart -k "$(machine_launchd_domain "$unit")/$unit" ;;
esac || {
  echo "STUCK: $kind refused the restart. Ronin may still be running. Report it." >&2
  exit 5
}

# Wait for it to come back rather than announcing an outcome we have not seen. Reporting
# "restarted" while the unit is still flapping is the same failure session_end warns
# about: never claim the ending you did not watch happen.
state=""
i=0
while [ "$i" -lt 20 ]; do
  case "$kind" in
    systemd)
      state=$(systemctl --user is-active "$unit" 2>/dev/null || true)
      if [ "$state" = active ]; then echo "OK: $unit is active."; exit 0; fi ;;
    launchd)
      state="$(machine_operator_pid)"
      if [ -n "$state" ]; then echo "OK: $unit is running (pid $state)."; exit 0; fi ;;
  esac
  i=$((i + 1))
  sleep 1
done

{
  echo "STUCK: $unit is '${state:-not running}' 20s after the restart."
  echo "STUCK: it did not come back. Do NOT retry in a loop — report to the owner."
  if [ "$kind" = systemd ]; then
    echo "STUCK: the journal has the reason: journalctl --user -u $unit -n 50"
  else
    echo "STUCK: inspect the job: launchctl print $(machine_launchd_domain "$unit")/$unit"
  fi
} >&2
exit 5
