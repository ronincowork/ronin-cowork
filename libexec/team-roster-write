#!/usr/bin/env bash
# Internal roster-write implementation for `team`.
#
# Usage: team roster write <team> [--objective <text>] [--role <team_role>] [--root <project_root>]
#                              [--repos a,b] [--branch <b>] [--wipeboard <board>]
#                              [--state active|archived] [--campaign-defaults] [--add s1,s2]
#                              [--select b1,b2] [--deselect b1,b2]
#
# ONE UPSERT (owner, 2026-08-26). A team with no roster is CREATED from whatever you
# name; a team with one is UPDATED in the fields you name and untouched elsewhere.
# `--add` tags those live sessions onto the team — additive, never removing anyone;
# a name that is not live is reported back, and the rest still go through.
#
# You rarely need this: a session is born onto your team by `session_create`, with no
# team named at all. Come here to create a team, or to give one a brief worth
# inheriting (`--objective`, `--root`, `--repos`, `--branch`).
#
# Verdicts: CREATED <team> · UPDATED <team> — then `added: …` / `not live: …` when --add
# was given. Exit 0 done, 2 bad arguments, 4 refused, 5 Ronin unreachable.
set -u
case "${1-}" in
  -h|--help) [ "$#" -eq 1 ] || { echo "team roster write: --help takes no other arguments. Run team --help." >&2; exit 2; }
    cat <<'EOF'
team roster write — create a Team or update its stated facts

Usage:
  team roster write <team> [--objective <text>] [--role <role>] [--root <path>]
                        [--repos a,b] [--branch <branch>] [--wipeboard <board>]
                        [--state active|archived] [--campaign-defaults] [--add s1,s2]
                        [--select b1,b2] [--deselect b1,b2]

Create a Team by naming one that has no record; otherwise only named fields change.
--select adds selected behaviours to the Team's list and --deselect takes them off; the rest
of the list, and its required ones, stay (project-management is the work-items switch).
--add adds live Agents and never removes members. To move an Agent between Teams, add
the destination membership, then remove the old Team on that Team's page in the
coworkspace. Set or change its lead with `session_set <agent> --team <team> --lead`.
This writes the Team record and may change membership. Related: team --help; edges --help;
session_create --help; session_set --help
EOF
    exit 0 ;;
esac
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/../ronin_bin/tool-path.sh"
TOOL_DIR=$(cd "$(dirname "$SELF")/../ronin_bin" && pwd)
die() { printf '%s\n' "$1" >&2; exit "${2:-4}"; }

NAME="${1:-}"
[ -n "$NAME" ] && [ "${NAME#-}" = "$NAME" ] || die "usage: team roster write <team> [options]. Run team --help." 2
shift
OBJ="" ROLE="" ROOT="" REPOS="" BRANCH="" BOARD="" STATE="" ADD="" CAMPAIGN_DEFAULTS="" SELECT="" DESELECT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --objective) OBJ="${2:-}"; shift 2 ;;
    --role|--team_role) ROLE="${2:-}"; shift 2 ;;
    --root|--project_root) ROOT="${2:-}"; shift 2 ;;
    --repos) REPOS="${2:-}"; shift 2 ;;
    --branch) BRANCH="${2:-}"; shift 2 ;;
    --wipeboard) BOARD="${2:-}"; shift 2 ;;
    --state) STATE="${2:-}"; shift 2 ;;
    --campaign-defaults) CAMPAIGN_DEFAULTS=1; shift ;;
    --add) ADD="${2:-}"; shift 2 ;;
    --select) SELECT="${2:-}"; shift 2 ;;
    --deselect) DESELECT="${2:-}"; shift 2 ;;
    *) die "BAD-ARG: $1. Run team --help." 2 ;;
  esac
done

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?

BY=$(ronin_session_me 2>/dev/null) || BY=""
# --select / --deselect change the Team's behaviour list as it stands: read it first.
CURRENT='{}'
if [ -n "$SELECT$DESELECT" ]; then
  CURRENT=$(curl -sS -m 20 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" "$url/api/team-rosters/$NAME" 2>/dev/null) || die "UNREACHABLE: Ronin did not answer at $url" 5
fi
body=$(BY="$BY" NAME="$NAME" OBJ="$OBJ" ROLE="$ROLE" ROOT="$ROOT" REPOS="$REPOS" BRANCH="$BRANCH" \
       BOARD="$BOARD" STATE="$STATE" ADD="$ADD" CAMPAIGN_DEFAULTS="$CAMPAIGN_DEFAULTS" \
       SELECT="$SELECT" DESELECT="$DESELECT" CURRENT="$CURRENT" python3 - <<'PY'
import json, os
e = os.environ
b = {"name": e["NAME"]}
if e["BY"]: b["by"] = e["BY"]  # the lead editing its own roster is not acked
for k, v in (("objective", "OBJ"), ("team_role", "ROLE"), ("project_root", "ROOT"),
             ("branch", "BRANCH"), ("wipeboard", "BOARD"), ("state", "STATE")):
    if e[v]: b[k] = e[v]
for k, v in (("repos", "REPOS"), ("session_names", "ADD")):
    if e[v]: b[k] = [t.strip() for t in e[v].split(",") if t.strip()]
if e["CAMPAIGN_DEFAULTS"]: b["campaign_defaults"] = True
if e["SELECT"] or e["DESELECT"]:
    try: now = (json.loads(e["CURRENT"]) or {}).get("behaviours") or {}
    except Exception: now = {}
    names = lambda v: [t.strip() for t in v.split(",") if t.strip()]
    selected = [n for n in (now.get("selected") or []) if n not in names(e["DESELECT"])]
    selected += [n for n in names(e["SELECT"]) if n not in selected]
    b["behaviours"] = {"selected": selected, "required": now.get("required") or []}
print(json.dumps(b))
PY
) || die "BAD-ARG: could not build the request" 2

out=/tmp/team-roster-write.$$
code=$(curl -sS -m 20 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$out" -w '%{http_code}' \
       -H 'content-type: application/json' -X PUT --data "$body" "$url/api/team" 2>/dev/null) \
  || { rm -f "$out"; die "UNREACHABLE: Ronin did not answer at $url" 5; }
python3 - "$code" "$out" <<'PY'
import json, sys
code, path = int(sys.argv[1]), sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
if code == 200 and d.get("ok"):
    print(("CREATED " if d.get("created") else "UPDATED ") + d["roster"]["name"])
    if d.get("added"): print("added: " + ", ".join(d["added"]))
    if d.get("not_live"): print("not live: " + ", ".join(d["not_live"]))
    sys.exit(0)
print(f"REFUSED: {d.get('error') or f'HTTP {code}'}", file=sys.stderr)
sys.exit(4)
PY
rc=$?
rm -f "$out"
exit $rc
