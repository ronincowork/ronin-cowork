#!/usr/bin/env bash
# Internal roster-write implementation for `team`.
#
# Usage: team roster write <team> [--objective <text>] [--workspace <handle>]
#                              [--branch <b>] [--wipeboard <board>]
#                              [--state active|archived] [--campaign-defaults] [--add s1,s2]
#                              [--select b1[:full|:seed],b2] [--deselect b1,b2] [--campaign <id>]
#
# ONE UPSERT (owner, 2026-08-26). A team with no roster is CREATED from whatever you
# name; a team with one is UPDATED in the fields you name and untouched elsewhere.
# `--add` tags those live sessions onto the team — additive, never removing anyone;
# a name that is not live is reported back, and the rest still go through.
#
# You rarely need this: a session is born onto your team by `session_create`, with no
# team named at all. Come here to create a team, or to give one a brief worth
# inheriting (`--objective`, `--workspace`, `--branch`).
#
# Verdicts: CREATED <team> · UPDATED <team> — then `added: …` / `not live: …` when --add
# was given. Exit 0 done, 2 bad arguments, 4 refused, 5 Ronin unreachable.
set -u
case "${1-}" in
  -h|--help) [ "$#" -eq 1 ] || { echo "team roster write: --help takes no other arguments. Run team --help." >&2; exit 2; }
    cat <<'EOF'
team roster write — create a Team or update its stated facts

Usage:
  team roster write <team> [--objective <text>] [--workspace <handle>]
                        [--branch <branch>] [--wipeboard <board>]
                        [--state active|archived] [--campaign-defaults] [--add s1,s2]
                        [--select b1[:full|:seed],b2] [--deselect b1,b2] [--campaign <id>]

Create a Team by naming one that has no record; otherwise only named fields change.
--workspace names the Team's Workspace by its handle; the Workspace holds the repositories.
--select adds behaviours to the Team's brief settings (brief.add), so every Agent born on the
Team is told them; --deselect takes them off. The rest of the brief settings stay. Agents
already running are not changed. A depth after a colon, <behaviour>:full or <behaviour>:seed,
is how much of it they are told; without one its header decides, and a behaviour whose header
says none is told only its seed line, so name :full when the Team needs it whole. Selecting one
again with a depth changes its depth. project-management is the work-items switch: --select turns
it on for the Team, --deselect off. `team roster read <team>` shows the result under brief.add.
--campaign names the Team's Campaign, for a Team name that is in more than one.
--add adds live Agents and never removes members. To move an Agent between Teams, add
the destination membership, then remove the old Team on that Team's page in the
coworkspace. Set or change its lead with `session_set <agent> --team <team> --lead`.
This writes the Team record and may change membership. Related: team --help; edges --help;
session_create --help; session_set --help
EOF
    exit 0 ;;
esac
. "$(dirname "$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/../ronin_bin/tool-path.sh"
TOOL_DIR=$(cd "$(dirname "$SELF")/../ronin_bin" && pwd)
die() { printf '%s\n' "$1" >&2; exit "${2:-4}"; }

NAME="${1:-}"
[ -n "$NAME" ] && [ "${NAME#-}" = "$NAME" ] || die "usage: team roster write <team> [options]. Run team --help." 2
shift
OBJ="" WORKSPACE="" BRANCH="" BOARD="" STATE="" ADD="" CAMPAIGN_DEFAULTS="" SELECT="" DESELECT="" CAMPAIGN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --objective) OBJ="${2:-}"; shift 2 ;;
    --workspace) WORKSPACE="${2:-}"; shift 2 ;;
    --branch) BRANCH="${2:-}"; shift 2 ;;
    --wipeboard) BOARD="${2:-}"; shift 2 ;;
    --state) STATE="${2:-}"; shift 2 ;;
    --campaign-defaults) CAMPAIGN_DEFAULTS=1; shift ;;
    --add) ADD="${2:-}"; shift 2 ;;
    --select) SELECT="${2:-}"; shift 2 ;;
    --deselect) DESELECT="${2:-}"; shift 2 ;;
    --campaign) CAMPAIGN="${2:-}"; [ -n "$CAMPAIGN" ] || die "BAD-ARG: --campaign needs a Campaign id" 2; shift 2 ;;
    *) die "BAD-ARG: $1. Run team --help." 2 ;;
  esac
done

. "$TOOL_DIR/ronin-http.sh"
ronin_connect || exit $?

BY=$(ronin_session_me 2>/dev/null) || BY=""
# --select / --deselect change the Team's brief settings as they stand: read them first.
CURRENT='{}'
if [ -n "$SELECT$DESELECT" ]; then
  CURRENT=$(curl -sS -m 20 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -G --data-urlencode "campaign_id=$CAMPAIGN" "$url/api/team-rosters/$NAME" 2>/dev/null) || die "UNREACHABLE: Ronin did not answer at $url" 5
  # A list read is the base of the write: an unreadable one refuses rather than replaces.
  printf '%s' "$CURRENT" | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if "name" in d or "has no roster" in d.get("error", "") else 1)' 2>/dev/null \
    || die "REFUSED: could not read Team $NAME's brief settings: $(printf '%s' "$CURRENT" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("error",""))' 2>/dev/null)" 4
fi
body=$(BY="$BY" NAME="$NAME" OBJ="$OBJ" WORKSPACE="$WORKSPACE" BRANCH="$BRANCH" \
       BOARD="$BOARD" STATE="$STATE" ADD="$ADD" CAMPAIGN_DEFAULTS="$CAMPAIGN_DEFAULTS" \
       SELECT="$SELECT" DESELECT="$DESELECT" CURRENT="$CURRENT" CAMPAIGN="$CAMPAIGN" python3 - <<'PY'
import json, os
e = os.environ
b = {"name": e["NAME"]}
if e["BY"]: b["by"] = e["BY"]  # the lead editing its own roster is not acked
for k, v in (("objective", "OBJ"), ("workspace", "WORKSPACE"),
             ("branch", "BRANCH"), ("wipeboard", "BOARD"), ("state", "STATE")):
    if e[v]: b[k] = e[v]
if e["ADD"]: b["session_names"] = [t.strip() for t in e["ADD"].split(",") if t.strip()]
if e["CAMPAIGN_DEFAULTS"]: b["campaign_defaults"] = True
if e["CAMPAIGN"]: b["campaign_id"] = e["CAMPAIGN"]
if e["SELECT"] or e["DESELECT"]:
    # The Team's brief settings: brief.add is what an Agent born on the Team is told beyond the
    # layers above. The whole brief is written back, so block and only stay as they are.
    # project-management is the work-items switch, the Team's pm, not a brief entry.
    try: now = json.loads(e["CURRENT"]) or {}
    except Exception: now = {}
    brief = now.get("brief") or {}
    names = lambda v: [t.strip() for t in v.split(",") if t.strip()]
    # <behaviour>:full or :seed is the depth it is told at, written as the entry's depth; without
    # one the behaviour's own header decides (a header of depth none is told as its seed line).
    sel = [(n.split(":", 1) + [""])[:2] for n in names(e["SELECT"])]
    desel = [n.split(":", 1)[0] for n in names(e["DESELECT"])]
    if any(n == "project-management" for n, _ in sel): b["pm"] = True
    if "project-management" in desel: b["pm"] = False
    add = [a for a in (brief.get("add") or []) if a.get("name") not in desel]
    for n, depth in sel:
        if n == "project-management": continue
        entry = {"name": n, **({"depth": depth} if depth else {})}
        at = [a.get("name") for a in add]
        if n in at:
            if depth: add[at.index(n)] = entry  # re-selected with a depth: that depth now
        else: add.append(entry)
    b["brief"] = {**brief, "add": add, "block": brief.get("block") or [], "only": brief.get("only") or []}
print(json.dumps(b))
PY
) || die "BAD-ARG: could not build the request" 2

out=/tmp/team-roster-write.$$
code=$(curl -sS -m 20 "${RONIN_CURL[@]+"${RONIN_CURL[@]}"}" -o "$out" -w '%{http_code}' \
       -H 'content-type: application/json' -X PUT --data "$body" "$url/api/team" 2>/dev/null) \
  || { rm -f "$out"; die "UNREACHABLE: Ronin did not answer at $url" 5; }
python3 - "$code" "$out" <<'PY'
import json, sys
code, path = int(sys.argv[1]), sys.argv[2]
try:
    d = json.load(open(path))
except Exception:
    d = {}
if code == 200 and d.get("ok"):
    print(("CREATED " if d.get("created") else "UPDATED ") + d["roster"]["name"])
    if d.get("added"): print("added: " + ", ".join(d["added"]))
    if d.get("not_live"): print("not live: " + ", ".join(d["not_live"]))
    sys.exit(0)
print(f"REFUSED: {d.get('error') or f'HTTP {code}'}", file=sys.stderr)
sys.exit(4)
PY
rc=$?
rm -f "$out"
exit $rc
