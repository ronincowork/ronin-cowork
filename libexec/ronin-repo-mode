#!/usr/bin/env bash
# ronin-repo-mode — what kind of checkout am I standing in, and does the legacy commit
# guard apply here? One answer, asked by the git shim and the hooks; never worked out
# twice in two places.
#
#   ronin-repo-mode            every fact, key=value
#   ronin-repo-mode claim      just the decision: prints `on` or `off`, exit 0 either way
#   ronin-repo-mode <key>      one fact (arrangement, working, stable, desks, checkout, index)
#
# THE FACTS, and where each comes from:
#
#   arrangement  reviewed | direct | undeclared   from RONIN_REPO at the repo root, the
#   working      <branch> or empty                 declared arrangement (see that file).
#   stable       <branch> or empty                 Absent file = undeclared; nothing is
#   desks        managed | none | undeclared       inferred from the checked-out branch.
#
#   checkout     desk | home                       MEASURED from git, never declared: a
#                                                  linked worktree (its git-dir is not the
#                                                  common dir) is a desk; the main working
#                                                  tree is the repository's home checkout.
#   index        private | shared                  a desk owns its index; the home checkout
#                                                  is the one every shell on the box shares.
#
#   claim        on | off                          THE DECISION. The legacy claim hook exists
#                                                  for exactly one hazard — several sessions
#                                                  staging into ONE shared index — so it is
#                                                  on only where that index is shared, and
#                                                  off in a desk, whose index is its own.
#
# Overrides, both explicit and both visible: RONIN_CLAIM_MODE=shared forces the guard on
# (a desk somebody is deliberately sharing); RONIN_CLAIM_MODE=off forces it off, and so does
# the older RONIN_CLAIM_OFF=1 the shim has honoured since the guard shipped.
#
# FAILS OPEN like everything beside it: outside a git tree every fact is empty and the
# claim decision is `off`, because a guard with no basis to judge should say nothing.
set -u
# Real git only (the shim passes RONIN_REAL_GIT down); a shim answering `rev-parse` is
# harmless, but this tool must never be part of a shim-calls-shim loop.
GIT=${RONIN_REAL_GIT:-}; [ -n "$GIT" ] && [ -x "$GIT" ] || GIT=/usr/bin/git
git() { "$GIT" "$@"; }

want="${1:-}"
top="$(git rev-parse --show-toplevel 2>/dev/null || true)"

arrangement=undeclared; working=""; stable=""; desks=undeclared
if [ -n "$top" ] && [ -f "$top/RONIN_REPO" ]; then
  # key=value, `#` comments, whitespace tolerated; unknown keys are ignored, not errors.
  while IFS='=' read -r k v; do
    k="${k//[[:space:]]/}"; v="${v%%#*}"; v="${v//[[:space:]]/}"
    case "$k" in
      mode)    arrangement="$v" ;;
      working) working="$v" ;;
      stable)  stable="$v" ;;
      desks)   desks="$v" ;;
    esac
  done < <(grep -v '^[[:space:]]*#' "$top/RONIN_REPO" 2>/dev/null)
  [ -n "$arrangement" ] || arrangement=undeclared
  [ -n "$desks" ] || desks=undeclared
fi

checkout=""; index=""
if [ -n "$top" ]; then
  gd="$(git rev-parse --git-dir 2>/dev/null)"; cd_="$(git rev-parse --git-common-dir 2>/dev/null)"
  gd="$(cd "$top" && cd "$gd" 2>/dev/null && pwd -P)"; cd_="$(cd "$top" && cd "$cd_" 2>/dev/null && pwd -P)"
  if [ -n "$gd" ] && [ -n "$cd_" ] && [ "$gd" != "$cd_" ]; then checkout=desk; index=private
  else checkout=home; index=shared; fi
fi

claim=off
case "${RONIN_CLAIM_MODE:-}" in
  shared) claim=on ;;
  off)    claim=off ;;
  *)
    if [ "${RONIN_CLAIM_OFF:-0}" = 1 ]; then claim=off
    elif [ "$index" = shared ]; then claim=on
    fi ;;
esac

case "$want" in
  "")
    printf 'arrangement=%s\nworking=%s\nstable=%s\ndesks=%s\ncheckout=%s\nindex=%s\nclaim=%s\n' \
      "$arrangement" "$working" "$stable" "$desks" "$checkout" "$index" "$claim" ;;
  claim)       printf '%s\n' "$claim" ;;
  arrangement) printf '%s\n' "$arrangement" ;;
  working)     printf '%s\n' "$working" ;;
  stable)      printf '%s\n' "$stable" ;;
  desks)       printf '%s\n' "$desks" ;;
  checkout)    printf '%s\n' "$checkout" ;;
  index)       printf '%s\n' "$index" ;;
  *) printf 'usage: ronin-repo-mode [claim|arrangement|working|stable|desks|checkout|index]\n' >&2; exit 2 ;;
esac
